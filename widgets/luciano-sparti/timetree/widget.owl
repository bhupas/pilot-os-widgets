widget "timetree" {
  size: 6x4
  minSize: 6x4

  meta {
    description: "TimeTree shared calendar with monthly view, agenda, quick app launch, and phone notification reminders"
    version: "1.1"
    license: "MIT"
    category: "productivity"
    owl: 8
  }

  requires {
    pacman: ["gawk"]
  }

  // Live time, calendar calculation, and event sources
  source now = clock every 1m
  source cal = cmd("""
    mkdir -p ~/.config/timetree
    f=~/.config/timetree/events.json
    [ -f "$f" ] || echo '[]' > "$f"

    gawk -v events_file="$f" '
    BEGIN {
      while ((getline line < events_file) > 0) {
        if (match(line, /"date"[[:space:]]*:[[:space:]]*"([0-9]{4}-[0-9]{2}-[0-9]{2})"/, m_date)) {
          cur_date = m_date[1]
          date_has_ev[cur_date]++
          if (match(line, /"color"[[:space:]]*:[[:space:]]*"([^"]+)"/, m_col)) {
            if (date_colors[cur_date] == "") {
              date_colors[cur_date] = m_col[1]
            } else if (split(date_colors[cur_date], dummy, ",") < 3) {
              date_colors[cur_date] = date_colors[cur_date] "," m_col[1]
            }
          }
        }
      }
      close(events_file)

      now = systime()
      cur_y = strftime("%Y", now) + 0
      cur_m = strftime("%m", now) + 0
      today = strftime("%Y-%m-%d", now)

      printf "{\"today\":\"%s\",\"months\":[", today

      m_idx = 0
      for (off = -3; off <= 3; off++) {
        y = cur_y
        m = cur_m + off
        while (m < 1) { m += 12; y-- }
        while (m > 12) { m -= 12; y++ }

        t_first = mktime(sprintf("%d %02d 01 12 00 00", y, m))
        label = strftime("%B %Y", t_first)
        short_label = strftime("%b %Y", t_first)
        dow = strftime("%w", t_first) + 0
        t_start = t_first - (dow * 86400)

        next_y = y; next_m = m + 1
        if (next_m > 12) { next_m = 1; next_y++ }
        t_next = mktime(sprintf("%d %02d 01 12 00 00", next_y, next_m))
        t_last = t_next - 86400
        days_in_m = strftime("%d", t_last) + 0

        cells = (dow + days_in_m > 35) ? 42 : 35

        if (m_idx > 0) printf ","
        printf "{\"off\":%d,\"label\":\"%s\",\"short\":\"%s\",\"year\":%d,\"month\":%d,\"weeks\":[", off, label, short_label, y, m

        for (w = 0; w < (cells / 7); w++) {
          if (w > 0) printf ","
          printf "{\"days\":["
          for (d = 0; d < 7; d++) {
            idx = w * 7 + d
            t_day = t_start + (idx * 86400)
            d_str = strftime("%Y-%m-%d", t_day)
            d_num = strftime("%d", t_day) + 0
            d_m = strftime("%m", t_day) + 0
            in_m = (d_m == m) ? "true" : "false"
            is_today = (d_str == today) ? "true" : "false"
            cnt = date_has_ev[d_str] + 0
            cols = date_colors[d_str]
            if (cols == "") cols = "#10b981"
            split(cols, c_arr, ",")
            c_json = "["
            for (ci = 1; ci <= length(c_arr); ci++) {
              if (ci > 1) c_json = c_json ","
              c_json = c_json "\"" c_arr[ci] "\""
            }
            c_json = c_json "]"

            if (d > 0) printf ","
            printf "{\"d\":%d,\"date\":\"%s\",\"cur\":%s,\"today\":%s,\"dow\":%d,\"count\":%d,\"colors\":%s}", d_num, d_str, in_m, is_today, d, cnt, c_json
          }
          printf "]}"
        }
        printf "]}"
        m_idx++
      }
      printf "]}"
    }'
  """) every 10m json

  source events = file("~/.config/timetree/events.json") json
  source notifs = android.notifications

  // State for interactive navigation
  state offset = 0 persist
  state selectedDate = ""

  // Derived calendar values
  let todayDate = cal.today ?? fmtTime(now, "yyyy-MM-dd")
  let activeDate = selectedDate != "" ? selectedDate : todayDate
  let monthsList = cal.months ?? []
  let activeMonth = monthsList.find(m => m.off == offset) ?? monthsList.find(m => m.off == 0)
  let monthLabel = activeMonth.label ?? fmtTime(now, "MMMM yyyy")
  let monthWeeks = activeMonth.weeks ?? []
  let allEvents = events ?? []
  let dayEvents = allEvents.filter(e => e.date == activeDate)
  let ttNotifs = (notifs.items ?? []).filter(n => n.package == "works.jubilee.timetree")
  // TimeTree's green, for its logo only.
  let ttColor = #10b981
  let dayTitle = activeDate == todayDate ? "Today" : fmtTime(parseTime(activeDate, "yyyy-MM-dd"), "EEE d")
  // Day cells as wide as a seventh of the screen allows, and two columns when there's room.
  let cell = clamp(floor((screenWidth ?? 328) / 7) - 4, 34, 56)
  let twoCols = (screenWidth ?? 0) > 600

  onTap: screen()

  component TreeLogo(sz = 20) {
    Canvas {
      width: sz
      height: sz
      rect(0, 0, sz, sz, radius: 4, fill: ttColor)
      circle(sz * 0.5, sz * 0.38, sz * 0.22, fill: #ffffff)
      rect(sz * 0.44, sz * 0.46, sz * 0.12, sz * 0.32, radius: 1, fill: #ffffff)
    }
  }

  component DayCell(day) {
    let isSel = day.date == activeDate
    let dayCol = !day.cur ? alpha(foreground, 0.25) : (day.dow == 0 ? red : (day.dow == 6 ? cyan : foreground))
    Column {
      gap: 1
      weight: 1
      align: center
      onTap: selectedDate = day.date

      Box {
        size: 19
        radius: 9.5
        background: day.today ? accent : transparent
        border: isSel && !day.today ? 1.5 : 0
        borderColor: accent
        align: center
        Text { text: str(day.d); fontSize: 10; bold: day.today || isSel; color: day.today ? background : dayCol; align: center; maxLines: 1 }
      }

      Row {
        gap: 2
        height: 3
        align: center
        if day.count > 0 {
          Box { size: 3; radius: 1.5; background: day.colors[0] ?? accent }
        }
        if day.count > 1 {
          Box { size: 3; radius: 1.5; background: day.colors[1] ?? accent }
        }
      }
    }
  }

  // The tile: the picked day (today until a day is tapped) and its events on the left, the month on the right.
  Row {
    gap: 16
    fill: true
    Column {
      gap: 2
      weight: 1
      fill: height
      Row {
        gap: 6
        align: center
        TreeLogo { sz: 14 }
        Text { text: "TIMETREE"; style: label; color: muted; weight: 1; maxLines: 1 }
      }
      Text { text: dayTitle; fontSize: 40; maxLines: 1 }
      Text { text: len(dayEvents) == 0 ? "No events" : "${len(dayEvents)} event${len(dayEvents) == 1 ? "" : "s"}"; style: small; color: muted; maxLines: 1 }
      Spacer { height: 4 }
      for ev in dayEvents.take(max((rows ?? 4) * 3 - 8, 1)) key ev.id {
        Row {
          gap: 6
          align: center
          Spacer { width: 3; height: 14; radius: 1.5; background: ev.color ?? accent }
          Text { text: "${ev.time ?? "All day"} · ${ev.title}"; style: small; weight: 1; maxLines: 1 }
        }
      }
      Spacer { weight: 1 }
      if len(ttNotifs) > 0 {
        Text { text: ttNotifs[0].title + (ttNotifs[0].text != "" ? " · " + ttNotifs[0].text : ""); style: small; color: accent; maxLines: 1; onTap: notification("open", ttNotifs[0].key) }
      }
    }

    // The month; a tap on a day shows it on the left.
    Column {
      width: 180
      gap: 1
      Text { text: monthLabel; style: small; bold: true; maxLines: 1 }
      Spacer { height: 2 }
      Row {
        gap: 0
        for w, i in ["S", "M", "T", "W", "T", "F", "S"] {
          Text { text: w; weight: 1; style: label; align: center; maxLines: 1; color: i == 0 ? red : (i == 6 ? cyan : muted) }
        }
      }
      for week in monthWeeks {
        Row {
          gap: 0
          for day in week.days key day.date {
            DayCell { day: day }
          }
        }
      }
    }
  }

  component Month() {
    Column {
      gap: 12
      Row {
        align: center
        gap: 6
        Column {
          gap: 0
          weight: 1
          Text { text: words(monthLabel)[0]; fontSize: (screenWidth ?? 360) < 420 ? 24 : 30; bold: true; maxLines: 1 }
          Text { text: words(monthLabel)[1] ?? ""; fontSize: 16; color: muted; maxLines: 1 }
        }
        Text { text: "‹"; fontSize: 20; align: center; width: 48; color: offset <= -3 ? muted : foreground; background: surface; radius: 24; padding: [0, 10]; onTap: offset = max(-3, offset - 1) }
        Text { text: "Today"; fontSize: 16; align: center; width: 84; maxLines: 1; color: offset == 0 && activeDate == todayDate ? muted : background; background: offset == 0 && activeDate == todayDate ? surface : accent; radius: 24; padding: [0, 14]; onTap: { offset = 0; selectedDate = "" } }
        Text { text: "›"; fontSize: 20; align: center; width: 48; color: offset >= 3 ? muted : foreground; background: surface; radius: 24; padding: [0, 10]; onTap: offset = min(3, offset + 1) }
      }
      Grid {
        columns: 7
        gap: 4
        for w, i in ["S", "M", "T", "W", "T", "F", "S"] {
          Text { text: w; style: label; align: center; color: i == 0 ? red : (i == 6 ? cyan : muted) }
        }
        for week in monthWeeks {
          for day in week.days key day.date {
            let isSel = day.date == activeDate
            Box {
              height: cell; radius: cell / 2; align: center
              background: isSel ? accent : transparent
              border: day.today && !isSel ? 1 : 0; borderColor: accent
              onTap: selectedDate = day.date
              Column {
                gap: 0
                align: center
                Text { text: str(day.d); align: center; color: isSel ? background : !day.cur ? alpha(foreground, 0.3) : (day.dow == 0 ? red : (day.dow == 6 ? cyan : foreground)) }
                Row {
                  gap: 2
                  height: 4
                  align: center
                  if day.count > 0 {
                    Spacer { size: 4; radius: 2; background: isSel ? background : day.colors[0] ?? accent }
                  }
                  if day.count > 1 {
                    Spacer { size: 4; radius: 2; background: isSel ? background : day.colors[1] ?? accent }
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  component Day() {
    Column {
      gap: 12
      Text { text: activeDate == todayDate ? "Today" : fmtTime(parseTime(activeDate, "yyyy-MM-dd"), "EEEE d MMMM"); fontSize: 14; bold: true; color: accent; padding: [4, 0, 0, 0] }
      Box {
        fill: width
        align: bottomEnd
        Column {
          gap: 0
          fill: width
          background: surface; radius: 28; clip: true
          for ev, n in dayEvents key ev.id {
            Spacer { height: 1; fill: width; background: border; visible: n > 0 }
            Row {
              gap: 16
              align: center
              padding: [20, 14]
              onTap: androidApp("works.jubilee.timetree")
              Spacer { width: 4; height: 36; radius: 2; background: ev.color ?? accent }
              Text { text: ev.time ?? "All day"; fontSize: 16; color: muted; width: 60; maxLines: 1 }
              Column {
                gap: 0
                weight: 1
                Text { text: ev.title; fontSize: 16; maxLines: 2 }
                Text { text: ev.calendar ?? ""; fontSize: 14; color: muted; maxLines: 1; visible: ev.calendar != null }
              }
            }
          }
          if len(dayEvents) == 0 { Text { text: "Nothing planned."; fontSize: 16; color: muted; padding: [20, 16] } }
          // Room at the end, so the add button never covers the last event.
          Spacer { height: 80 }
        }
        // Events are added in TimeTree, which keeps the shared calendar.
        Box {
          padding: 16
          Box {
            size: 56; radius: 16; align: center; background: accent
            onTap: androidApp("works.jubilee.timetree")
            Text { text: "+"; fontSize: 32; color: background; align: center; fill: width }
          }
        }
      }
    }
  }

  component More() {
    Column {
      gap: 12
      if len(ttNotifs) > 0 {
        Text { text: "From TimeTree"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
        Column {
          gap: 0
          background: surface; radius: 28; clip: true
          for nt, k in ttNotifs key nt.key {
            Spacer { height: 1; fill: width; background: border; visible: k > 0 }
            Column {
              gap: 0
              padding: [20, 14]
              onTap: notification("open", nt.key)
              Text { text: nt.title; fontSize: 16; maxLines: 1 }
              Text { text: nt.text; fontSize: 14; color: muted; maxLines: 2; visible: nt.text != "" }
            }
          }
        }
      }
      Text { text: "Events"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Row {
        gap: 16
        align: center
        padding: [20, 14]
        background: surface; radius: 28
        onTap: terminal('$EDITOR ~/.config/timetree/events.json', "TimeTree Events")
        Column {
          gap: 0
          weight: 1
          Text { text: "Edit the events file"; fontSize: 16; maxLines: 1 }
          Text { text: "~/.config/timetree/events.json"; fontSize: 14; color: muted; maxLines: 1 }
        }
        Text { text: "›"; fontSize: 18; color: muted }
      }
      Text { text: "Open TimeTree"; fontSize: 16; bold: true; align: center; fill: width; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 14]; onTap: androidApp("works.jubilee.timetree") }
    }
  }

  screen {
    title: "TimeTree"
    Column {
      scroll: true
      gap: 14
      padding: [0, 4, 0, 24]
      if twoCols {
        Row {
          gap: 24
          align: top
          Month { weight: 1 }
          Column {
            gap: 14
            weight: 1
            Day { }
            More { }
          }
        }
      } else {
        Month { }
        Day { }
        More { }
      }
    }
  }
}
