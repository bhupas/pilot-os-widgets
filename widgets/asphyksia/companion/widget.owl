widget "companion" {
  size: 3x3
  minSize: 2x2

  meta {
    owl: 9
    description: "An agent core with its own genome: a derived seed shapes its form and colour, use bends it, and rare rolls give aurora, eclipse or a one-in-4096 shiny."
    version: "2.1"
    license: "MIT"
    category: "dev"
  }

  requires { pacman: ["procps-ng"] }

  // Drive it from this system (one state per call, detail first so it is logged):
  //   owl-send <this widget file> set detail "reading widget.owl"
  //   owl-send <this widget file> set activity bash
  // Express it:
  //   owl-send <this widget file> set sigil "vigilante nocturno"
  //   owl-send <this widget file> set mood calm|focused|wild|curious
  //   owl-send <this widget file> set genome 1760312345   (adopt a species)
  state activity = "idle" persist     // idle | think | bash | read | edit | write | web | error
  state detail = "" persist           // what the agent is doing right now
  state since = 0 persist             // when the current activity started (Unix s)
  state log = [] persist              // last 24 transitions, newest first
  state total = 0 persist             // interactions ever — the core grows with these
  state counts = [0, 0, 0, 0, 0] persist  // per tool, same order as `tools`
  state born = 0 persist              // first interaction (Unix s)

  // ---- genome: the companion's own DNA --------------------------------
  // Seeded once, at birth, from the second of the first interaction, so two
  // companions are born different without any random command. The genome can
  // be set from outside to adopt another companion's shape; `sigil` and `mood`
  // let the agent name it and set its temper. Rarity comes from a tiny LCG.
  state genome = 0 persist
  state sigil = "" persist
  state mood = "curious" persist

  source now = clock every 1s
  source agents = cmd('c=0; for p in pi claude codex opencode crush grok; do n=$(pgrep -xc "$p" 2>/dev/null || true); c=$((c+n)); done; echo $c') every 10s

  let tools = ["bash", "read", "edit", "web", "think"]
  let age = since > 0 ? now - since : 0
  let energy = activity == "idle" ? 0.3 : clamp(1.15 - age / 240, 0.15, 1)
  let stage = total >= 400 ? 3 : total >= 120 ? 2 : total >= 30 ? 1 : 0
  let stageNames = ["spark", "sprite", "being", "aura"]
  let countsMax = last(sort(counts)) ?? 0
  let curious = total > 0 ? (counts[1] + counts[3]) / total : 0.5

  // ---- draw twelve numbers from the genome ---------------------------
  // A linear congruential generator: each roll is the previous one times a
  // small multiplier, modulo 2^31-1, so it stays inside exact integer range.
  let gid = genome >= 1 ? int(genome) : 0    // normalise: whole, positive, or none
  let g0 = (gid > 0 ? gid : 12345) % 65535 + 1   // never 0, whatever the code
  let r1 = (g0 * 48271) % 2147483647
  let r2 = (r1 * 48271) % 2147483647
  let r3 = (r2 * 48271) % 2147483647
  let r4 = (r3 * 48271) % 2147483647
  let r5 = (r4 * 48271) % 2147483647
  let r6 = (r5 * 48271) % 2147483647
  let r7 = (r6 * 48271) % 2147483647
  let r8 = (r7 * 48271) % 2147483647
  let r9 = (r8 * 48271) % 2147483647
  let r10 = (r9 * 48271) % 2147483647

  // shape — from the genome, so it can be adopted
  let arms = 3 + r1 % 7                 // 3..9 rotational arms
  let sides = 3 + r2 % 7                // 3..9 sides on the outer polygon
  let sats = r3 % 4                     // 0..3 satellites
  let spin = r4 % 2 == 0 ? 1 : -1       // which way it turns
  let twist = (r5 % 100) / 100          // 0..1 spiral twist
  let hue = r6 % 360                    // palette shift
  let ringN = 8 + r9 % 12               // ticks in the chaser ring

  // rarity — from the genome
  let rare = r8 % 100 == 0              // 1 in 100: aurora palette
  let epic = r7 % 1000 == 0             // 1 in 1000: eclipse core
  let une = r10 % 10 == 0               // 1 in 10: an extra ornament ring

  // shiny is the companion's own — from `born`, never from the genome, so
  // adopting someone's code never passes a shiny on
  let b0 = (born > 0 ? born : 1) % 65536
  let br1 = (b0 * 48271) % 2147483647
  let br2 = (br1 * 48271) % 2147483647
  let shiny = br2 % 4096 == 0           // 1 in 4096

  // usage drift: the mix of tools bends the shape (bash -> angular,
  // read/web -> spirally), so it also evolves by how the user works
  let bashShare = total > 0 ? counts[0] / total : 0
  let readShare = total > 0 ? (counts[1] + counts[3]) / total : 0
  let sides2 = clamp(round(sides + (bashShare - readShare) * 3), 3, 12)
  let twist2 = clamp(twist + readShare * 0.6, 0, 1.5)
  let orbR = 1.30 + (r10 % 40) / 100      // how far the outer structure sits

  // mood: the agent sets the temper, and it changes the tempo of everything
  let moodK = mood == "calm" ? 0.6 : mood == "focused" ? 0.85 : mood == "wild" ? 1.7 : 1.15
  let dna = {
    arms: arms, sides: sides2, sats: sats, spin: spin, twist: twist2,
    hue: hue, ringN: ringN, moodK: moodK, orbR: orbR,
    shiny: shiny ? 1 : 0, rare: rare ? 1 : 0, epic: epic ? 1 : 0, une: une ? 1 : 0
  }
  let code = gid > 0 ? fixed(gid, 0) : "…"
  let grade = shiny ? "✦ shiny" : epic ? "eclipse" : rare ? "aurora" : une ? "ornate" : "common"
  let badge = shiny ? "✦" : epic ? "◑" : rare ? "❋" : une ? "◇" : ""
  // colour: while idle the species shows its own hue; an activity overrides it
  let tint = activity == "idle" ? hsl(hue, 0.55, 0.62, 1) :
    activity == "bash" ? "#4ade80" : activity == "read" ? "#60a5fa" :
    activity == "edit" ? "#facc15" : activity == "write" ? "#fb923c" :
    activity == "web" ? "#22d3ee" : activity == "think" ? "#c084fc" :
    activity == "error" ? "#f87171" : accent

  on activity {
    // scripts and buttons alike: this mode's clock starts here
    since = now
    log = [[{t: now, tool: value, detail: detail}], log].flatten().take(24)
    total = value != "idle" ? total + 1 : total
    counts = range(len(tools)).map(i => counts[i] + (tools[i] == value ? 1 : 0))
    born = born == 0 && value != "idle" ? now : born
    genome = genome < 1 && value != "idle" ? now : genome
  }
  on detail {
    since = value == "went quiet" ? since : now
  }
  when num(agents, 0) > 0 {
    detail = activity == "idle" ? "an agent started" : detail
    activity = activity == "idle" ? "think" : activity
  }
  on agents {
    detail = value == 0 && activity == "think" ? "the agents stopped" : detail
    activity = value == 0 && activity == "think" ? "idle" : activity
  }
  let quiet = activity != "idle" && age > 300 && !(activity == "think" && num(agents, 0) > 0)
  every 10s {
    detail = quiet ? "went quiet" : detail
    activity = quiet ? "idle" : activity
  }

  // The companion: an abstract reactive core whose form is its genome.
  component Core(ener, col, coreSize, act, stage, cur, dna) {
    Box {
      fill: true
      align: center
      Canvas {
        fill: true
        let cx = width / 2
        let cy = height / 2
        let R = min(width, height) / 2 - 6
        let fr = min(width, height) * 0.30
        let tm = time * dna.moodK
        let act2 = act == "write" ? "edit" : act
        let ai = indexOf(tools, act2)
        let aang = ai >= 0 ? rad(tm * 10 + ai * 360 / len(tools)) : null
        let locked = aang != null
        let nodeCol = act2 == "bash" ? "#4ade80" : act2 == "read" ? "#60a5fa" : act2 == "edit" ? "#facc15" : act2 == "web" ? "#22d3ee" : act2 == "think" ? "#c084fc" : col
        let flick = act == "error" && sin(tm * 24) < 0 ? 0.4 : 1
        let col2 = dna.shiny > 0 ? hsl((tm * 60 + dna.hue) % 360, 0.9, 0.62, 1)
          : dna.rare > 0 ? hsl((dna.hue + tm * 12) % 360, 0.65, 0.6, 1)
          : col

        // --- frame ----------------------------------------------------
        circle(cx, cy, R, stroke: alpha(border, 0.7), width: 1)
        circle(cx, cy, R * 0.62, stroke: alpha(border, 0.35), width: 1)

        // --- chaser tick ring (stage 1+) ------------------------------
        if stage >= 1 {
          for i in range(dna.ringN) {
            let ta = rad(i * 360 / dna.ringN + tm * 6 * dna.spin)
            let hot = locked ? pow(max(cos(ta - aang), 0), 3) : (i == floor(tm * 8) % dna.ringN ? 0.8 : 0)
            let ln = 2.5 + 3 * hot
            line(cx + fr * 1.18 * cos(ta), cy + fr * 1.18 * sin(ta),
              cx + (fr * 1.18 + ln) * cos(ta), cy + (fr * 1.18 + ln) * sin(ta),
              stroke: alpha(col2, (0.15 + 0.7 * hot) * flick), width: 1.5)
          }
        }

        // --- voice: polar waveform, signature from mode and genome ----
        let lobes0 = act == "think" ? 3 : act == "bash" ? 7 : act == "read" ? 5 : act == "web" ? 6 : act == "error" ? 11 : 2
        let lobes = max(2, lobes0 + dna.arms - 6)
        let wspd = act == "idle" ? 1.2 : act == "think" ? 2.5 : act == "bash" ? 9 : act == "read" ? 6 : act == "web" ? 5 : 14
        let wf = (act == "idle" ? 0.025 : act == "think" ? 0.05 : 0.08) * (0.4 + ener)
        let wamp = wf * (1 + dna.twist * 0.35)
        path(range(65).map(i => [
          cx + fr * (0.95 + (sin(rad(i / 64 * 360) * lobes + tm * wspd * dna.spin) * 0.6 +
            sin(rad(i / 64 * 360) * (lobes * 2 + 1) - tm * wspd * 0.7) * 0.4 +
            (act == "error" ? sin(rad(i / 64 * 360) * 29 + tm * 31) * 0.5 : 0)) * wamp) * cos(rad(i / 64 * 360)),
          cy + fr * (0.95 + (sin(rad(i / 64 * 360) * lobes + tm * wspd * dna.spin) * 0.6 +
            sin(rad(i / 64 * 360) * (lobes * 2 + 1) - tm * wspd * 0.7) * 0.4 +
            (act == "error" ? sin(rad(i / 64 * 360) * 29 + tm * 31) * 0.5 : 0)) * wamp) * sin(rad(i / 64 * 360))
        ]), closed: true, stroke: alpha(col2, 0.9 * flick), width: 1.5)
        path(range(65).map(i => [
          cx + fr * (0.95 + (sin(rad(i / 64 * 360) * lobes + (tm - 0.35) * wspd * dna.spin) * 0.6 +
            sin(rad(i / 64 * 360) * (lobes * 2 + 1) - (tm - 0.35) * wspd * 0.4) * 0.4) * wamp) * cos(rad(i / 64 * 360)),
          cy + fr * (0.95 + (sin(rad(i / 64 * 360) * lobes + (tm - 0.35) * wspd * dna.spin) * 0.6 +
            sin(rad(i / 64 * 360) * (lobes * 2 + 1) - (tm - 0.35) * wspd * 0.4) * 0.4) * wamp) * sin(rad(i / 64 * 360))
        ]), closed: true, stroke: alpha(col2, 0.25 * flick), width: 1)

        // --- attention: search sweep, or lock on the tool in use ------
        if !locked {
          rotate(tm * (20 + 20 * cur), cx, cy) {
            arc(cx, cy, R * 0.82, 0, 50, stroke: alpha(col2, 0.4), width: 2, cap: round)
          }
        } else {
          let nx = cx + R * cos(aang)
          let ny = cy + R * sin(aang)
          line(cx + fr * 1.05 * cos(aang), cy + fr * 1.05 * sin(aang), nx, ny,
            stroke: alpha(nodeCol, 0.25 + 0.5 * ener), width: 1.5)
          let inbound = act == "read" || act == "web"
          for k in range(3) {
            let ph = (tm * 0.9 + k / 3) % 1
            let d = inbound ? 1 - ph : ph
            let rr = lerp(fr * 1.05, R, d)
            circle(cx + rr * cos(aang), cy + rr * sin(aang), 1.8, fill: alpha(nodeCol, 0.95 - 0.6 * abs(d - 0.5)))
          }
          circle(nx, ny, 4.5, fill: nodeCol)
          circle(nx, ny, 8 + 2 * sin(tm * 5), stroke: alpha(nodeCol, 0.6), width: 1)
          for q in range(4) {
            let ba = aang + rad(45 + q * 90)
            line(nx + 7 * cos(ba), ny + 7 * sin(ba), nx + 11 * cos(ba), ny + 11 * sin(ba),
              stroke: alpha(nodeCol, 0.8), width: 1.5)
          }
        }

        // --- tool nodes ------------------------------------------------
        for t, i in tools {
          let ang = rad(tm * 10 + i * 360 / len(tools))
          let x = cx + R * cos(ang)
          let y = cy + R * sin(ang)
          let c = t == "bash" ? "#4ade80" : t == "read" ? "#60a5fa" : t == "edit" ? "#facc15" : t == "web" ? "#22d3ee" : "#c084fc"
          circle(x, y, act2 == t ? 4.5 : 2.5, fill: act2 == t ? c : alpha(c, 0.5))
        }

        if act == "think" {
          for k in range(5) {
            let pa = rad(tm * 50 + k * 72)
            circle(cx + fr * 0.5 * cos(pa), cy + fr * 0.5 * sin(pa), 1.5, fill: alpha(col2, 0.7))
          }
        }

        // --- evolution: structure grows with use, shaped by the genome -
        if stage >= 2 {
          rotate(-tm * 15 * dna.spin, cx, cy) {
            for i in range(dna.arms * 2) {
              arc(cx, cy, fr * 1.32, i * 360 / (dna.arms * 2), 360 / (dna.arms * 2) * 0.4,
                stroke: alpha(col2, 0.35 * flick), width: 1)
            }
          }
        }
        if stage >= 3 {
          rotate(tm * 8 * dna.spin, cx, cy) {
            // one segment and one vertex at a time, so aurora can rainbow it
            for i in range(dna.sides) {
              let a1 = rad(i * 360 / dna.sides)
              let a2 = rad((i + 1) * 360 / dna.sides)
              let ec = dna.rare > 0 ? hsl((dna.hue + i * 47 + tm * 18) % 360, 0.78, 0.62, 1) : col2
              line(cx + fr * dna.orbR * cos(a1), cy + fr * dna.orbR * sin(a1),
                cx + fr * dna.orbR * cos(a2), cy + fr * dna.orbR * sin(a2),
                stroke: alpha(ec, 0.75), width: 1.5)
              circle(cx + fr * dna.orbR * cos(a1), cy + fr * dna.orbR * sin(a1), 2.2, fill: alpha(ec, 0.9))
            }
          }
          if dna.sats > 0 {
            for k in range(dna.sats) {
              let sa = rad(tm * 40 * dna.spin + k * 360 / dna.sats)
              circle(cx + fr * dna.orbR * cos(sa), cy + fr * dna.orbR * sin(sa), 1.8, fill: alpha(col2, 0.85))
            }
          }
        }
        // 1 in 10: an extra, slower outer ring
        if dna.une > 0 {
          rotate(tm * 5, cx, cy) {
            for i in range(6) {
              arc(cx, cy, fr * 1.62, i * 60, 25, stroke: alpha(col2, 0.22), width: 1)
            }
          }
        }
        // shiny: an iridescent corona and sparkles, impossible to miss
        if dna.shiny > 0 {
          circle(cx, cy, R * 0.97 + 2 * sin(tm * 3), stroke: alpha(hsl((tm * 80) % 360, 0.9, 0.72, 1), 0.7), width: 1.5)
          for k in range(10) {
            let sa = rad(tm * 70 + k * 36)
            let sr = fr * 1.55 + 4 * sin(tm * 5 + k)
            let sp = 1.5 + 1.5 * abs(sin(tm * 6 + k * 1.7))
            line(cx + sr * cos(sa), cy + sr * sin(sa), cx + (sr + sp * 4) * cos(sa), cy + (sr + sp * 4) * sin(sa),
              stroke: alpha(hsl((tm * 90 + k * 40) % 360, 0.9, 0.78, 1), 0.9), width: 1.5)
          }
        }
      }
      Shader {
        size: coreSize
        fallback: accent
        uniforms: { tint: col, energy: ener, irid: dna.shiny, ecl: dna.epic }
        code: """
          uniform half4 tint;
          uniform float energy;
          uniform float irid;
          uniform float ecl;
          half4 main(float2 p) {
            float R = min(size.x, size.y) * 0.5;
            float2 uv = (p - size.xy * 0.5) / R;
            float r = length(uv);
            if (r > 1.05) { return half4(0.0, 0.0, 0.0, 0.0); }
            float a = atan(uv.y, uv.x);
            float t = time * (0.6 + 1.8 * energy);
            float w1 = sin(a * 5.0 + t * 1.7 + sin(r * 9.0 - t * 2.2) * 1.6) * 0.5 + 0.5;
            float w2 = sin(a * 3.0 - t * 1.1 + r * 7.0) * 0.5 + 0.5;
            float plasma = w1 * 0.65 + w2 * 0.35;
            float core = smoothstep(1.0, 0.15, r);
            float rim = exp(-pow((r - 0.85) * 9.0, 2.0));
            float pulse = 0.88 + 0.12 * sin(t * 3.1);
            half3 c = mix(tint.rgb * 0.45, tint.rgb, plasma);
            c = mix(c, half3(1.0), core * plasma * 0.5 * energy);
            // eclipse: a near-black core with a bright rim
            c = mix(c, half3(0.004, 0.0, 0.012), ecl * 0.9);
            c += (tint.rgb * 0.35 + half3(0.55)) * rim * (0.3 + 0.6 * energy + ecl * 1.7);
            // shiny: iridescent, the hue sliding over time
            half3 ir = half3(
              0.5 + 0.5 * sin(6.2831 * (time * 0.15)),
              0.5 + 0.5 * sin(6.2831 * (time * 0.15 + 0.33)),
              0.5 + 0.5 * sin(6.2831 * (time * 0.15 + 0.66)));
            c = mix(c, ir, irid * 0.55);
            float alpha = clamp(core * (0.30 + 0.65 * energy) * pulse + rim * 0.45 * energy, 0.0, 1.0);
            return half4(c, alpha * 0.75);
          }
        """
      }
    }
  }

  // The screen's forms: "name" for the sigil, "adopt" for a species code; "" for none.
  state sheet = ""
  state draft = ""
  // Each mode's colour in the theme, for text and bars (the core keeps its own).
  let tones = {bash: green, read: blue, edit: yellow, write: orange, web: cyan, think: magenta, error: red}
  let tone = get(tones, activity, accent)
  let wide = (screenWidth ?? 0) > 600

  onTap: screen()

  // The tile: what it's doing, the core, and the detail.
  Column {
    gap: 2
    fill: true
    Row {
      align: center
      Text { text: upper(activity); style: label; color: activity == "idle" ? muted : tone; weight: 1; maxLines: 1 }
      if badge != "" {
        Text { text: badge; style: small; color: shiny ? hsl((now * 40) % 360, 0.9, 0.7, 1) : accent; width: 16; align: end; maxLines: 1 }
      }
    }
    Box { weight: 1; fill: width; align: center
      Core { ener: energy; col: tint; coreSize: 96; act: activity; stage: stage; cur: curious; dna: dna }
    }
    Text {
      text: detail != "" ? detail : sigil != "" ? sigil : num(agents, 0) > 0 ? "${agents} agent${num(agents, 0) == 1 ? "" : "s"} online" : "Standing by"
      style: small; color: muted; maxLines: 1
    }
  }

  component Item(label, value) {
    Row {
      gap: 16
      align: center
      padding: [20, 14]
      Text { text: label; fontSize: 16; maxLines: 1 }
      Text { text: value; fontSize: 16; color: muted; align: end; weight: 1; maxLines: 1 }
    }
  }

  component Heading(label) {
    Text { text: label; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
  }

  component Line() {
    Spacer { height: 1; fill: width; background: border }
  }

  // Who it is: the core, its name and what it's doing, its species and mood.
  component Being() {
    Column {
      gap: 12
      Box { height: 260; fill: width; align: center
        Core { ener: energy; col: tint; coreSize: 150; act: activity; stage: stage; cur: curious; dna: dna }
      }
      Column {
        gap: 0
        Text { text: sigil != "" ? sigil : activity == "idle" ? "Idle" : activity; fontSize: 48; bold: true; color: activity == "idle" ? foreground : tone; maxLines: 2 }
        Text { text: (detail != "" ? detail : "No current task") + (activity != "idle" ? " · ${fmtDuration(max(age, 0))}" : ""); fontSize: 16; color: muted; maxLines: 2 }
      }
      Heading { label: "Species" }
      Column {
        gap: 0
        background: surface; radius: 28; clip: true
        Row {
          gap: 16
          align: center
          padding: [20, 14]
          onTap: { draft = sigil; sheet = "name" }
          Text { text: "Name"; fontSize: 16; maxLines: 1 }
          Text { text: sigil != "" ? sigil : "Not named"; fontSize: 16; color: sigil != "" ? accent : muted; align: end; weight: 1; maxLines: 1 }
          Text { text: "›"; fontSize: 18; color: muted }
        }
        Line { }
        Row {
          gap: 16
          align: center
          padding: [20, 14]
          onTap: copy(code)
          Column {
            gap: 0
            weight: 1
            Text { text: "Code ${code}"; fontSize: 16; maxLines: 1 }
            Text { text: "Tap to copy, to share this species"; fontSize: 14; color: muted; maxLines: 1 }
          }
          Text { text: grade; fontSize: 16; color: shiny || epic || rare ? accent : muted; maxLines: 1 }
        }
        Line { }
        Item { label: "Shape"; value: "arms ${arms} · sides ${sides2} · sats ${sats} · ring ${ringN}" }
        Line { }
        Row {
          gap: 16
          align: center
          padding: [20, 14]
          onTap: { draft = ""; sheet = "adopt" }
          Text { text: "Adopt a species"; fontSize: 16; weight: 1; maxLines: 1 }
          Text { text: "›"; fontSize: 18; color: muted }
        }
      }
      Heading { label: "Mood" }
      Row {
        gap: 8
        for m in ["calm", "focused", "curious", "wild"] {
          Text { text: upper(sub(m, 0, 1)) + sub(m, 1, len(m)); fontSize: 15; weight: 1; align: center; maxLines: 1; radius: 20; padding: [0, 10]; background: mood == m ? mix(surface, accent, 0.22) : surface; onTap: mood = m }
        }
      }
    }
  }

  // How it grew and what it did: tool use, the log, modes to try, and how scripts drive it.
  component History() {
    Column {
      gap: 12
      Heading { label: "Evolution" }
      Column {
        gap: 0
        background: surface; radius: 28; clip: true
        Item { label: "Stage"; value: stageNames[stage] }
        Line { }
        Item { label: "Interactions"; value: "${total}" }
        Line { }
        Item { label: "Alive"; value: born > 0 ? fmtDuration(max(now - born, 0)) : "Just born" }
        Line { }
        Column {
          gap: 10
          padding: [20, 14]
          for t, i in tools key t {
            Row {
              gap: 12
              align: center
              Text { text: t; fontSize: 14; color: get(tones, t, accent); width: 48; maxLines: 1 }
              Progress { value: countsMax > 0 ? counts[i] / countsMax * 100 : 0; color: get(tones, t, accent); weight: 1 }
              Text { text: "${counts[i]}"; fontSize: 14; font: mono; color: muted; width: 40; align: end; maxLines: 1 }
            }
          }
        }
      }
      Heading { label: "Activity log" }
      Column {
        gap: 0
        background: surface; radius: 28; clip: true
        if len(log) == 0 {
          Text { text: "Nothing yet. Start an agent or try a mode below."; fontSize: 16; color: muted; padding: [20, 16] }
        }
        for e, i in log key i {
          Spacer { height: 1; fill: width; background: border; visible: i > 0 }
          Row {
            gap: 12
            align: center
            padding: [20, 12]
            Text { text: fmtTime(e.t, "HH:mm:ss"); fontSize: 14; font: mono; color: muted; width: 72; maxLines: 1 }
            Text { text: e.tool; fontSize: 14; bold: true; color: get(tones, e.tool, accent); width: 48; maxLines: 1 }
            Text { text: e.detail ?? ""; fontSize: 14; weight: 1; maxLines: 1 }
          }
        }
      }
      Heading { label: "Try a mode" }
      Flow {
        gap: 8
        for t in tools {
          Text { text: t; fontSize: 15; color: get(tones, t, accent); maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 10]; onTap: { detail = "manual test"; activity = t } }
        }
        Text { text: "idle"; fontSize: 15; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 10]; onTap: { detail = ""; activity = "idle" } }
      }
      Heading { label: "From scripts" }
      Text {
        text: "Any script can drive it, one state per call: owl-send <this widget file> set detail \"reading widget.owl\" then set activity bash; set sigil \"a name\" to name it; set mood calm|focused|curious|wild for its temper; or set genome <code> to adopt a species. It also lights up on its own while an agent (pi, claude, codex…) is running, and settles back to idle when it stops."
        fontSize: 14; color: muted; background: surface; radius: 28; padding: [20, 16]
      }
    }
  }

  screen {
    title: "companion"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      if wide {
        Row {
          gap: 24
          Being { weight: 1 }
          History { weight: 1 }
        }
      } else {
        Being { }
        History { }
      }
    }

    // Naming it, or adopting another companion's species by its code.
    if sheet != "" {
      Sheet {
        title: sheet == "name" ? "Name your companion" : "Adopt a species"
        onDismiss: sheet = ""
        Column {
          gap: 16
          padding: [0, 4, 0, 4]
          if sheet == "name" {
            Input { text: draft; placeholder: "A name"; focus: sheet == "name"; onChange: draft = value; onSubmit: { sigil = value; sheet = "" } }
          } else {
            Input { text: draft; placeholder: "Species code"; keyboard: "number"; focus: sheet == "adopt"; onChange: draft = value; onSubmit: { genome = value == "" ? genome : num(value, genome); sheet = "" } }
            Text { text: "Its shape and colours change to that species. A shiny stays with the companion it was born to."; fontSize: 14; color: muted }
          }
          Row {
            gap: 8
            align: center
            if sheet == "name" && sigil != "" {
              Text { text: "Remove"; fontSize: 15; color: red; maxLines: 1; padding: [8, 12]; onTap: { sigil = ""; sheet = "" } }
            }
            Spacer { weight: 1 }
            Text { text: "Cancel"; fontSize: 15; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 12]; onTap: sheet = "" }
            Text {
              text: "Save"; fontSize: 15; bold: true; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 12]
              onTap: {
                if sheet == "name" {
                  sigil = draft
                } else {
                  genome = draft == "" ? genome : num(draft, genome)
                }
                sheet = ""
              }
            }
          }
        }
      }
    }
  }
}
