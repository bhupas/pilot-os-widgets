widget "dns" {
  size: 3x1
  minSize: 1x1

  meta { owl: 8; description: "Switch this machine's DNS resolver between Cloudflare, Google, Quad9 and the default in /etc/resolv.conf, showing the active server and its response time."; version: "1.2"; license: "MIT"; category: "system" }

  requires { pacman: ["bind"] }

  // The resolver list in use, read live from the file the toggle writes.
  source resolv = file("/etc/resolv.conf")
  // Response time of the resolver the system is actually using, via dig.
  source probe = cmd('f=/etc/resolv.conf; s=$(awk "/^[[:space:]]*nameserver/ {print \$2; exit}" "$f"); [ -n "$s" ] || exit 0; dig +time=2 +tries=1 +stats @"$s" cloudflare.com A 2>/dev/null | awk "/Query time:/ {print \$4}"') every 60s timeout 15s

  // Preset secondary servers are unique, so they tell the presets apart from the
  // default resolv.conf, which already lists 1.1.1.1 and 8.8.8.8.
  let provider = contains(resolv ?? "", "9.9.9.9") ? "quad9" : contains(resolv ?? "", "8.8.4.4") ? "google" : contains(resolv ?? "", "1.0.0.1") ? "cloudflare" : "default"
  let servers = lines(resolv ?? "").filter(l => startsWith(trim(l), "nameserver")).map(l => words(l)[1])
  let presets = [
    {id: "default", name: "Default", tint: foreground, detail: "The system's own, as it was"},
    {id: "cloudflare", name: "Cloudflare", tint: orange, detail: "1.1.1.1 · 1.0.0.1"},
    {id: "google", name: "Google", tint: blue, detail: "8.8.8.8 · 8.8.4.4"},
    {id: "quad9", name: "Quad9", tint: magenta, detail: "9.9.9.9 · 149.112.112.112"}
  ]
  let current = presets.find(p => p.id == provider)
  let ms = len(probe ?? "") > 0 ? "${probe} ms" : ""
  let wide = (screenWidth ?? 0) > 600

  onTap: screen()

  // One row: the resolver and its time. Two or more: the tile's usual label, value and detail.
  Column {
    gap: 2
    fill: true
    if (rows ?? 1) < 2 {
      Row {
        gap: 8
        align: center
        fill: true
        Text { text: current.name; fontSize: 20; color: current.tint; weight: 1; maxLines: 1 }
        if (cols ?? 3) >= 2 {
          Text { text: ms; style: small; color: muted; width: 52; align: end; maxLines: 1 }
        }
      }
    } else {
      Row {
        align: center
        Text { text: "DNS"; style: label; color: muted; weight: 1; maxLines: 1 }
        Text { text: ms; style: label; color: muted; width: 52; align: end; maxLines: 1 }
      }
      Text { text: current.name; fontSize: (cols ?? 3) >= 4 ? 40 : 28; color: current.tint; maxLines: 1 }
      Text { text: join(servers, " · "); style: small; color: muted; maxLines: 1 }
    }
  }

  // The resolvers to pick from; a tap rewrites resolv.conf, backing up the original once.
  component Resolvers() {
    Column {
      gap: 12
      Text { text: "Resolver"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        for p, i in presets key p.id {
          Spacer { height: 1; fill: width; background: border; visible: i > 0 }
          Row {
            gap: 16
            align: center
            padding: [20, 14]
            onTap: run('f=/etc/resolv.conf; b=/etc/resolv.conf.omarchy-default; [ -f "$b" ] || cp "$f" "$b"; p=' + sh(p.id) + '; case $p in default) [ -f "$b" ] && cp "$b" "$f" ;; cloudflare) s="1.1.1.1 1.0.0.1 2606:4700:4700::1111 2606:4700:4700::1001" ;; google) s="8.8.8.8 8.8.4.4 2001:4860:4860::8888 2001:4860:4860::8844" ;; quad9) s="9.9.9.9 149.112.112.112 2620:fe::fe 2620:fe::9" ;; esac; if [ "$p" != default ]; then { for i in $s; do echo "nameserver $i"; done; echo "options timeout:1 attempts:1"; } > "$f"; fi; true')
            Column {
              gap: 0
              weight: 1
              Text { text: p.name; fontSize: 16; maxLines: 1 }
              Text { text: p.detail; fontSize: 14; color: muted; maxLines: 1 }
            }
            Box {
              size: 20; radius: 10; align: center; border: 2; borderColor: p.id == provider ? accent : muted
              Spacer { size: 10; radius: 5; background: p.id == provider ? accent : transparent }
            }
          }
        }
      }
    }
  }

  component Servers() {
    Column {
      gap: 12
      Text { text: "Servers in use"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        for s, i in servers {
          Spacer { height: 1; fill: width; background: border; visible: i > 0 }
          Text { text: s; fontSize: 16; font: mono; maxLines: 1; padding: [20, 14] }
        }
        if len(servers) == 0 {
          Text { text: resolv == null ? "Loading…" : "No nameserver in /etc/resolv.conf."; fontSize: 16; color: muted; padding: [20, 14] }
        }
      }
    }
  }

  screen {
    title: "DNS"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      Column {
        gap: 0
        Text { text: current.name; fontSize: 48; bold: true; color: current.tint; maxLines: 1 }
        Text { text: ms == "" ? "The resolver in use" : "Answers in ${ms}"; fontSize: 16; color: muted; maxLines: 1 }
      }
      if wide {
        Row {
          gap: 24
          align: top
          Resolvers { weight: 1 }
          Servers { weight: 1 }
        }
      } else {
        Resolvers { }
        Servers { }
      }
    }
  }
}
