widget "terminal-profiles" {
  size: 6x4
  minSize: 2x2
  padding: 0

  meta {
    owl: 9
    description: "Live terminal with profiles: switch commands from the chevron, manage them from the menu"
    version: "1.3"
    license: "MIT"
    category: "dev"
  }

  // Profiles: name + command run in the tile Terminal. Empty command = login shell.
  state profiles = [
    {id: "shell", name: "shell", command: ""},
  ] persist
  state defaultId = "shell" persist
  state seq = 1 persist

  // Not persisted: each start opens on the current default.
  state activeId = defaultId
  state dropOpen = false
  // The screen's form: "" closed, "add" for a new profile, "edit" for editId's.
  state sheet = ""
  state editId = ""
  state draftName = ""
  state draftCmd = ""

  let active = profiles.find(p => p.id == activeId) ?? profiles[0] ?? {id: "shell", name: "shell", command: ""}
  let termCmd = trim(active.command ?? "") == "" ? "exec bash -l" : active.command
  let editing = profiles.find(p => p.id == editId)
  let barH = 28

  // The tile: a bar with the profile picker and the way into the screen, over the live terminal.
  Box {
    fill: true

    Column {
      gap: 0
      fill: true

      Row {
        gap: 4
        align: center
        height: barH
        padding: [10, 0]
        background: surface
        fill: width

        Text {
          text: "${upper(active.name ?? "shell")} ▾"
          style: label
          color: muted
          maxLines: 1
          weight: 1
          onTap: dropOpen = !dropOpen
        }

        Text {
          text: "⋯"
          style: title
          color: muted
          width: 28
          align: center
          onTap: { dropOpen = false; sheet = ""; screen() }
        }
      }

      // Changing command ends the old session and starts a new one.
      Terminal { command: "exec bash -c ${sh(termCmd)}"; weight: 1; fill: true }
    }

    if dropOpen {
      Box {
        fill: width
        height: max(0, (tileHeight ?? 0) - barH)
        offset: [0, barH]
        onTap: dropOpen = false
      }
    }

    if dropOpen {
      Box {
        align: topStart
        offset: [4, barH + 2]
        width: 180
        padding: 4
        radius: 16
        background: surface
        border: 1
        borderColor: border
        Column {
          gap: 2
          for p in profiles key p.id {
            let on = p.id == activeId
            Row {
              gap: 6
              align: center
              padding: [12, 10]
              radius: 12
              background: on ? mix(surface, accent, 0.22) : transparent
              onTap: {
                activeId = p.id
                dropOpen = false
              }
              Text { text: p.name; style: small; weight: 1; maxLines: 1; color: on ? accent : foreground }
              if p.id == defaultId {
                Text { text: "★"; style: small; color: muted; width: 14; align: center }
              }
            }
          }
        }
      }
    }
  }

  screen {
    title: "terminal profiles"
    Column {
      gap: 12
      fill: true
      padding: [0, 4, 0, 24]
      Column {
        gap: 0
        Text { text: active.name ?? "shell"; fontSize: 48; bold: true; maxLines: 1 }
        Text { text: "Running in the tile" + (active.id == defaultId ? " · the default" : ""); fontSize: 16; color: muted; maxLines: 1 }
      }
      Text { text: "Profiles"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Box {
        weight: 1
        fill: width
        align: bottomEnd
        Column {
          gap: 0
          fill: true
          scroll: true
          background: surface; radius: 28; clip: true
          for p, i in profiles key p.id {
            let on = p.id == activeId
            Spacer { height: 1; fill: width; background: border; visible: i > 0 }
            Row {
              gap: 12
              align: center
              padding: [20, 14]
              // Into the form, to change, clone or delete it.
              onTap: {
                editId = p.id
                draftName = p.name
                draftCmd = p.command ?? ""
                sheet = "edit"
              }
              Column {
                gap: 0
                weight: 1
                Text { text: p.name; fontSize: 16; maxLines: 1; color: on ? accent : foreground }
                Text { text: trim(p.command ?? "") == "" ? "Login shell" : p.command; fontSize: 14; font: mono; color: muted; maxLines: 1 }
              }
              if p.id == defaultId {
                Text { text: "Default"; fontSize: 12; maxLines: 1; background: mix(surface, accent, 0.22); radius: 12; padding: [10, 4] }
              }
            }
          }
          // Room at the end, so the add button never covers the last profile.
          Spacer { height: 80 }
        }
        // Adding, as Google's apps do: a button over the list's corner, opening the form in a sheet.
        Box {
          padding: 16
          Box {
            size: 56; radius: 16; align: center; background: accent
            onTap: { draftName = ""; draftCmd = ""; editId = ""; sheet = "add" }
            Text { text: "+"; fontSize: 32; color: background; align: center; fill: width }
          }
        }
      }
    }

    if sheet != "" {
      Sheet {
        title: sheet == "edit" ? "Edit profile" : "New profile"
        onDismiss: sheet = ""
        Column {
          gap: 16
          padding: [0, 4, 0, 4]
          Input {
            text: draftName
            placeholder: "Name"
            focus: sheet != ""
            onChange: draftName = value
          }
          Input {
            text: draftCmd
            placeholder: "Command, e.g. btop; exec bash"
            onChange: draftCmd = value
          }
          Text { text: "Empty runs the login shell. It runs when the profile is picked from ▾ on the tile."; fontSize: 14; color: muted }
          if sheet == "edit" {
            Flow {
              gap: 8
              Text { text: "Use now"; fontSize: 15; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 10]; onTap: { activeId = editId; sheet = "" } }
              if editId != defaultId {
                Text { text: "Make default"; fontSize: 15; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 10]; onTap: { defaultId = editId; sheet = "" } }
              }
              Text {
                text: "Clone"; fontSize: 15; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 10]
                onTap: {
                  profiles = profiles + [{
                    id: "p${seq}",
                    name: (trim(draftName) == "" ? (editing.name ?? "profile") : trim(draftName)) + " copy",
                    command: draftCmd
                  }]
                  seq = seq + 1
                  sheet = ""
                }
              }
            }
          }
          Row {
            gap: 8
            align: center
            if sheet == "edit" && len(profiles) > 1 {
              Text {
                text: "Delete"; fontSize: 15; color: red; maxLines: 1; padding: [8, 12]
                onTap: {
                  activeId = activeId == editId ? profiles.find(p => p.id != editId).id : activeId
                  defaultId = defaultId == editId ? profiles.find(p => p.id != editId).id : defaultId
                  profiles = profiles.filter(p => p.id != editId)
                  sheet = ""
                }
              }
            }
            Spacer { weight: 1 }
            Text { text: "Cancel"; fontSize: 15; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 12]; onTap: sheet = "" }
            Text {
              text: "Save"; fontSize: 15; bold: true; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 12]
              onTap: {
                if sheet == "edit" {
                  profiles = profiles.map(p => p.id == editId
                    ? {id: p.id, name: trim(draftName) == "" ? p.name : trim(draftName), command: draftCmd}
                    : p)
                } else {
                  profiles = profiles + [{
                    id: "p${seq}",
                    name: trim(draftName) == "" ? "profile ${seq}" : trim(draftName),
                    command: draftCmd
                  }]
                  activeId = "p${seq}"
                  seq = seq + 1
                }
                sheet = ""
              }
            }
          }
        }
      }
    }
  }
}
