widget "cursor plan" {
  size: 3x3
  minSize: 3x2

  meta {
    owl: 8;
    description: "Cursor plan name with included and API usage percent from the local Cursor session";
    version: "1.1";
    license: "MIT";
    category: "dev"
  }

  requires { pacman: ["jq", "curl"] }

  // Plan name + included/API % from Cursor's dashboard APIs (local session token).
  source data = cmd("""
    auth=~/.config/cursor/auth.json
    token=$(jq -r '.accessToken // empty' "$auth")
    if [ -z "$token" ]; then
      printf '%s\n' '{"ok":false,"error":"sign in to Cursor"}'
      exit 0
    fi
    usage=$(printf 'Authorization: Bearer %s\n' "$token" | curl -sfS --max-time 15 -X POST \
      'https://api2.cursor.sh/aiserver.v1.DashboardService/GetCurrentPeriodUsage' \
      -H @- -H 'Content-Type: application/json' -H 'Connect-Protocol-Version: 1' -d '{}') || {
      printf '%s\n' '{"ok":false,"error":"usage unavailable"}'
      exit 0
    }
    plan=$(printf 'Authorization: Bearer %s\n' "$token" | curl -sfS --max-time 15 -X POST \
      'https://api2.cursor.sh/aiserver.v1.DashboardService/GetPlanInfo' \
      -H @- -H 'Content-Type: application/json' -H 'Connect-Protocol-Version: 1' -d '{}') || {
      printf '%s\n' '{"ok":false,"error":"plan unavailable"}'
      exit 0
    }
    jq -nc --argjson u "$usage" --argjson p "$plan" '{
      ok: true,
      plan: ($p.planInfo.planName // "Cursor"),
      price: ($p.planInfo.price // ""),
      planPct: ($u.planUsage.totalPercentUsed // 0),
      apiPct: ($u.planUsage.apiPercentUsed // 0),
      included: (($u.planUsage.includedSpend // 0) / 100),
      limit: (($u.planUsage.limit // 0) / 100),
      cycleEnd: ($u.billingCycleEnd // null | if . then tonumber / 1000 else null end),
      message: ($u.displayMessage // "")
    }' || printf '%s\n' '{"ok":false,"error":"usage unavailable"}'
  """) every 5m json timeout 40s

  let planPct = data.ok ? round(data.planPct) : null
  let apiPct = data.ok ? round(data.apiPct) : null
  let planColor = planPct == null ? muted : planPct >= 90 ? red : planPct >= 75 ? yellow : accent
  let apiColor = apiPct == null ? muted : apiPct >= 90 ? red : apiPct >= 75 ? yellow : accent
  let resets = data.ok && data.cycleEnd != null ? fmtTime(data.cycleEnd, "MMM d") : null
  let short = (rows ?? 3) < 3

  onTap: screen()

  component Usage(label, pct, tint) {
    Column {
      gap: 8
      padding: [20, 14]
      Row {
        align: center
        Text { text: label; fontSize: 16; maxLines: 1; weight: 1 }
        Text { text: pct == null ? "…" : "${pct}%"; fontSize: 16; color: tint; maxLines: 1; width: 64; align: end }
      }
      Progress { value: pct ?? 0; color: tint; fill: width; animate value: spring() }
    }
  }

  Column {
    gap: 2
    fill: true
    if !short {
      Row {
        align: center
        Text { text: "CURSOR"; style: label; color: muted; weight: 1; maxLines: 1 }
        if data.price != null && data.price != "" {
          Text { text: upper(data.price); style: label; color: muted; maxLines: 1; width: 64; align: end }
        }
      }
    }
    if data == null {
      Text { text: "…"; fontSize: 40; color: muted; maxLines: 1 }
    } else if !data.ok {
      Text { text: data.error ?? "offline"; fontSize: 18; bold: true; color: muted; maxLines: 2 }
    } else {
      Text { text: "${planPct}%"; fontSize: 40; color: planPct >= 75 ? planColor : foreground; maxLines: 1 }
      Text { text: "of ${data.plan} · API ${apiPct}%"; style: small; color: muted; maxLines: 1 }
      Spacer { weight: 1 }
      if !short {
        Progress { value: planPct ?? 0; color: planColor; fill: width; animate value: spring() }
        if resets != null {
          Text { text: data.limit > 0 ? "\$${fixed(data.included, 0)} of \$${fixed(data.limit, 0)} · resets ${resets}" : "Resets ${resets}"; style: small; color: muted; maxLines: 1 }
        }
      }
    }
  }

  screen {
    title: "cursor"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      Column {
        gap: 0
        Text { text: planPct == null ? "…" : "${planPct}%"; fontSize: 48; bold: true; color: planPct != null && planPct >= 75 ? planColor : foreground; maxLines: 1 }
        Text { text: data == null ? "Loading…" : !data.ok ? (data.error ?? "offline") : "of the ${data.plan} plan used" + (resets == null ? "" : " · resets ${resets}"); fontSize: 16; color: muted; maxLines: 2 }
      }
      if data.ok {
        Text { text: "This period"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
        Column {
          gap: 0
          background: surface
          radius: 28
          clip: true
          Usage { label: "Plan"; pct: planPct; tint: planColor }
          Spacer { height: 1; fill: width; background: border }
          Usage { label: "API"; pct: apiPct; tint: apiColor }
          if data.limit > 0 {
            Spacer { height: 1; fill: width; background: border }
            Row {
              gap: 16
              align: center
              padding: [20, 14]
              Text { text: "Included spend"; fontSize: 16; maxLines: 1; weight: 1 }
              Text { text: "\$${fixed(data.included, 0)} of \$${fixed(data.limit, 0)}"; fontSize: 16; color: muted; maxLines: 1 }
            }
          }
          if resets != null {
            Spacer { height: 1; fill: width; background: border }
            Row {
              gap: 16
              align: center
              padding: [20, 14]
              Text { text: "Resets"; fontSize: 16; maxLines: 1; weight: 1 }
              Text { text: fmtTime(data.cycleEnd, "EEE d MMM"); fontSize: 16; color: muted; maxLines: 1 }
            }
          }
          if data.price != null && data.price != "" {
            Spacer { height: 1; fill: width; background: border }
            Row {
              gap: 16
              align: center
              padding: [20, 14]
              Text { text: data.plan; fontSize: 16; maxLines: 1; weight: 1 }
              Text { text: data.price; fontSize: 16; color: muted; maxLines: 1 }
            }
          }
        }
        if data.message != "" {
          Text { text: data.message; fontSize: 14; color: muted; padding: [4, 8, 0, 0] }
        }
      }
      Text { text: "Open the dashboard"; fontSize: 16; bold: true; align: center; fill: width; background: accent; color: background; radius: 24; padding: [24, 14]; onTap: url("https://cursor.com/dashboard/usage") }
    }
  }
}
