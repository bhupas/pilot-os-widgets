widget "what's new" {
  page: 2
  order: 9
  size: 3x2
  minSize: 2x2
  meta { description: "What's new in the launcher, from its changelog on GitHub. Tap it for every release"; version: "1.1"; license: "MIT"; category: "news"; owl: 8 }

  source log = http("https://raw.githubusercontent.com/SimonSchubert/omalauncher/main/CHANGELOG.md") every 6h timeout 10s status
  source sys = android.system every 1h

  // Each "## 0.5.0 (versionCode 10) – 2026-10-11" section, with its "- " items.
  // An item's wrapped lines are indented by two spaces, so they're joined first.
  let releases = split(log.ok ? log.out : "", "\n## ").drop(1).map(s => {
    version: lower(words(first(lines(s)))[0]),
    date: match(first(lines(s)), "\\d{4}-\\d{2}-\\d{2}"),
    items: lines(replace(s, "\n  ", " ")).filter(l => startsWith(l, "- ")).map(l => replace(sub(l, 2), "`", ""))
  }).filter(r => len(r.items) > 0)
  // "Unreleased" is what's coming; the tile shows the newest release.
  let latest = releases.find(r => r.date != null)
  let behind = latest != null && sys.launcher != null && latest.version != sys.launcher

  onTap: screen()

  // The tile: the newest version big, its date (or that an update is out), then its changes as fit.
  Column {
    gap: 2
    fill: true
    Row {
      align: center
      Text { text: "WHAT'S NEW"; style: label; color: muted; weight: 1; maxLines: 1 }
    }
    if latest != null {
      Text { text: latest.version; fontSize: 40; color: accent; maxLines: 1 }
      Text { text: behind ? "Update available" : latest.date; style: small; color: behind ? yellow : muted; maxLines: 1 }
      for item in latest.items.take(max((rows ?? 2) * 3 - 6, 0)) {
        Text { text: "• ${item}"; style: small; maxLines: 1 }
      }
    } else {
      Text { text: log == null ? "…" : "Offline"; fontSize: 40; color: muted; maxLines: 1 }
      Text { text: log == null ? "Loading" : "GitHub can't be reached"; style: small; color: muted; maxLines: 1 }
    }
  }

  // The app: the newest release big, then every release as a card of its changes.
  let wide = (screenWidth ?? 0) > 600

  component Release(r) {
    let installed = r.version == sys.launcher
    Column {
      gap: 12
      Row {
        gap: 8
        align: center
        padding: [4, 8, 0, 0]
        Text { text: r.date == null ? "Coming next" : r.version; fontSize: 14; bold: true; color: r.date == null ? muted : accent; weight: 1; maxLines: 1 }
        if installed {
          Text { text: "Installed"; fontSize: 12; bold: true; color: green; maxLines: 1; background: mix(surface, green, 0.22); radius: 12; padding: [10, 4] }
        }
        Text { text: r.date ?? ""; fontSize: 14; color: muted; maxLines: 1 }
      }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        for item, i in r.items {
          Spacer { height: 1; fill: width; background: border; visible: i > 0 }
          Row {
            padding: [20, 14]
            Text { text: item; fontSize: 16; color: r.date == null ? muted : foreground; weight: 1 }
          }
        }
      }
    }
  }

  screen {
    title: "what's new"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      Column {
        gap: 0
        Text { text: latest != null ? latest.version : log == null ? "Loading…" : "Offline"; fontSize: 48; bold: true; maxLines: 1 }
        Text {
          text: latest == null ? (log == null ? "Reading the changelog" : "GitHub can't be reached") : behind ? "Released ${latest.date} · you have ${sys.launcher}" : "Released ${latest.date} · installed"
          fontSize: 16; color: behind ? yellow : muted; maxLines: 1
        }
      }
      if wide {
        Row {
          gap: 12
          align: top
          Column { gap: 12; weight: 1; for r, k in releases key r.version { if k % 2 == 0 { Release { r: r } } } }
          Column { gap: 12; weight: 1; for r, k in releases key r.version { if k % 2 == 1 { Release { r: r } } } }
        }
      } else {
        for r in releases key r.version { Release { r: r } }
      }
      Row {
        gap: 8
        Spacer { weight: 1 }
        Text { text: "Open on GitHub"; fontSize: 15; bold: true; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 12]; onTap: url("https://github.com/SimonSchubert/omalauncher/blob/main/CHANGELOG.md") }
      }
    }
  }
}
