widget "forecast" {
  meta { description: "Three-day weather forecast with an hourly temperature curve, located by IP or a city you type, via wttr.in"; version: "1.3"; license: "MIT"; category: "world"; owl: 9 }
  size: 6x3
  minSize: 4x3

  requires { pacman: ["curl", "jq"] }

  state city = "" persist
  state editing = false           // the city form is open
  state draft = ""                // the city, as typed
  // The city, percent-encoded so it can't break the URL or the shell's single quotes. Empty means located by IP.
  let q = city.replace("%", "%25").replace("+", "%2B").replace("/", "%2F").replace("?", "%3F").replace("#", "%23").replace("&", "%26").replace("'", "%27").replace(" ", "+")
  // Without a city wttr.in picks the location from the IP address. Only what's drawn is kept from its ~50 KB.
  source w = cmd("""
    curl -fsm 12 'https://wttr.in/${q}?format=j1' | jq -c '{
      place: .nearest_area[0].areaName[0].value,
      now: .current_condition[0] | {temp: .temp_C, desc: .weatherDesc[0].value},
      days: [.weather[] | {date, day: (.date | strptime("%Y-%m-%d") | strftime("%a")), max: .maxtempC, min: .mintempC, hours: [.hourly[].tempC | tonumber]}]
    }'
  """) every 30m json timeout 20s
  let hours = flatten(w.days.map(d => d.hours))
  let lo = min(hours) - 2
  let hi = max(hours) + 2
  let wideTile = (cols ?? 6) >= 5
  let wide = (screenWidth ?? 0) > 600

  onTap: screen()

  // The hourly temperatures as a curve, 8 readings a day, every 3 hours; the dots mark noon.
  component Curve() {
    Canvas {
      fill: true
      let pts = hours.map((t, i) => [i / max(len(hours) - 1, 1) * width, height - 4 - (t - lo) / (hi - lo) * (height - 8)])
      path(pts, stroke: accent, width: 2)
      for p, i in pts {
        if i % 8 == 4 { circle(p[0], p[1], 3, color: accent) }
      }
    }
  }

  Column {
    gap: 2
    fill: true
    Row {
      align: center
      Text { text: "FORECAST"; style: label; color: muted; weight: 1; maxLines: 1 }
      Text { text: upper(w.place ?? ""); style: label; color: accent; maxLines: 1; width: 120; align: end }
    }
    Row {
      gap: 12
      align: center
      Text { text: w == null ? "…" : "${w.now.temp}°"; fontSize: 40; maxLines: 1; width: 92 }
      Text { text: w.now.desc; style: small; color: muted; maxLines: 2; weight: 1 }
      if wideTile {
        for d, i in w.days key d.date {
          Column {
            gap: 0
            width: 52
            Text { text: i == 0 ? "Today" : d.day; style: label; color: muted; maxLines: 1; align: end; fill: width }
            Text { text: "${d.max}° ${d.min}°"; style: small; maxLines: 1; align: end; fill: width }
          }
        }
      }
    }
    Curve { weight: 1; fill: width }
  }

  screen {
    title: "forecast"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      Column {
        gap: 0
        Text { text: w == null ? "…" : "${w.now.temp}°"; fontSize: 48; bold: true; maxLines: 1 }
        Text { text: w == null ? "Loading…" : "${w.now.desc} · ${w.place}"; fontSize: 16; color: muted; maxLines: 2 }
      }
      Row {
        gap: 12
        align: top
        Column {
          gap: 12
          weight: 1
          Text { text: "Next three days"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
          Column {
            gap: 0
            background: surface
            radius: 28
            clip: true
            for d, i in w.days key d.date {
              Spacer { height: 1; fill: width; background: border; visible: i > 0 }
              Row {
                gap: 16
                align: center
                padding: [20, 14]
                Text { text: i == 0 ? "Today" : i == 1 ? "Tomorrow" : fmtTime(parseTime(d.date, "yyyy-MM-dd"), "EEEE"); fontSize: 16; maxLines: 1; weight: 1 }
                Text { text: "${d.max}°"; fontSize: 16; maxLines: 1; width: 48; align: end }
                Text { text: "${d.min}°"; fontSize: 16; color: muted; maxLines: 1; width: 48; align: end }
              }
            }
          }
        }
        if wide {
          Column {
            gap: 12
            weight: 1
            Text { text: "Hour by hour"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
            Column { background: surface; radius: 28; clip: true; padding: 20
              Curve { height: 140; fill: width }
            }
          }
        }
      }
      if !wide {
        Text { text: "Hour by hour"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
        Column { background: surface; radius: 28; clip: true; padding: 20
          Curve { height: 120; fill: width }
        }
      }
      Text { text: "Location"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        Row {
          gap: 16
          align: center
          padding: [20, 14]
          onTap: { draft = city; editing = true }
          Text { text: "City"; fontSize: 16; maxLines: 1; weight: 1 }
          Text { text: city == "" ? "Automatic" : city; fontSize: 16; color: city == "" ? muted : accent; maxLines: 1 }
          Text { text: "›"; fontSize: 18; color: muted }
        }
      }
      Text { text: "Open wttr.in"; fontSize: 16; bold: true; align: center; fill: width; background: accent; color: background; radius: 24; padding: [24, 14]; onTap: url("https://wttr.in/${q}") }

      // The city, typed; empty locates it by the IP address.
      if editing {
        Sheet {
          title: "City"
          onDismiss: editing = false
          Column {
            gap: 16
            padding: [0, 4, 0, 4]
            Input {
              text: draft
              placeholder: "Empty to locate by IP"
              focus: editing
              onChange: draft = value
              onSubmit: { city = trim(value); editing = false; refresh() }
            }
            Row {
              gap: 8
              align: center
              Text { text: "Automatic"; fontSize: 15; maxLines: 1; color: accent; padding: [8, 12]; onTap: { city = ""; editing = false; refresh() } }
              Spacer { weight: 1 }
              Text { text: "Cancel"; fontSize: 15; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 12]; onTap: editing = false }
              Text { text: "Save"; fontSize: 15; bold: true; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 12]; onTap: { city = trim(draft); editing = false; refresh() } }
            }
          }
        }
      }
    }
  }
}
