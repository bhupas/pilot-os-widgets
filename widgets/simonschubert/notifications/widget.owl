widget "notifications" {
  size: 3x4
  minSize: 3x3
  requires { pacman: [] }
  meta { description: "Your phone's notifications on the home screen, newest first, with a count per app. Tap one to open it; tap the tile for all of them by app, to open or dismiss"; version: "1.1"; license: "MIT"; category: "productivity"; owl: 9 }

  // {available, count, items: [{key, app, package, title, text, time, clearable}]}, newest first,
  // without ongoing ones (music, downloads) and group headers. Needs notification access.
  source n = android.notifications
  source now = clock every 1m

  // The notification open in the sheet, by key; "" for none.
  state picked = ""

  let items = n.items ?? []
  let allowed = n == null || n.available != false
  let apps = items.map(i => i.app).unique().map(a => {app: a, count: count(items, i => i.app == a)})
  let palette = [accent, blue, magenta, cyan, green, orange, yellow, red]
  let sel = items.find(i => i.key == picked)
  let wide = (screenWidth ?? 0) > 600

  onTap: screen()

  component Dot(app, d = 22) {
    Box {
      size: d
      radius: d / 2
      background: alpha(palette[len(app) % 8], 0.22)
      align: center
      Text { text: upper(sub(app, 0, 1)); fontSize: d * 0.5; bold: true; color: palette[len(app) % 8]; align: center }
    }
  }

  // The tile: how many, from how many apps, then the newest as many as fit (one per 30 dp).
  Column {
    gap: 2
    fill: true
    Text { text: "NOTIFICATIONS"; style: label; color: muted; maxLines: 1 }
    if !allowed {
      Text { text: "Allow"; fontSize: 40; maxLines: 1 }
      Text { text: "Tap to open the setting that shows them here"; style: small; color: muted; maxLines: 2; onTap: notification("open", "") }
    } else {
      Text { text: n == null ? "…" : len(items) == 0 ? "None" : "${n.count}"; fontSize: 40; color: len(items) > 0 ? accent : foreground; maxLines: 1 }
      Text { text: len(items) == 0 ? "All caught up" : len(apps) == 1 ? "from ${apps[0].app}" : "from ${len(apps)} apps"; style: small; color: muted; maxLines: 1 }
      Spacer { height: 6 }
      Column {
        gap: 8
        for i in items.take(max(floor(((tileHeight ?? 256) - 130) / 30), 0)) key i.key {
          Row {
            gap: 8
            align: center
            onTap: notification("open", i.key)
            Dot { app: i.app; d: 20 }
            Text { text: i.title != "" ? i.title : i.text; style: small; weight: 1; maxLines: 1 }
          }
        }
      }
    }
  }

  component Lead() {
    Column {
      gap: 12
      Column {
        gap: 0
        Text { text: !allowed ? "No access" : n == null ? "…" : len(items) == 0 ? "All caught up" : "${n.count}"; fontSize: 48; bold: true; maxLines: 1 }
        Text { text: !allowed ? "Allow notification access to see them here" : len(items) == 0 ? "No notifications" : "notification${n.count == 1 ? "" : "s"} from ${len(apps)} app${len(apps) == 1 ? "" : "s"}"; fontSize: 16; color: muted; maxLines: 2 }
      }
      if !allowed {
        Text { text: "Allow access"; fontSize: 16; bold: true; align: center; fill: width; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 14]; onTap: notification("open", "") }
      }
    }
  }

  // Every notification, by app, newest first; a tap opens it in a sheet.
  component ByApp() {
    Column {
      gap: 12
      for a in apps key a.app {
        Text { text: "${a.app} · ${a.count}"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0]; maxLines: 1 }
        Column {
          gap: 0
          background: surface
          radius: 28
          clip: true
          for i, k in items.filter(x => x.app == a.app) key i.key {
            let age = now - i.time
            Spacer { height: 1; fill: width; background: border; visible: k > 0 }
            Row {
              gap: 16
              align: center
              padding: [20, 14]
              onTap: picked = i.key
              Dot { app: i.app; d: 32 }
              Column {
                gap: 0
                weight: 1
                Text { text: i.title != "" ? i.title : i.app; fontSize: 16; maxLines: 1 }
                Text { text: i.text; fontSize: 14; color: muted; maxLines: 2; visible: i.text != "" }
              }
              Text { text: age < 60 ? "now" : age < 3600 ? "${floor(age / 60)}m" : age < 86400 ? "${floor(age / 3600)}h" : "${floor(age / 86400)}d"; fontSize: 14; color: muted; maxLines: 1 }
            }
          }
        }
      }
    }
  }

  screen {
    title: "notifications"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      if wide {
        Row {
          gap: 24
          align: top
          Lead { weight: 1 }
          ByApp { weight: 1 }
        }
      } else {
        Lead { }
        ByApp { }
      }
    }

    // One notification in full: open it as the shade would, or dismiss it.
    if sel != null {
      Sheet {
        title: sel.app
        onDismiss: picked = ""
        Column {
          gap: 16
          padding: [0, 4, 0, 4]
          Column {
            gap: 4
            Text { text: sel.title; fontSize: 18; bold: true; visible: sel.title != "" }
            Text { text: sel.text; fontSize: 16; visible: sel.text != "" }
            Text { text: fmtTime(sel.time, "EEE d MMM · HH:mm"); fontSize: 14; color: muted; maxLines: 1 }
          }
          Row {
            gap: 8
            align: center
            if sel.clearable == true {
              Text { text: "Dismiss"; fontSize: 15; color: red; padding: [8, 12]; maxLines: 1; onTap: { notification("dismiss", sel.key); picked = "" } }
            }
            Spacer { weight: 1 }
            Text { text: "Cancel"; fontSize: 15; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 12]; onTap: picked = "" }
            Text { text: "Open"; fontSize: 15; bold: true; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 12]; onTap: { notification("open", sel.key); picked = "" } }
          }
        }
      }
    }
  }
}
