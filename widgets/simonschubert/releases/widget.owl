widget "releases" {
  meta { owl: 8; description: "The latest release of each GitHub repository listed in ~/.config/omarchy-proot/releases; new ones stand out"; version: "1.2"; license: "MIT"; category: "dev" }
  size: 6x3
  minSize: 3x2

  requires { pacman: ["curl", "jq"] }

  // One owner/repo per line, fetched in parallel without a token (GitHub allows 60 requests an hour).
  source rel = cmd("""
    f=~/.config/omarchy-proot/releases
    mkdir -p "${f%/*}"
    [ -f "$f" ] || printf 'omacom/omarchy\nneovim/neovim\nhyprwm/Hyprland\njesseduffield/lazygit\nsxyazi/yazi\n' > "$f"
    {
      grep -v '^#' "$f" | grep . | while read -r repo; do
        curl -fsLm 10 "https://api.github.com/repos/$repo/releases/latest" |
          jq -c --arg repo "$repo" '{repo: $repo, tag: .tag_name, url: .html_url, at: (.published_at | fromdateiso8601)}' &
      done
      wait
    } | jq -sc 'sort_by(-.at)'
  """) every 1h json timeout 30s
  source now = clock every 5m

  // Each with its age in days and how that reads.
  let list = (rel ?? []).map(r => {repo: r.repo, tag: r.tag, url: r.url, days: floor((now - r.at) / 86400)}).map(r => {
    repo: r.repo, tag: r.tag, url: r.url, days: r.days, fresh: r.days < 7,
    name: split(r.repo, "/")[1], owner: split(r.repo, "/")[0],
    age: r.days < 1 ? "today" : r.days == 1 ? "yesterday" : "${r.days}d ago"
  })
  let fresh = list.filter(r => r.fresh)
  let older = list.filter(r => !r.fresh)
  let top = list[0]
  let short = (rows ?? 3) < 3
  let narrow = (cols ?? 6) < 4
  // A row is about 18 dp: as many as fit under the newest one.
  let more = short ? 0 : max(floor(((rows ?? 3) * 64 - 30 - 92) / 18), 0)
  let wide = (screenWidth ?? 0) > 600

  onTap: screen()

  // A card of releases, each opening its page on GitHub.
  component Card(items) {
    Column {
      gap: 0
      background: surface
      radius: 28
      clip: true
      for r, i in items key r.repo {
        Spacer { height: 1; fill: width; background: border; visible: i > 0 }
        Row {
          gap: 16
          align: center
          padding: [20, 14]
          onTap: url(r.url)
          Column {
            gap: 0
            weight: 1
            Text { text: r.name; fontSize: 16; maxLines: 1 }
            Text { text: r.owner; fontSize: 14; color: muted; maxLines: 1 }
          }
          Column {
            gap: 0
            width: 120
            Text { text: r.tag; fontSize: 16; color: r.fresh ? green : foreground; maxLines: 1; align: end; fill: width }
            Text { text: r.age; fontSize: 14; color: muted; maxLines: 1; align: end; fill: width }
          }
        }
      }
    }
  }

  Column {
    gap: 2
    fill: true
    if !short {
      Row {
        align: center
        Text { text: "RELEASES"; style: label; color: muted; weight: 1; maxLines: 1 }
        Text { text: len(fresh) > 0 ? "${len(fresh)} NEW" : ""; style: label; color: green; maxLines: 1; width: 56; align: end }
      }
    }
    if rel == null {
      Text { text: "…"; fontSize: 40; color: muted; maxLines: 1 }
    } else if top == null {
      Text { text: "None yet"; fontSize: 28; bold: true; maxLines: 1 }
      Text { text: "Tap to edit the list"; style: small; color: muted; maxLines: 1 }
    } else {
      Text { text: top.tag; fontSize: narrow ? 28 : 36; bold: true; color: top.fresh ? green : foreground; maxLines: 1; onTap: url(top.url) }
      Text { text: "${top.name} · ${top.age}"; style: small; color: muted; maxLines: 1 }
      Spacer { height: 4 }
      for r in list.drop(1).take(more) key r.repo {
        Row {
          align: center
          gap: 6
          onTap: url(r.url)
          Box { size: 6; radius: 3; background: r.fresh ? green : transparent }
          Text { text: r.name; style: small; maxLines: 1; weight: 1 }
          Text { text: r.tag; style: small; color: r.fresh ? green : foreground; maxLines: 1; width: narrow ? 64 : 96; align: end }
          if !narrow { Text { text: r.days < 1 ? "today" : "${r.days}d"; style: small; color: muted; maxLines: 1; width: 40; align: end } }
        }
      }
    }
  }

  screen {
    title: "releases"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      Column {
        gap: 0
        Text { text: top == null ? "…" : top.tag; fontSize: 48; bold: true; color: top != null && top.fresh ? green : foreground; maxLines: 1 }
        Text { text: top == null ? (rel == null ? "Loading…" : "No releases found") : "${top.repo}, ${top.age} · ${len(fresh)} new this week"; fontSize: 16; color: muted; maxLines: 2 }
      }
      if wide && len(fresh) > 0 && len(older) > 0 {
        Row {
          gap: 12
          align: top
          Column {
            gap: 12
            weight: 1
            Text { text: "This week"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
            Card { items: fresh }
          }
          Column {
            gap: 12
            weight: 1
            Text { text: "Earlier"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
            Card { items: older }
          }
        }
      } else {
        if len(fresh) > 0 {
          Text { text: "This week"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
          Card { items: fresh }
        }
        if len(older) > 0 {
          Text { text: "Earlier"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
          Card { items: older }
        }
      }
      Text { text: "Repositories"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        Row {
          gap: 16
          align: center
          padding: [20, 14]
          onTap: terminal('$EDITOR ~/.config/omarchy-proot/releases', "releases")
          Column {
            gap: 0
            weight: 1
            Text { text: "Edit the list"; fontSize: 16; maxLines: 1 }
            Text { text: "One owner/repo per line"; fontSize: 14; color: muted; maxLines: 1 }
          }
          Text { text: "›"; fontSize: 18; color: muted }
        }
        Spacer { height: 1; fill: width; background: border }
        Row {
          gap: 16
          align: center
          padding: [20, 14]
          onTap: refresh()
          Text { text: "Check now"; fontSize: 16; maxLines: 1; weight: 1 }
          Text { text: "Every hour"; fontSize: 14; color: muted; maxLines: 1 }
        }
      }
    }
  }
}
