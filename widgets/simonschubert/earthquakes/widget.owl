widget "earthquakes" {
  meta { owl: 8; description: "Earthquakes of magnitude 4.5 and up worldwide in the last day, from the USGS"; version: "1.2"; license: "MIT"; category: "world" }
  size: 6x3
  minSize: 3x2

  requires { pacman: ["curl", "jq"] }

  source quakes = cmd("""
    curl -fsm 12 'https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/4.5_day.geojson' | jq -c '[.features[] | .properties | {
      mag, place: (.place // "unknown"), at: (.time / 1000 | floor), url, tsunami: (.tsunami == 1)
    }] | sort_by(-.at)'
  """) every 10m json timeout 20s
  source now = clock every 60s
  let all = (quakes ?? []).map(q => {mag: q.mag, place: q.place, at: q.at, url: q.url, tsunami: q.tsunami,
    tint: q.mag >= 6 ? red : q.mag >= 5 ? orange : yellow,
    ago: now - q.at < 3600 ? "${max(floor((now - q.at) / 60), 1)}m" : "${floor((now - q.at) / 3600)}h"})
  let top = all.sortBy(q => -q.mag).first()
  let short = (rows ?? 3) < 3
  let wide = (screenWidth ?? 0) > 600

  onTap: screen()

  // The tile: the strongest one big, where it was, then the newest as rows allow.
  Column {
    gap: 2
    fill: true
    if !short {
      Row {
        align: center
        Text { text: "QUAKES"; style: label; color: muted; weight: 1; maxLines: 1 }
        Text { text: quakes == null ? "" : "${len(all)} IN 24H"; style: label; color: accent; maxLines: 1; width: 80; align: end }
      }
    }
    Text { text: quakes == null ? null : top == null ? "Calm" : "M${fixed(top.mag, 1)}"; fontSize: 40; color: top == null ? foreground : top.tint; maxLines: 1 }
    Text { text: quakes == null ? "Loading…" : top == null ? "Nothing of 4.5 or more in 24h" : "${top.place} · ${top.ago} ago"; style: small; color: muted; maxLines: 1 }
    Spacer { weight: 1 }
    for q in all.take(max((rows ?? 3) * 3 - 7, 0)) key q.url {
      Row {
        gap: 8
        align: center
        Text { text: fixed(q.mag, 1); style: small; bold: true; color: q.tint; width: 28; maxLines: 1 }
        Text { text: q.place; style: small; weight: 1; maxLines: 1 }
        Text { text: q.ago; style: small; color: muted; width: 32; align: end; maxLines: 1 }
      }
    }
  }

  component Summary() {
    Column {
      gap: 12
      Column {
        gap: 0
        Text { text: quakes == null ? "…" : "${len(all)}"; fontSize: 48; bold: true; maxLines: 1 }
        Text { text: quakes == null ? "Loading the USGS feed" : top == null ? "No earthquakes of 4.5 or more in the last day" : "Earthquakes of 4.5 or more in the last day · strongest M${fixed(top.mag, 1)}"; fontSize: 16; color: muted }
      }
      if top != null {
        Text { text: "Strongest"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
        Row {
          gap: 16
          align: center
          padding: [20, 16]
          background: mix(surface, accent, 0.22); radius: 28
          onTap: url(top.url)
          Text { text: fixed(top.mag, 1); fontSize: 32; bold: true; color: top.tint; maxLines: 1 }
          Column {
            gap: 0
            weight: 1
            Text { text: top.place; fontSize: 16; maxLines: 2 }
            Text { text: "${fmtTime(top.at, "EEE HH:mm")} · ${top.ago} ago" + (top.tsunami ? " · tsunami alert" : ""); fontSize: 14; color: top.tsunami ? red : muted; maxLines: 1 }
          }
        }
      }
      Text { text: "Open the USGS map"; fontSize: 16; bold: true; align: center; fill: width; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 14]; onTap: url("https://earthquake.usgs.gov/earthquakes/map/") }
    }
  }

  component Latest() {
    Column {
      gap: 12
      Text { text: "Newest first"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface; radius: 28; clip: true
        if quakes != null && len(all) == 0 { Text { text: "Nothing to list."; fontSize: 16; color: muted; padding: [20, 16] } }
        for q, i in all key q.url {
          Spacer { height: 1; fill: width; background: border; visible: i > 0 }
          Row {
            gap: 16
            align: center
            padding: [20, 14]
            onTap: url(q.url)
            Text { text: fixed(q.mag, 1); fontSize: 18; bold: true; color: q.tint; width: 40; maxLines: 1 }
            Column {
              gap: 0
              weight: 1
              Text { text: q.place; fontSize: 16; maxLines: 1 }
              Text { text: "${fmtTime(q.at, "HH:mm")} · ${q.ago} ago" + (q.tsunami ? " · tsunami alert" : ""); fontSize: 14; color: q.tsunami ? red : muted; maxLines: 1 }
            }
          }
        }
      }
    }
  }

  screen {
    title: "earthquakes"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      if wide {
        Row {
          gap: 24
          Summary { weight: 1 }
          Latest { weight: 1 }
        }
      } else {
        Summary { }
        Latest { }
      }
    }
  }
}
