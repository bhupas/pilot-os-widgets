widget "todo" {
  meta { owl: 8; description: "Open items from the Markdown checklist ~/notes/todo.md; tap one to check it off"; version: "1.3"; license: "MIT"; category: "productivity" }
  size: 3x4
  minSize: 3x2

  // "- [ ] item" lines are open, "- [x] item" lines are done. Prints "line-number:item".
  source todo = cmd("""
    f=~/notes/todo.md
    mkdir -p "${f%/*}"
    [ -f "$f" ] || printf '# todo\n\n- [ ] tap an item to check it off\n- [ ] tap the title to edit this list\n' > "$f"
    grep -n '^\s*[-*] \[ \] ' "$f" | sed 's/^\([0-9]*\):\s*[-*] \[ \] /\1:/'
  """) every 1m
  let items = lines(todo).filter(l => contains(l, ":")).map(l => { line: num(split(l, ":")[0]), text: sub(l, len(split(l, ":")[0]) + 1) })
  let n = len(items ?? [])
  let short = (rows ?? 4) < 3

  onTap: screen()

  // The tile: how many are open, then as many as fit; a tap on one checks it off.
  Column {
    gap: 2
    fill: true
    if !short {
      Text { text: "TODO"; style: label; color: muted; maxLines: 1 }
    }
    Text { text: todo == null ? "…" : "${n}"; fontSize: short ? 32 : 40; color: todo != null && n == 0 ? green : foreground; maxLines: 1 }
    Text { text: todo == null ? "" : n == 0 ? "All done" : n == 1 ? "Thing to do" : "Things to do"; style: small; color: muted; maxLines: 1; visible: !short }
    Spacer { height: 4 }
    Column {
      scroll: true
      weight: 1
      gap: 6
      for it in items key it.line {
        Row {
          gap: 8
          align: center
          onTap: run("sed -i '${int(it.line)}s/\\[ \\]/[x]/' ~/notes/todo.md")
          Spacer { size: 12; radius: 6; border: 2; borderColor: muted }
          Text { text: it.text; style: small; maxLines: 1; weight: 1 }
        }
      }
    }
  }

  // The app: every open item, checked off with a tap, and the file to edit.
  screen {
    title: "todo"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      Column {
        gap: 0
        Text { text: todo == null ? "…" : n == 0 ? "All done" : "${n} to do"; fontSize: 48; bold: true; maxLines: 1 }
        Text { text: "From ~/notes/todo.md · tap one to check it off"; fontSize: 16; color: muted }
      }
      Text { text: "Open"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        for it, i in items key it.line {
          Spacer { height: 1; fill: width; background: border; visible: i > 0 }
          Row {
            gap: 16
            align: center
            padding: [20, 14]
            onTap: run("sed -i '${int(it.line)}s/\\[ \\]/[x]/' ~/notes/todo.md")
            Spacer { size: 22; radius: 11; border: 2; borderColor: muted }
            Text { text: it.text; fontSize: 16; weight: 1 }
          }
        }
        if n == 0 {
          Text { text: todo == null ? "Reading the list…" : "Nothing left to do."; fontSize: 16; color: muted; padding: [20, 16] }
        }
      }
      Text { text: "Edit the list"; fontSize: 16; bold: true; align: center; fill: width; background: accent; color: background; radius: 24; padding: [24, 14]; onTap: terminal('$EDITOR ~/notes/todo.md', "todo") }
    }
  }
}
