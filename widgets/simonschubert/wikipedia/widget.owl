widget "wikipedia" {
  meta { owl: 8; description: "Wikipedia's featured article of the day, what everyone is reading, and on this day in history"; version: "1.2"; license: "MIT"; category: "news" }
  size: 6x4
  minSize: 4x3

  requires { pacman: ["curl", "jq"] }

  // Wikimedia's daily feed for English Wikipedia; only the parts drawn are kept.
  source wp = cmd("""
    curl -fsm 12 "https://api.wikimedia.org/feed/v1/wikipedia/en/featured/$(date -u +%Y/%m/%d)" | jq -c '{
      tfa: (.tfa // null | if . then {title: .titles.normalized, text: .extract, url: .content_urls.mobile.page} else null end),
      read: [(.mostread.articles // [])[] | select(.namespace.id == 0) | {title: .titles.normalized, views, url: .content_urls.mobile.page}][:5],
      onthisday: [(.onthisday // [])[:3][] | {year, text}]
    }'
  """) every 1h json timeout 20s

  let read = wp.read ?? []
  let days = wp.onthisday ?? []
  let wide = (screenWidth ?? 0) > 600

  onTap: screen()

  // The tile: today's featured article, then the most read as rows allow.
  Column {
    gap: 2
    fill: true
    Text { text: "WIKIPEDIA"; style: label; color: muted; maxLines: 1 }
    Text { text: wp == null ? "…" : wp.tfa.title ?? read[0].title ?? "Nothing today"; fontSize: 24; bold: true; maxLines: 1 }
    Text { text: wp.tfa != null ? wp.tfa.text : "Today's featured article"; style: small; color: muted; maxLines: (rows ?? 4) >= 4 ? 3 : 2 }
    Spacer { weight: 1 }
    if len(read) > 0 && (rows ?? 4) >= 4 {
      Text { text: "MOST READ"; style: label; color: muted; maxLines: 1 }
      for a in read.take((rows ?? 4) - 1) key a.url {
        Row {
          gap: 8
          Text { text: a.title; style: small; maxLines: 1; weight: 1 }
          Text { text: a.views >= 1000000 ? "${fixed(a.views / 1000000, 1)}M" : "${round(a.views / 1000)}k"; style: small; color: muted; width: 48; align: end; maxLines: 1 }
        }
      }
    }
  }

  component Heading(text) { Text { text: text; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] } }

  // Today's featured article, big, with its summary.
  component Featured() {
    Column {
      gap: 12
      Column {
        gap: 4
        Text { text: wp == null ? "…" : wp.tfa.title ?? "Wikipedia"; fontSize: len(wp.tfa.title ?? "") > 24 ? 36 : 48; bold: true; maxLines: 3 }
        Text { text: wp == null ? "Loading today's feed…" : wp.tfa != null ? "Today's featured article" : "No featured article today"; fontSize: 16; color: muted }
      }
      if wp.tfa != null {
        Column {
          gap: 16
          background: surface
          radius: 28
          padding: 20
          Text { text: wp.tfa.text; fontSize: 16 }
          Row {
            Spacer { weight: 1 }
            Text { text: "Read the article"; fontSize: 16; bold: true; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 12]; onTap: url(wp.tfa.url) }
          }
        }
      }
    }
  }

  // What everyone is reading, and this day in history.
  component Lists() {
    Column {
      gap: 12
      if len(read) > 0 {
        Heading { text: "Most read" }
        Column {
          gap: 0
          background: surface
          radius: 28
          clip: true
          for a, i in read key a.url {
            Spacer { height: 1; fill: width; background: border; visible: i > 0 }
            Row {
              gap: 16
              align: center
              padding: [20, 14]
              onTap: url(a.url)
              Text { text: "${i + 1}"; fontSize: 16; color: accent; bold: true; width: 20 }
              Text { text: a.title; fontSize: 16; weight: 1; maxLines: 2 }
              Text { text: a.views >= 1000000 ? "${fixed(a.views / 1000000, 1)}M" : "${round(a.views / 1000)}k"; fontSize: 14; color: muted; width: 48; align: end; maxLines: 1 }
            }
          }
        }
      }
      if len(days) > 0 {
        Heading { text: "On this day" }
        Column {
          gap: 0
          background: surface
          radius: 28
          clip: true
          for e, i in days key i {
            Spacer { height: 1; fill: width; background: border; visible: i > 0 }
            Row {
              gap: 16
              align: top
              padding: [20, 14]
              Text { text: "${e.year}"; fontSize: 16; bold: true; color: accent; width: 52; maxLines: 1 }
              Text { text: e.text; fontSize: 16; weight: 1 }
            }
          }
        }
      }
      Text { text: "Open Wikipedia"; fontSize: 16; maxLines: 1; align: center; fill: width; background: mix(surface, accent, 0.22); radius: 24; padding: [24, 14]; onTap: url("https://en.m.wikipedia.org") }
    }
  }

  // The app: the featured article, most read and on this day, two columns on a wide screen.
  screen {
    title: "wikipedia"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      if wide {
        Row {
          gap: 24
          Featured { weight: 1 }
          Lists { weight: 1 }
        }
      } else {
        Featured { }
        Lists { }
      }
    }
  }
}
