widget "departures" {
  size: 3x2
  minSize: 2x1
  requires { pacman: [] }
  meta { description: "Live departures from a stop you pick, anywhere Transitous has open timetables: line, direction, platform and minutes to go, with delays. Tap the tile for the full board or to change the stop"; version: "1.1"; license: "MIT"; category: "world"; owl: 9 }

  // The stop, picked in the full screen and kept across restarts. No location is hard-coded.
  state stopId = "" persist
  state stopName = "" persist
  state query = ""
  state picking = false          // the stop search is open

  source now = clock every 15s
  // Transitous (https://transitous.org) asks clients to name themselves.
  let ua = {"User-Agent": "omarchy-widgets/departures (+https://github.com/SimonSchubert/omarchy-widgets)"}

  // There is no urlencode: escape what stop names contain. % goes first.
  let q = replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(
    trim(query), "%", "%25"), " ", "%20"), "&", "%26"), "#", "%23"), "?", "%3F"), "+", "%2B"), "/", "%2F"),
    "ä", "%C3%A4"), "ö", "%C3%B6"), "ü", "%C3%BC"), "Ä", "%C3%84"), "Ö", "%C3%96"), "Ü", "%C3%9C"), "ß", "%C3%9F"),
    "é", "%C3%A9"), "è", "%C3%A8"), "à", "%C3%A0"), "ç", "%C3%A7"), "ñ", "%C3%B1"), "ø", "%C3%B8")
  let sid = replace(replace(replace(replace(stopId, "%", "%25"), ":", "%3A"), "#", "%23"), " ", "%20")

  // An empty URL makes no request: it just comes back not ok.
  source found = http(len(trim(query)) < 2 ? "" : "https://api.transitous.org/api/v1/geocode?type=STOP&text=${q}", ua) every 1h timeout 15s json status
  source board = http(stopId == "" ? "" : "https://api.transitous.org/api/v6/stoptimes?stopId=${sid}&n=20", ua) every 30s timeout 15s json status

  let stops = (found != null && found.ok ? found.out ?? [] : []).take(8).map(s => {
    id: s.id,
    name: s.name,
    area: (s.areas ?? []).find(a => a.default == true).name ?? s.country ?? "",
    modes: lower(join((s.modes ?? []).take(3), ", "))
  })
  let rows = (board != null && board.ok ? board.out.stopTimes ?? [] : []).map(s => {
    key: "${s.tripId}${s.place.scheduledDeparture}",
    line: s.routeShortName != null && s.routeShortName != "?" ? s.routeShortName : s.displayName ?? s.mode ?? "",
    color: s.routeColor ?? "",
    text: s.routeTextColor ?? "",
    to: s.headsign ?? s.tripTo.name ?? "",
    at: floor(num(sub(s.place.departure ?? s.place.arrival ?? "", 11, 13))) * 60 + floor(num(sub(s.place.departure ?? s.place.arrival ?? "", 14, 16))),
    planned: floor(num(sub(s.place.scheduledDeparture ?? s.place.scheduledArrival ?? "", 11, 13))) * 60 + floor(num(sub(s.place.scheduledDeparture ?? s.place.scheduledArrival ?? "", 14, 16))),
    track: s.place.track ?? s.place.scheduledTrack,
    moved: s.place.track != null && s.place.scheduledTrack != null && s.place.track != s.place.scheduledTrack,
    live: s.realTime == true,
    cancelled: s.cancelled == true || s.tripCancelled == true
  })
  let problem = stopId == "" || board == null || board.ok ? null : board.code == 429 ? "too many requests" : "transitous offline"
  // Times are "2026-10-09T23:32:00Z" and the board only looks ahead, so minutes of the UTC day are enough:
  // a departure is (at - nowMin) mod 1440 minutes away, and one that wraps to ~1439 has just left.
  let nowMin = floor(now % 86400 / 60)
  let upcoming = rows.filter(r => (r.at - nowMin + 1440) % 1440 < 1380)
  // The next departure large (~50dp under the ~16dp stop name, ~34dp on one row), then as many smaller ones (~24dp) as fit.
  let tall = tileHeight == null || tileHeight >= 100
  let shown = upcoming.take(tileHeight == null ? 2 : clamp(1 + floor((tileHeight - (tall ? 92 : 64)) / 24), 1, 15))
  let showName = tileHeight == null || tileHeight >= 64
  let narrow = cols != null && cols <= 2

  onTap: screen()

  component Badge(r, w = 44) {
    Text {
      text: r.line
      style: label
      bold: true
      // The line's own colours, as the operator publishes them.
      color: r.text != "" ? "#${r.text}" : foreground
      background: r.color != "" ? "#${r.color}" : mix(surface, accent, 0.22)
      padding: [4, 2]
      radius: 6
      width: w
      align: center
      maxLines: 1
    }
  }

  // The countdown is what matters: big, and colored only by a live delay.
  component Departure(r, now, nowMin, mode = "tile") {
    Column {
      gap: 0
      let left = (r.at - nowMin + 1440) % 1440
      let at = now - now % 60 + left * 60
      let raw = (r.at - r.planned + 1440) % 1440
      let delay = raw > 720 ? raw - 1440 : raw
      let tint = r.cancelled ? red : !r.live ? foreground : delay >= 5 ? red : delay >= 2 ? yellow : foreground
      let big = r.cancelled ? "×" : left == 0 ? "now" : left < 60 ? "${left}" : fmtTime(at, "HH:mm")
      let unit = r.cancelled || left == 0 || left >= 60 ? "" : "min"
      let when = fmtTime(at, "HH:mm") + (r.track != null ? " · platform ${r.track}" : "") + (r.live && delay >= 2 ? " · ${delay} min late" : "")
      if mode == "lead" {
        // The screen's lead: the next one, as big as it gets.
        Text { text: r.cancelled ? "Cancelled" : unit == "" ? big : "${big} min"; fontSize: 48; bold: true; color: tint; maxLines: 1 }
        Text { text: "${r.line} to ${r.to} · ${when}"; fontSize: 16; color: muted; maxLines: 2 }
      } else if mode == "list" {
        Row {
          align: center
          gap: 12
          padding: [20, 14]
          Badge { r: r; w: 54 }
          Column {
            gap: 0
            weight: 1
            Text { text: r.to; fontSize: 16; color: r.cancelled ? muted : foreground; maxLines: 1 }
            Text { text: r.cancelled ? "Cancelled · ${when}" : when; fontSize: 14; color: r.moved ? orange : muted; maxLines: 1 }
          }
          Text { text: unit == "" ? big : "${big} min"; fontSize: 16; bold: true; color: tint; width: 64; align: end; maxLines: 1 }
        }
      } else {
        // "14 min  M36  U Haselhorst": the minutes first and largest, then the line, then where it goes.
        let lead = mode == "big"
        // One row: smaller. A two-column tile is ~110dp inside: everything a quarter smaller, and the line gives way last.
        let k = (narrow ? 0.75 : 1) * (lead && tileHeight != null && tileHeight < 100 ? 0.7 : 1)
        Row {
          align: bottom
          gap: narrow ? 3 : 6
          // A Text without a width fills the row, so each gets its own: a digit is under ~0.6em.
          Text { text: big; fontSize: (lead ? 40 : 18) * k; bold: true; color: tint; maxLines: 1; width: len(big) * (lead ? 40 : 18) * k * 0.62 + 2 }
          if unit != "" {
            Text { text: unit; fontSize: (lead ? 14 : 12) * k; color: lead ? foreground : muted; padding: [0, 0, 0, (lead ? 7 : 2) * k]; width: 3 * (lead ? 14 : 12) * k * 0.62 + 4 }
          }
          Text {
            text: r.line
            fontSize: (lead ? 20 : 14) * k
            bold: true
            color: lead ? foreground : muted
            padding: [narrow ? 2 : 4, 0, 0, (lead ? 5 : 1) * k]
            maxLines: 1
            width: narrow ? null : len(r.line) * (lead ? 20 : 14) * 0.62 + 6
            weight: narrow ? 1 : null
          }
          if !narrow {
            Text { text: r.to; style: small; color: muted; maxLines: 1; weight: 1; padding: [0, 0, 0, lead ? 7 : 2] }
          }
        }
      }
    }
  }

  Column {
    gap: 2
    fill: true
    if showName {
      Text { text: stopName == "" ? "DEPARTURES" : upper(stopName); style: label; color: muted; maxLines: 1 }
    }
    if stopId == "" {
      Text { text: "No stop"; fontSize: tall ? 28 : 20; bold: true; maxLines: 1 }
      Text { text: "Tap to pick one"; style: small; color: muted; maxLines: 1 }
    } else if board == null {
      Text { text: "…"; fontSize: 30; bold: true; color: muted }
    } else if problem != null {
      Text { text: problem; style: small; color: muted; maxLines: 2 }
    } else if len(upcoming) == 0 {
      Text { text: "No departures soon"; style: small; color: muted; maxLines: 2 }
    } else {
      for r, i in shown key r.key {
        Departure { r: r; now: now; nowMin: nowMin; mode: i == 0 ? "big" : "small" }
      }
    }
  }

  screen {
    title: stopName == "" ? "departures" : stopName
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      if stopId == "" {
        Column {
          gap: 0
          Text { text: "No stop yet"; fontSize: 48; bold: true; maxLines: 1 }
          Text { text: "Pick a stop to see its next departures, anywhere Transitous has open timetables."; fontSize: 16; color: muted; maxLines: 3 }
        }
        Text { text: "Pick a stop"; fontSize: 16; bold: true; align: center; fill: width; background: accent; color: background; radius: 24; padding: [24, 14]; onTap: picking = true }
      } else {
        if board == null {
          Text { text: "…"; fontSize: 48; bold: true; color: muted }
        } else if problem != null {
          Column {
            gap: 0
            Text { text: "Offline"; fontSize: 48; bold: true; maxLines: 1 }
            Text { text: problem == "too many requests" ? "Too many requests, trying again soon" : "Transitous can't be reached"; fontSize: 16; color: muted; maxLines: 2 }
          }
        } else if len(upcoming) == 0 {
          Column {
            gap: 0
            Text { text: "Nothing soon"; fontSize: 48; bold: true; maxLines: 1 }
            Text { text: "No departures from here in the next hours"; fontSize: 16; color: muted; maxLines: 2 }
          }
        } else {
          Departure { r: upcoming[0]; now: now; nowMin: nowMin; mode: "lead" }
        }
        if len(upcoming) > 1 {
          Text { text: "Next departures"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
          Column {
            gap: 0
            background: surface
            radius: 28
            clip: true
            for r, i in upcoming.drop(1) key r.key {
              Spacer { height: 1; fill: width; background: border; visible: i > 0 }
              Departure { r: r; now: now; nowMin: nowMin; mode: "list" }
            }
          }
        }
        Text { text: "Stop"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
        Column {
          gap: 0
          background: surface
          radius: 28
          clip: true
          Row {
            gap: 16
            align: center
            padding: [20, 14]
            onTap: picking = true
            Text { text: stopName; fontSize: 16; maxLines: 1; weight: 1 }
            Text { text: "Change"; fontSize: 16; color: accent; maxLines: 1 }
            Text { text: "›"; fontSize: 18; color: muted }
          }
          Spacer { height: 1; fill: width; background: border }
          Row {
            gap: 16
            align: center
            padding: [20, 14]
            onTap: refresh()
            Text { text: "Refresh"; fontSize: 16; maxLines: 1; weight: 1 }
            Text { text: "Every 30 s"; fontSize: 14; color: muted; maxLines: 1 }
          }
        }
        Text { text: "Data: Transitous, from open timetables. Delays show where the operator publishes live times."; fontSize: 13; color: muted; padding: [4, 8, 0, 0] }
      }

      // Finding a stop: type its name and send; tap one to pick it.
      if picking {
        Sheet {
          title: "Pick a stop"
          onDismiss: { picking = false; query = "" }
          Column {
            gap: 12
            padding: [0, 4, 0, 4]
            Input { placeholder: "Search for a stop"; focus: picking; onSubmit: { query = value; refresh() } }
            if len(trim(query)) >= 2 {
              if found == null {
                Text { text: "Searching…"; fontSize: 14; color: muted }
              } else if len(stops) == 0 {
                Text { text: found.ok ? "No stops called “${query}”" : "Transitous is offline"; fontSize: 14; color: muted }
              }
              for s in stops key s.id {
                Column {
                  gap: 0
                  padding: [0, 10]
                  onTap: { stopId = s.id; stopName = s.name; query = ""; picking = false; refresh() }
                  Text { text: s.name; fontSize: 16; maxLines: 1 }
                  Text { text: [s.area, s.modes].filter(x => x != "").join(" · "); fontSize: 14; color: muted; maxLines: 1 }
                }
              }
            }
            Row {
              gap: 8
              Spacer { weight: 1 }
              Text { text: "Cancel"; fontSize: 15; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 12]; onTap: { picking = false; query = "" } }
            }
          }
        }
      }
    }
  }
}
