widget "planes overhead" {
  meta { description: "Aircraft around you on a live radar, from the OpenSky Network, located by IP or a city you type, via wttr.in. Tap it for every flight's altitude, speed and distance"; version: "1.2"; license: "MIT"; category: "world"; owl: 9 }
  size: 3x3
  minSize: 2x2

  source now = clock every 1s
  state city = "" persist
  // The city, percent-encoded so "/", "?", "&" or "#" in it can't break the URL. Empty means located by IP.
  let q = city.replace("%", "%25").replace("+", "%2B").replace("/", "%2F").replace("?", "%3F").replace("#", "%23").replace("&", "%26").replace("'", "%27").replace(" ", "+")
  // Where you are. The same request as the today widget, so the two share it.
  source wx = http("https://wttr.in/${q}?format=j1") every 30m timeout 10s json
  let area = wx.nearest_area[0]
  let lat = num(area.latitude)
  let lon = num(area.longitude)
  let imperial = contains(["united states", "united states of america", "liberia", "myanmar", "burma"], lower(trim(area.country[0].value)))
  // 45 km, or 30 miles, in three rings.
  let km = imperial ? 48.28 : 45
  let range = imperial ? "30 mi" : "45 km"
  // A box a little larger than the radar (0.5° is 55 km); longitude degrees shrink toward the poles.
  let dLat = 0.5
  let dLon = 0.5 / max(cos(rad(lat)), 0.2)
  // Anonymous OpenSky allows 400 requests a day; this runs only while its page is on screen.
  source sky = http("https://opensky-network.org/api/states/all?lamin=${fixed(lat - dLat, 3)}&lomin=${fixed(lon - dLon, 3)}&lamax=${fixed(lat + dLat, 3)}&lomax=${fixed(lon + dLon, 3)}") every 2m timeout 15s json status
  // The first request goes out before the location is known; ask again once it is.
  when lat != null { refresh() }
  // And again when a new city moves it.
  on lat { refresh() }

  // OpenSky's state vectors: [icao24, callsign, country, time_position, last_contact, lon, lat,
  // baro_altitude, on_ground, velocity, true_track, vertical_rate, sensors, geo_altitude, ...].
  // Positions are carried forward along each plane's track, so the radar moves between requests.
  let planes = (sky.ok ? sky.out.states ?? [] : [])
    .filter(s => !s[8] && s[5] != null && s[6] != null)
    .map(s => {
      id: s[0],
      call: trim(s[1] ?? "") == "" ? upper(s[0]) : trim(s[1]),
      country: s[2],
      alt: s[7] ?? s[13] ?? 0,
      speed: s[9] ?? 0,
      track: s[10] ?? 0,
      climb: s[11] ?? 0,
      x: (s[5] - lon) * 111.32 * cos(rad(lat)) + sin(rad(s[10] ?? 0)) * (s[9] ?? 0) * clamp(now - s[3], 0, 180) / 1000,
      y: (s[6] - lat) * 110.57 + cos(rad(s[10] ?? 0)) * (s[9] ?? 0) * clamp(now - s[3], 0, 180) / 1000
    })
  let flights = planes.filter(p => p.x * p.x + p.y * p.y <= km * km).sortBy(p => p.x * p.x + p.y * p.y)
  let nearest = first(flights)
  let problem = wx == null ? "Locating…" : lat == null ? "Location unknown" : sky == null ? "Listening…" : sky.code == 429 ? "OpenSky's daily limit is used up" : !sky.ok ? "OpenSky is offline" : null

  let place = area.areaName[0].value ?? ""
  // Each flight's distance, in the units of where you are.
  let listed = flights.map(f => {id: f.id, call: f.call, country: f.country, alt: f.alt, speed: f.speed, track: f.track, climb: f.climb,
    dist: imperial ? "${round(sqrt(f.x * f.x + f.y * f.y) / 1.609)} mi" : "${round(sqrt(f.x * f.x + f.y * f.y))} km"})
  let nearLine = problem != null ? problem : len(listed) == 0 ? "Clear skies within ${range}" : "${listed[0].call} · ${listed[0].dist} away"

  // The city form: open, and what's typed in it.
  state editing = false
  state draft = ""

  onTap: screen()

  // Low planes are warm, cruising ones cool.
  component Plane(alt, track, s = 6) {
    Canvas {
      size: s * 2 + 4
      let c = s + 2
      rotate(track, c, c) {
        path([[c, c - s], [c + s * 0.7, c + s * 0.7], [c, c + s * 0.3], [c - s * 0.7, c + s * 0.7]], closed: true, fill: alt < 3000 ? orange : alt < 8000 ? yellow : cyan)
      }
    }
  }

  component Radar(list, labels = false) {
    Canvas {
      let cx = width / 2
      let cy = height / 2
      let r = min(width, height) / 2 - 2
      let s = r / km
      let p = max(r / 20, 3.5)
      circle(cx, cy, r, fill: alpha(surface, 0.4), stroke: border, width: 1)
      circle(cx, cy, r * 2 / 3, stroke: alpha(muted, 0.3), width: 1)
      circle(cx, cy, r / 3, stroke: alpha(muted, 0.3), width: 1)
      line(cx - r, cy, cx + r, cy, stroke: alpha(muted, 0.2), width: 1)
      line(cx, cy - r, cx, cy + r, stroke: alpha(muted, 0.2), width: 1)
      // The sweep, once every four seconds.
      rotate(time * 90 % 360, cx, cy) {
        arc(cx, cy, r, -45, 45, fill: alpha(accent, 0.12))
        line(cx, cy, cx, cy - r, stroke: alpha(accent, 0.7), width: 1.5)
      }
      if labels {
        text(imperial ? "10 mi" : "15 km", cx + 4, cy - r / 3 - 7, size: 10, color: muted)
        text(imperial ? "20 mi" : "30 km", cx + 4, cy - r * 2 / 3 - 7, size: 10, color: muted)
        text("N", cx, cy - r + 9, size: 10, align: center, color: muted)
      }
      for f in list {
        rotate(f.track, cx + f.x * s, cy - f.y * s) {
          let px = cx + f.x * s
          let py = cy - f.y * s
          path([[px, py - p], [px + p * 0.7, py + p * 0.7], [px, py + p * 0.3], [px - p * 0.7, py + p * 0.7]], closed: true, fill: f.alt < 3000 ? orange : f.alt < 8000 ? yellow : cyan)
        }
        if labels {
          text(f.call, cx + f.x * s + p + 3, cy - f.y * s, size: 10, color: foreground)
        }
      }
      circle(cx, cy, 3, fill: foreground)
    }
  }

  // The radar is the tile. Small, it's the radar alone; wide, the count and the nearest flight sit beside it.
  let small = (rows ?? 3) < 3 || (cols ?? 3) < 3
  let side = (cols ?? 3) >= 5

  Column {
    gap: 2
    fill: true
    if !small {
      Row {
        align: center
        Text { text: "PLANES"; style: label; color: muted; weight: 1; maxLines: 1 }
        Text { text: problem == null && !side ? "${len(flights)}" : ""; style: label; color: accent; maxLines: 1; visible: problem == null && !side }
      }
    }
    if side {
      Row {
        gap: 12
        weight: 1
        align: center
        Box {
          fill: height
          width: max((tileHeight ?? 160) - 40, 60)
          Radar { list: flights; labels: (rows ?? 3) >= 4; fill: true }
        }
        Column {
          gap: 2
          weight: 1
          Text { text: problem == null ? "${len(flights)}" : "…"; fontSize: 40; maxLines: 1 }
          Text { text: len(flights) == 1 ? "flight within ${range}" : "flights within ${range}"; style: small; color: muted; maxLines: 1 }
          Text { text: nearLine; style: small; maxLines: 2 }
        }
      }
    } else {
      Box {
        weight: 1
        fill: width
        Radar { list: flights; labels: (cols ?? 3) >= 4 && (rows ?? 3) >= 4; fill: true }
        if problem != null {
          Text { text: problem; style: small; color: muted; align: center; fill: width }
        }
      }
      if !small {
        Text { text: nearLine; style: small; color: problem == null ? foreground : muted; maxLines: 1 }
      }
    }
  }

  component RadarCard() {
    Column {
      background: surface
      radius: 28
      clip: true
      padding: 16
      Radar { list: flights; labels: true; height: min((screenWidth ?? 360) - 40, (screenHeight ?? 640) * 0.5); fill: width }
    }
  }

  component Flights() {
    Column {
      gap: 12
      Text { text: "Flights"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        for f, i in listed key f.id {
          Spacer { height: 1; fill: width; background: border; visible: i > 0 }
          Row {
            gap: 14
            align: center
            padding: [20, 14]
            onTap: url("https://globe.adsbexchange.com/?icao=${f.id}")
            Plane { alt: f.alt; track: f.track; s: 8 }
            Column {
              gap: 0
              weight: 1
              Text { text: f.call; fontSize: 16; bold: true; maxLines: 1 }
              Text { text: f.country; fontSize: 14; color: muted; maxLines: 1 }
            }
            Column {
              gap: 0
              width: 96
              Text { text: "${imperial ? "${round(f.alt * 3.281 / 100) * 100} ft" : "${round(f.alt / 10) * 10} m"} ${f.climb > 1 ? "↑" : f.climb < -1 ? "↓" : ""}"; fontSize: 14; align: end; maxLines: 1 }
              Text { text: imperial ? "${round(f.speed * 2.237)} mph" : "${round(f.speed * 3.6)} km/h"; fontSize: 14; color: muted; align: end; maxLines: 1 }
            }
            Text { text: f.dist; fontSize: 14; color: accent; width: 52; align: end; maxLines: 1 }
          }
        }
        if len(listed) == 0 { Text { text: problem ?? "Clear skies within ${range}."; fontSize: 16; color: muted; padding: [20, 16] } }
      }
    }
  }

  component Where() {
    Column {
      gap: 12
      Text { text: "Location"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        Row {
          gap: 16
          align: center
          padding: [20, 14]
          onTap: { draft = city; editing = true }
          Column {
            gap: 0
            weight: 1
            Text { text: city == "" ? "Where you are" : city; fontSize: 16; maxLines: 1 }
            Text { text: city == "" ? "Found by your IP address · ${place}" : "${place}, ${area.country[0].value ?? ""}"; fontSize: 14; color: muted; maxLines: 1 }
          }
          Text { text: "›"; fontSize: 18; color: muted }
        }
      }
      Row {
        gap: 8
        align: center
        Text { text: "Live map"; fontSize: 16; bold: true; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 12]; onTap: url("https://globe.adsbexchange.com/?lat=${lat}&lon=${lon}&zoom=9") }
        Text { text: "Data: the OpenSky Network"; style: small; color: muted; maxLines: 2; weight: 1 }
      }
    }
  }

  screen {
    title: "planes overhead"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      Column {
        gap: 0
        Text { text: problem == null ? "${len(flights)}" : "…"; fontSize: 48; bold: true; maxLines: 1 }
        Text { text: problem ?? "${len(flights) == 1 ? "flight" : "flights"} within ${range} of ${place}"; fontSize: 16; color: muted; maxLines: 2 }
      }
      if (screenWidth ?? 0) > 600 {
        Row {
          gap: 16
          Column { gap: 12; weight: 1
            RadarCard { }
            Where { }
          }
          Flights { weight: 1 }
        }
      } else {
        RadarCard { }
        Flights { }
        Where { }
      }

      // Where to look: a city typed in, or empty to go by the IP address.
      if editing {
        Sheet {
          title: "Location"
          onDismiss: editing = false
          Column {
            gap: 16
            padding: [0, 4, 0, 4]
            Input {
              text: draft
              placeholder: "City, or empty for where you are"
              focus: editing
              onChange: draft = value
              onSubmit: { city = trim(value); editing = false; refresh() }
            }
            Row {
              gap: 8
              align: center
              if city != "" {
                Text { text: "Clear"; fontSize: 15; color: red; padding: [8, 12]; onTap: { city = ""; editing = false; refresh() } }
              }
              Spacer { weight: 1 }
              Text { text: "Cancel"; fontSize: 15; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 12]; onTap: editing = false }
              Text { text: "Save"; fontSize: 15; bold: true; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 12]; onTap: { city = trim(draft); editing = false; refresh() } }
            }
          }
        }
      }
    }
  }
}
