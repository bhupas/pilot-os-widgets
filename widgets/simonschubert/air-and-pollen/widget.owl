widget "air and pollen" {
  meta { description: "Air quality and today's pollen where you are, from Open-Meteo (Copernicus), located by IP or a city you type, via wttr.in. Tap it for the next 24 hours, pollutants and every pollen type"; version: "1.2"; license: "MIT"; category: "world"; owl: 9 }
  size: 3x2
  minSize: 3x2

  source now = clock every 1m
  state city = "" persist
  // The city, percent-encoded so "/", "?", "&" or "#" in it can't break the URL. Empty means located by IP.
  let q = city.replace("%", "%25").replace("+", "%2B").replace("/", "%2F").replace("?", "%3F").replace("#", "%23").replace("&", "%26").replace("'", "%27").replace(" ", "+")
  // Where you are. The same request as the today widget, so the two share it.
  source wx = http("https://wttr.in/${q}?format=j1") every 30m timeout 10s json
  let area = wx.nearest_area[0]
  let lat = num(area.latitude)
  let lon = num(area.longitude)
  // The US index there, Europe's everywhere else.
  let us = contains(["united states", "united states of america"], lower(trim(area.country[0].value)))
  source air = http("https://air-quality-api.open-meteo.com/v1/air-quality?latitude=${lat}&longitude=${lon}&current=european_aqi,us_aqi,pm2_5,pm10,ozone,nitrogen_dioxide,uv_index&hourly=european_aqi,us_aqi,alder_pollen,birch_pollen,grass_pollen,mugwort_pollen,olive_pollen,ragweed_pollen&forecast_days=2&timezone=auto&timeformat=unixtime") every 30m timeout 15s json status
  // The first request goes out before the location is known; ask again once it is.
  when lat != null { refresh() }
  // And again when a new city moves it.
  on lat { refresh() }

  let cur = air.ok ? air.out.current : null
  let hourly = air.ok ? air.out.hourly : null
  let index = us ? "us_aqi" : "european_aqi"
  let aqi = get(cur, index)
  let steps = us ? [50, 100, 150, 200, 300] : [20, 40, 60, 80, 100]
  let names = us ? ["Good", "Moderate", "Unhealthy for some", "Unhealthy", "Very unhealthy", "Hazardous"] : ["Good", "Fair", "Moderate", "Poor", "Very poor", "Extremely poor"]
  let tints = us ? [green, yellow, orange, red, magenta, magenta] : [green, cyan, yellow, orange, red, magenta]
  let advice = ["Ideal for being outside", "Fine for your usual outdoor plans", "Sensitive people may want to take it easy outside", "Consider less intense activity outside", "Cut down on activity outside", "Avoid activity outside"]
  let level = aqi == null ? null : count(steps, s => aqi > s)
  let tint = level == null ? muted : tints[level]
  // The next 24 hours, from the current one on.
  let start = max(count(hourly.time ?? [], t => t <= now) - 1, 0)
  let hours = take(drop(hourly.time ?? [], start), 24)
  let aqis = take(drop(get(hourly, index) ?? [], start), 24)
  // Pollen in grains/m³, rated none, low, moderate or high. Europe only: elsewhere it's null.
  let kinds = [
    {key: "birch", t: [1, 15, 90]}, {key: "alder", t: [1, 15, 90]}, {key: "olive", t: [1, 15, 90]},
    {key: "grass", t: [1, 20, 50]}, {key: "mugwort", t: [1, 10, 50]}, {key: "ragweed", t: [1, 5, 20]}
  ]
  let pollen = kinds.map(k => {
    name: k.key,
    values: take(drop(get(hourly, k.key + "_pollen") ?? [], start), 24),
    peak: max(take(drop(get(hourly, k.key + "_pollen") ?? [], start), 24).filter(v => v != null)),
    t: k.t
  }).map(p => {name: p.name, values: p.values, peak: p.peak, level: p.peak == null ? 0 : count(p.t, x => p.peak >= x)})
  let hasPollen = any(pollen, p => p.peak != null)
  let flying = pollen.filter(p => p.level > 0).sortBy(p => -p.peak)
  let pollenWords = ["None", "Low", "Moderate", "High"]
  let pollenTints = [muted, green, yellow, red]
  let problem = wx == null || (lat != null && air == null) ? "…" : lat == null ? "Location unknown" : !air.ok ? "Open-Meteo is offline" : null

  let place = area.areaName[0].value ?? ""
  let country = area.country[0].value ?? ""
  let worst = len(flying) == 0 ? null : flying[0]

  // The city form: open, and what's typed in it.
  state editing = false
  state draft = ""

  onTap: screen()

  component Dots(n, c) {
    Row {
      gap: 2
      for i in range(3) { Box { width: 8; height: 4; radius: 2; background: i < n ? c : alpha(muted, 0.25) } }
    }
  }

  component Gauge(big = false) {
    Box {
      align: center
      Ring { value: aqi ?? 0; max: steps[4]; color: tint; track: alpha(muted, 0.2); thickness: big ? 10 : 6; start: 225; sweep: 270; fill: true; animate value: spring() }
      Column {
        gap: 0
        align: center
        Text { text: aqi == null ? "…" : round(aqi); fontSize: big ? 48 : 20; bold: true; color: tint; align: center; maxLines: 1 }
        Text { text: us ? "US AQI" : "EU AQI"; style: label; color: muted; align: center; maxLines: 1 }
      }
    }
  }

  component PollenRow(p, size = 13) {
    Row {
      gap: 8
      align: center
      Text { text: upper(sub(p.name, 0, 1)) + sub(p.name, 1, len(p.name)); fontSize: size; weight: 1; maxLines: 1 }
      Dots { n: p.level; c: pollenTints[p.level] }
      Text { text: pollenWords[p.level]; fontSize: size; color: pollenTints[p.level]; width: size * 5.5; align: end; maxLines: 1 }
    }
  }

  // The index big, its word beside it, then the worst pollen; from 3 rows, the pollen list.
  Column {
    gap: 2
    fill: true
    Row {
      align: center
      Text { text: "AIR"; style: label; color: muted; weight: 1; maxLines: 1 }
      Text { text: upper(place); style: label; color: muted; maxLines: 1; width: 96; align: end }
    }
    if problem != null {
      Text { text: problem; fontSize: problem == "…" ? 40 : 18; bold: problem != "…"; maxLines: 2 }
    } else {
      Row {
        gap: 10
        align: center
        Text { text: round(aqi); fontSize: 40; color: tint; maxLines: 1 }
        Column {
          gap: 0
          weight: 1
          Text { text: names[level]; style: small; bold: true; color: tint; maxLines: 1 }
          Text { text: us ? "US AQI" : "EU AQI"; style: small; color: muted; maxLines: 1 }
        }
      }
      if (rows ?? 2) < 3 {
        // Too short for the pollen list: the worst one, or the fine dust.
        Text {
          text: !hasPollen ? "PM2.5 ${round(cur.pm2_5)} µg/m³" : worst == null ? "No pollen" : "${upper(sub(worst.name, 0, 1))}${sub(worst.name, 1, len(worst.name))} pollen ${lower(pollenWords[worst.level])}"
          style: small; color: !hasPollen ? muted : worst == null ? green : pollenTints[worst.level]; maxLines: 1
        }
      } else {
        Text { text: "PM2.5 ${round(cur.pm2_5)} µg/m³ · UV ${round(cur.uv_index)}"; style: small; color: muted; maxLines: 1 }
        Spacer { height: 8 }
        Text { text: "POLLEN"; style: label; color: muted; maxLines: 1 }
        Column {
          gap: 3
          weight: 1
          if !hasPollen {
            Text { text: "No forecast here (Europe only)"; style: small; color: muted; maxLines: 2 }
          } else if len(flying) == 0 {
            Text { text: "None in the air"; style: small; color: green; maxLines: 1 }
          } else {
            for p in take(flying, (rows ?? 3) >= 4 ? 5 : 3) key p.name { PollenRow { p: p } }
          }
        }
      }
    }
  }

  component Item(label, value, tint = foreground) {
    Row {
      gap: 16
      align: center
      padding: [20, 14]
      Text { text: label; fontSize: 16; maxLines: 1 }
      Text { text: value; fontSize: 16; color: tint; align: end; weight: 1; maxLines: 1 }
    }
  }

  component Hours() {
    Column {
      gap: 12
      Text { text: "Next 24 hours"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        background: surface
        radius: 28
        clip: true
        padding: [16, 20]
        Canvas {
          height: 110
          fill: width
          let n = max(len(aqis), 1)
          let top = max(max(aqis.filter(v => v != null)) ?? 0, steps[2])
          let w = width / n
          // The category lines, faint, so a bar's height reads as good, fair, ...
          for s, i in take(steps, 4) {
            if s < top {
              line(0, 92 - s / top * 84, width, 92 - s / top * 84, stroke: alpha(tints[i + 1], 0.3), width: 1)
            }
          }
          for v, i in aqis {
            if v != null {
              rect(i * w + 1, 92 - v / top * 84, max(w - 2, 1), max(v / top * 84, 1), radius: 2, fill: tints[count(steps, s => v > s)])
            }
            if i % 6 == 0 {
              text(i == 0 ? "Now" : fmtTime(hours[i], "HH:mm"), i * w + w / 2, 104, size: 10, align: center, color: muted)
            }
          }
        }
      }
    }
  }

  component Pollutants() {
    Column {
      gap: 12
      Text { text: "Pollutants now"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        for p, i in [["PM2.5", cur.pm2_5, 25, " µg/m³"], ["PM10", cur.pm10, 50, " µg/m³"], ["Ozone", cur.ozone, 120, " µg/m³"], ["Nitrogen dioxide", cur.nitrogen_dioxide, 40, " µg/m³"], ["UV index", cur.uv_index, 6, ""]] {
          Spacer { height: 1; fill: width; background: border; visible: i > 0 }
          Item { label: p[0]; value: p[1] == null ? "…" : "${round(p[1], 1)}${p[3]}"; tint: p[1] > p[2] ? orange : foreground }
        }
      }
    }
  }

  component Pollen() {
    Column {
      gap: 12
      Text { text: "Pollen, next 24 hours"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        if !hasPollen {
          Text { text: "Open-Meteo only forecasts pollen in Europe."; fontSize: 16; color: muted; padding: [20, 16] }
        } else {
          for p, i in pollen.sortBy(p => -(p.peak ?? 0)) key p.name {
            Spacer { height: 1; fill: width; background: border; visible: i > 0 }
            Column {
              gap: 6
              padding: [20, 14]
              PollenRow { p: p; size: 16 }
              if p.level > 0 {
                Row {
                  gap: 8
                  align: center
                  Sparkline { values: p.values.map(v => v ?? 0); min: 0; max: max(p.peak ?? 0, 1); color: pollenTints[p.level]; area: true; height: 24; weight: 1 }
                  Text { text: p.peak == null ? "" : "Peak ${round(p.peak)}"; fontSize: 14; color: muted; maxLines: 1 }
                }
              }
            }
          }
        }
      }
    }
  }

  component Where() {
    Column {
      gap: 12
      Text { text: "Location"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        Row {
          gap: 16
          align: center
          padding: [20, 14]
          onTap: { draft = city; editing = true }
          Column {
            gap: 0
            weight: 1
            Text { text: city == "" ? "Where you are" : city; fontSize: 16; maxLines: 1 }
            Text { text: place == "" ? "Not found yet" : city == "" ? "Found by your IP address · ${place}" : "${place}, ${country}"; fontSize: 14; color: muted; maxLines: 1 }
          }
          Text { text: "›"; fontSize: 18; color: muted }
        }
      }
      Text { text: "Data: Copernicus Atmosphere Monitoring Service, via Open-Meteo"; style: small; color: muted; padding: [4, 8, 0, 0] }
    }
  }

  screen {
    title: "air and pollen"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      if problem != null {
        Column {
          gap: 0
          Text { text: problem == "…" ? "…" : "No reading"; fontSize: 48; bold: true; maxLines: 1 }
          Text { text: problem == "…" ? "Loading…" : problem; fontSize: 16; color: muted }
        }
        Where { }
      } else {
        Row {
          gap: 16
          align: center
          Gauge { big: true; size: 132 }
          Column {
            gap: 2
            weight: 1
            Text { text: names[level]; fontSize: 28; bold: true; color: tint; maxLines: 2 }
            Text { text: advice[level]; fontSize: 16; color: muted }
            Text { text: country == "" ? place : "${place}, ${country}"; fontSize: 14; color: muted; maxLines: 1 }
          }
        }
        if (screenWidth ?? 0) > 600 {
          Row {
            gap: 16
            Column { gap: 12; weight: 1
              Hours { }
              Pollutants { }
            }
            Column { gap: 12; weight: 1
              Pollen { }
              Where { }
            }
          }
        } else {
          Hours { }
          Pollutants { }
          Pollen { }
          Where { }
        }
      }

      // Where to look: a city typed in, or empty to go by the IP address.
      if editing {
        Sheet {
          title: "Location"
          onDismiss: editing = false
          Column {
            gap: 16
            padding: [0, 4, 0, 4]
            Input {
              text: draft
              placeholder: "City, or empty for where you are"
              focus: editing
              onChange: draft = value
              onSubmit: { city = trim(value); editing = false; refresh() }
            }
            Row {
              gap: 8
              align: center
              if city != "" {
                Text { text: "Clear"; fontSize: 15; color: red; padding: [8, 12]; onTap: { city = ""; editing = false; refresh() } }
              }
              Spacer { weight: 1 }
              Text { text: "Cancel"; fontSize: 15; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 12]; onTap: editing = false }
              Text { text: "Save"; fontSize: 15; bold: true; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 12]; onTap: { city = trim(draft); editing = false; refresh() } }
            }
          }
        }
      }
    }
  }
}
