widget "omarchy" {
  size: 4x3
  minSize: 3x3
  requires { pacman: [] }
  meta { description: "Latest commits on omacom/omarchy, branch quattro. Tap the tile for the full feed, then a commit to open it."; version: "1.1"; license: "MIT"; category: "dev"; owl: 8 }

  source now = clock every 1m
  // Public commits API. Android fetches it; no shell and no packages. Twenty commits stay well under the 1 MB cap.
  source raw = http("https://api.github.com/repos/omacom/omarchy/commits?sha=quattro&per_page=20", {Accept: "application/vnd.github+json"}) every 10m timeout 15s json status

  let commits = (raw != null && raw.ok ? raw.out ?? [] : []).map(c => {
    sha: c.sha,
    short: sub(c.sha ?? "", 0, 7),
    url: c.html_url,
    iso: c.commit.author.date ?? "",
    subject: first(split(c.commit.message ?? "", "\n")) ?? "",
    author: c.author.login ?? c.commit.author.name ?? "someone"
  })
  let problem = raw == null || raw.ok ? null : raw.code == 403 ? "Rate limited" : "GitHub offline"
  let wide = cols != null && cols >= 6
  // Under the label and the newest commit (about 85dp, plus 30 of tile padding), a one-line row is ~16dp. Count
  // from the tile height so the list fills it instead of stopping early and leaving the bottom blank.
  let more = tileHeight == null ? 3 : clamp(floor((tileHeight - 116) / 16), 1, 19)

  onTap: screen()

  // iso is UTC, "2026-10-08T18:37:26Z". Days-from-civil, then a short age.
  // mode: "lead" (the newest, big, on the tile), "row" (one line on the tile) or "full" (a row in the app's card).
  component Commit(c, now, mode = "row") {
    Column {
      gap: 0
      let iso = c.iso
      let y = floor(num(sub(iso, 0, 4)))
      let mo = floor(num(sub(iso, 5, 7)))
      let day = floor(num(sub(iso, 8, 10)))
      let hh = floor(num(sub(iso, 11, 13)))
      let mm = floor(num(sub(iso, 14, 16)))
      let ss = floor(num(sub(iso, 17, 19)))
      let yy = y - (mo <= 2 ? 1 : 0)
      let era = floor(yy / 400)
      let yoe = yy - era * 400
      let doy = floor((153 * (mo + (mo > 2 ? -3 : 9)) + 2) / 5) + day - 1
      let doe = yoe * 365 + floor(yoe / 4) - floor(yoe / 100) + doy
      let at = (era * 146097 + doe - 719468) * 86400 + hh * 3600 + mm * 60 + ss
      let age = now - at
      let ago = iso == "" || now == null ? "…" : age < 45 ? "now" : age < 3600 ? "${floor(age / 60)}m" : age < 86400 ? "${floor(age / 3600)}h" : age < 604800 ? "${floor(age / 86400)}d" : fmtTime(at, "MMM d")
      if mode == "full" {
        Row {
          gap: 16
          align: top
          padding: [20, 14]
          onTap: url(c.url)
          Column {
            gap: 2
            weight: 1
            Text { text: c.subject; fontSize: 16; maxLines: 3 }
            Text { text: "${c.author} · ${c.short}"; fontSize: 14; color: muted; maxLines: 1 }
          }
          Text { text: ago; fontSize: 14; color: muted; maxLines: 1 }
        }
      } else if mode == "lead" {
        Text { text: c.subject; fontSize: 18; bold: true; maxLines: 2 }
        Text { text: "${c.author} · ${ago}"; style: small; color: accent; maxLines: 1 }
      } else {
        Row {
          gap: 8
          align: center
          Text { text: c.subject; style: small; weight: 1; maxLines: 1 }
          Text { text: wide ? "${c.author} · ${ago}" : ago; style: small; color: muted; maxLines: 1 }
        }
      }
    }
  }

  // The tile: the newest commit big, then as many older ones as fit.
  Column {
    gap: 2
    fill: true
    Row {
      align: center
      Text { text: "OMARCHY"; style: label; color: muted; weight: 1; maxLines: 1 }
      Text { text: "QUATTRO"; style: label; color: accent; maxLines: 1 }
    }
    if raw == null {
      Text { text: "Loading…"; fontSize: 18; bold: true; color: muted; maxLines: 1 }
    } else if problem != null {
      Text { text: problem; fontSize: 18; bold: true; maxLines: 1 }
      Text { text: "Tap to try again"; style: small; color: muted; maxLines: 1 }
    } else if len(commits) > 0 {
      Commit { c: commits[0]; now: now; mode: "lead" }
      Spacer { height: 6 }
      for c in commits.drop(1).take(more) key c.sha {
        Commit { c: c; now: now }
      }
    }
  }

  // The app: how many commits and the newest one's age, then all of them in a card.
  let twoCols = (screenWidth ?? 0) > 600
  let half = ceil(len(commits) / 2)

  component Feed(list) {
    Column {
      gap: 0
      background: surface
      radius: 28
      clip: true
      for c, i in list key c.sha {
        Spacer { height: 1; fill: width; background: border; visible: i > 0 }
        Commit { c: c; now: now; mode: "full" }
      }
    }
  }

  screen {
    title: "omarchy"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      Column {
        gap: 0
        Text { text: raw == null ? "Loading…" : problem ?? "${len(commits)} commits"; fontSize: 48; bold: true; maxLines: 1 }
        Text { text: problem != null ? "Try again in a few minutes" : "The latest on omacom/omarchy, branch quattro"; fontSize: 16; color: muted; maxLines: 1 }
      }
      if len(commits) > 0 {
        Text { text: "Commits"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
        if twoCols {
          Row {
            gap: 12
            align: top
            Feed { list: commits.take(half); weight: 1 }
            Feed { list: commits.drop(half); weight: 1 }
          }
        } else {
          Feed { list: commits }
        }
      }
      Row {
        gap: 8
        Spacer { weight: 1 }
        Text { text: "Refresh"; fontSize: 15; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 12]; onTap: refresh() }
        Text { text: "Open on GitHub"; fontSize: 15; bold: true; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 12]; onTap: url("https://github.com/omacom/omarchy/commits/quattro") }
      }
    }
  }
}
