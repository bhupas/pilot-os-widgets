widget "home assistant" {
  meta { description: "Home Assistant entities with their states; tap a light or switch to toggle it. Set up in ~/.config/omarchy-proot/home-assistant"; version: "1.3"; license: "MIT"; owl: 8; category: "home" }
  size: 6x3
  minSize: 3x2

  requires { pacman: ["curl", "jq"] }

  // The config file holds the server URL on line 1, a long-lived access token on line 2
  // (Home Assistant: profile > security) and entity ids on the lines after.
  source ha = cmd("""
    f=~/.config/omarchy-proot/home-assistant
    mkdir -p "${f%/*}"
    [ -f "$f" ] || printf 'http://homeassistant.local:8123\nPASTE-A-LONG-LIVED-TOKEN\nsun.sun\n' > "$f"
    chmod 600 "$f"
    base=$(sed -n 1p "$f"); token=$(sed -n 2p "$f")
    tail -n +3 "$f" | grep . | while read -r id; do
      curl -fsm 8 -H "Authorization: Bearer $token" "$base/api/states/$id" ||
        jq -nc --arg id "$id" '{entity_id: $id, state: "unreachable", attributes: {}}'
      echo
    done | jq -sc '[.[] | {id: .entity_id, name: (.attributes.friendly_name // .entity_id), state, unit: (.attributes.unit_of_measurement // "")}]'
  """) every 1m json timeout 30s
  let unset = ha != null && len(ha) > 0 && ha.all(e => e.state == "unreachable")
  let all = ha ?? []
  let on = count(all, e => e.state == "on")

  onTap: screen()

  // The tile: how many are on, then the entities as chips when there's room; a tap on a light or switch toggles it.
  Column {
    gap: 2
    fill: true
    Row {
      align: center
      Text { text: "HOME"; style: label; color: muted; weight: 1; maxLines: 1 }
    }
    Text { text: ha == null ? "…" : unset ? "Offline" : "${on} on"; fontSize: 40; maxLines: 1; color: unset ? red : foreground }
    Text { text: ha == null ? "Loading" : unset ? "Tap to set the URL, token and entities" : "of ${len(all)} entities"; style: small; color: muted; maxLines: 1 }
    if (rows ?? 3) >= 3 && !unset {
      Spacer { height: 6 }
      Grid {
        columns: (cols ?? 6) >= 5 ? 3 : 2
        gap: 6
        for e in all.take(((cols ?? 6) >= 5 ? 3 : 2) * max((rows ?? 3) - 2, 1)) key e.id {
          let domain = split(e.id, ".")[0]
          let toggles = domain == "light" || domain == "switch" || domain == "fan" || domain == "input_boolean"
          Column {
            gap: 0
            padding: [10, 6]
            radius: 12 * corners
            background: e.state == "on" ? mix(surface, accent, 0.22) : alpha(surface, 0.6)
            onTap: run(!toggles ? "true" : "f=~/.config/omarchy-proot/home-assistant; curl -fsm 8 -X POST -H \"Authorization: Bearer $(sed -n 2p $f)\" -H 'Content-Type: application/json' -d ${sh('{"entity_id": "' + e.id + '"}')} \"$(sed -n 1p $f)/api/services/homeassistant/toggle\"")
            Text { text: e.name; style: label; color: muted; maxLines: 1 }
            Text { text: "${e.state} ${e.unit}"; style: small; bold: true; color: e.state == "on" ? accent : e.state == "unreachable" ? red : foreground; maxLines: 1 }
          }
        }
      }
    }
  }

  // The app: every entity in a card, lights and switches with a switch, and the setup below.
  let wide = (screenWidth ?? 0) > 600

  component Entities(list) {
    Column {
      gap: 0
      background: surface
      radius: 28
      clip: true
      for e, i in list key e.id {
        let domain = split(e.id, ".")[0]
        let toggles = domain == "light" || domain == "switch" || domain == "fan" || domain == "input_boolean"
        Spacer { height: 1; fill: width; background: border; visible: i > 0 }
        Row {
          gap: 16
          align: center
          padding: [20, 14]
          onTap: run(!toggles ? "true" : "f=~/.config/omarchy-proot/home-assistant; curl -fsm 8 -X POST -H \"Authorization: Bearer $(sed -n 2p $f)\" -H 'Content-Type: application/json' -d ${sh('{"entity_id": "' + e.id + '"}')} \"$(sed -n 1p $f)/api/services/homeassistant/toggle\"")
          Column {
            gap: 0
            weight: 1
            Text { text: e.name; fontSize: 16; maxLines: 1 }
            Text { text: e.id; fontSize: 14; color: muted; maxLines: 1 }
          }
          if toggles && (e.state == "on" || e.state == "off") {
            // A switch: on, an accent track and a big knob; off, an outline and a small one.
            Box {
              width: 52; height: 32; radius: 16; background: e.state == "on" ? accent : transparent; border: e.state == "on" ? 0 : 2; borderColor: muted
              Spacer { size: e.state == "on" ? 24 : 16; radius: e.state == "on" ? 12 : 8; background: e.state == "on" ? background : muted; offset: [e.state == "on" ? 24 : 8, e.state == "on" ? 4 : 8] }
            }
          } else {
            Text { text: "${e.state} ${e.unit}"; fontSize: 16; color: e.state == "unreachable" ? red : muted; maxLines: 1 }
          }
        }
      }
    }
  }

  screen {
    title: "home assistant"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      Column {
        gap: 0
        Text { text: ha == null ? "Loading…" : unset ? "Offline" : "${on} on"; fontSize: 48; bold: true; color: unset ? red : foreground; maxLines: 1 }
        Text { text: ha == null ? "Asking Home Assistant" : unset ? "Home Assistant can't be reached: check the URL, token and entities below" : "of ${len(all)} entities"; fontSize: 16; color: muted; maxLines: 2 }
      }
      if len(all) > 0 && !unset {
        Text { text: "Entities"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
        if wide {
          Row {
            gap: 12
            align: top
            Entities { list: all.take(ceil(len(all) / 2)); weight: 1 }
            Entities { list: all.drop(ceil(len(all) / 2)); weight: 1 }
          }
        } else {
          Entities { list: all }
        }
      }
      Text { text: "Setup"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        Row {
          gap: 16
          align: center
          padding: [20, 14]
          onTap: terminal('$EDITOR ~/.config/omarchy-proot/home-assistant', "home assistant")
          Column {
            gap: 0
            weight: 1
            Text { text: "Server, token and entities"; fontSize: 16; maxLines: 1 }
            Text { text: "The URL on line 1, a long-lived token on line 2, then one entity id a line"; fontSize: 14; color: muted; maxLines: 2 }
          }
          Text { text: "›"; fontSize: 18; color: muted }
        }
      }
      Row {
        gap: 8
        Spacer { weight: 1 }
        Text { text: "Refresh"; fontSize: 15; bold: true; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 12]; onTap: refresh() }
      }
    }
  }
}
