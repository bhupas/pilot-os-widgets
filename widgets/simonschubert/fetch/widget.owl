widget "fetch" {
  page: 1
  order: 2
  size: 3x3
  minSize: 3x2
  meta { description: "Your phone at a glance, fastfetch style, with or without Linux: CPU, memory, storage, battery and theme, plus Arch's packages once Linux is installed. Tap it for every detail"; version: "1.3"; license: "MIT"; category: "system"; owl: 8 }

  // The phone, from Android: works without Linux.
  source dev = android.device
  source sys = android.system every 5s
  source bat = android.battery
  // The Arch side, once Linux is installed. Base tools only, so it doesn't make the widget need Linux.
  // Where the launcher is itself Linux, android.system already has these facts, and this never runs.
  source lxCmd = cmd("""
    . /etc/os-release
    printf '{"os":"%s","pkgs":%s,"explicit":%s,"shell":"%s","upgraded":"%s"}' \
      "$PRETTY_NAME" "$(pacman -Qq | wc -l)" "$(pacman -Qqe | wc -l)" \
      "$(basename "$SHELL") $(bash --version | head -1 | awk '{print $4}' | cut -d'(' -f1)" \
      "$(grep -a 'starting full system upgrade' /var/log/pacman.log 2>/dev/null | tail -1 | cut -c2-11)"
  """) every 5m json optional

  let lx = sys.linux ?? lxCmd
  let host = lower(replace(dev.model ?? "phone", " ", "-"))
  let user = linux ? "root" : "user"
  let mem = sys.memory
  let disk = sys.storage
  let shown = sys.display
  let kernel = split(sys.kernel ?? "", "-")[0]
  let batColor = bat.level <= 15 ? red : bat.level <= 30 ? yellow : green
  let short = (rows ?? 3) < 3
  let wide = (screenWidth ?? 0) > 600

  // fastfetch's lines, for the tile: as many as fit.
  let lines = [
    {k: "os", v: linux ? lx.os : dev == null ? null : "Android ${dev.android}"},
    {k: "kernel", v: kernel},
    {k: "uptime", v: sys.uptime == null ? null : fmtDuration(sys.uptime)},
    {k: "packages", v: linux ? (lx.pkgs == null ? null : "${lx.pkgs} (pacman), ${sys.apps} (apps)") : "${sys.apps} (apps)"},
    {k: "cpu", v: sys.cpu == null ? null : "${sys.cpu.soc == "" ? sys.cpu.hardware : sys.cpu.soc} (${sys.cpu.cores})"},
    {k: "memory", v: mem == null ? null : "${fmtBytes(mem.used)} / ${fmtBytes(mem.total)} (${round(mem.used / mem.total * 100)}%)"},
    {k: "disk", v: disk == null ? null : "${fmtBytes(disk.used)} / ${fmtBytes(disk.total)} (${round(disk.used / disk.total * 100)}%)"},
    {k: "battery", v: bat == null ? null : "${bat.level}% · ${bat.status}"},
    {k: linux ? "shell" : "display", v: linux ? lx.shell : shown.width == null ? null : "${shown.width}x${shown.height} @ ${shown.hz}Hz"},
    {k: "theme", v: sys.theme ?? "default"}
  ]

  onTap: screen()

  // Arch's A with its rounded cut, or Android's head, in the accent color.
  component Logo(arch) {
    Canvas {
      if arch {
        path([[0.5, 0], [1, 1], [0.7, 0.84], [0.62, 0.62], [0.5, 0.56], [0.38, 0.62], [0.3, 0.84], [0, 1]].map(p => [p[0] * width, p[1] * height]), closed: true, fill: accent)
      } else {
        let r = width * 0.46
        let cy = height * 0.8
        line(width * 0.3, cy - r * 0.62, width * 0.18, cy - r * 1.05, stroke: accent, width: max(width / 20, 1.5), cap: round)
        line(width * 0.7, cy - r * 0.62, width * 0.82, cy - r * 1.05, stroke: accent, width: max(width / 20, 1.5), cap: round)
        arc(width / 2, cy, r, 270, 180, fill: accent)
        circle(width / 2 - r * 0.42, cy - r * 0.45, r * 0.09, fill: background)
        circle(width / 2 + r * 0.42, cy - r * 0.45, r * 0.09, fill: background)
      }
    }
  }

  component Palette(box) {
    Column {
      gap: 2
      for row in [[color0, color1, color2, color3, color4, color5, color6, color7], [color8, color9, color10, color11, color12, color13, color14, color15]] {
        Row {
          gap: 2
          for c in row { Box { width: box; height: box / 2; background: c } }
        }
      }
    }
  }

  component Item(label, value) {
    Row {
      gap: 16
      align: center
      padding: [20, 14]
      Text { text: label; fontSize: 16; maxLines: 1 }
      Text { text: value; fontSize: 16; color: muted; align: end; weight: 1; maxLines: 1 }
    }
  }

  component Meter(label, used, total, tint = accent) {
    Column {
      gap: 8
      padding: [20, 14]
      Row {
        gap: 16
        Text { text: label; fontSize: 16; maxLines: 1 }
        Text { text: total ? "${fmtBytes(used)} of ${fmtBytes(total)}" : null; fontSize: 16; color: muted; align: end; weight: 1; maxLines: 1 }
      }
      Progress { value: round(used / total * 100) ?? 0; color: tint; fill: width; height: 6 }
    }
  }

  component Heading(label) {
    Text { text: label; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
  }

  component Line() {
    Spacer { height: 1; fill: width; background: border }
  }

  // The tile: the logo and user@host, then fastfetch's lines as rows allow.
  Column {
    gap: 2
    fill: true
    if !short {
      Row {
        align: center
        Text { text: "FETCH"; style: label; color: muted; weight: 1; maxLines: 1 }
        Row {
          gap: 2
          for c in [red, green, yellow, blue, magenta, cyan] { Box { width: 8; height: 4; background: c } }
        }
      }
    }
    Row {
      gap: 10
      align: center
      Logo { arch: linux; size: 32 }
      Column {
        gap: 0
        weight: 1
        Text { text: "${user}@${host}"; fontSize: 15; font: mono; bold: true; color: accent; maxLines: 1 }
        Text { text: dev == null ? null : "${dev.maker} ${dev.model}"; style: small; color: muted; maxLines: 1 }
      }
    }
    Spacer { height: 4 }
    for l in lines.take(max((rows ?? 3) * 4 - 6, 2)) {
      Row {
        gap: 6
        Text { text: l.k; fontSize: 10; font: mono; color: accent; width: 50; maxLines: 1 }
        Text { text: l.v; fontSize: 10; font: mono; maxLines: 1; weight: 1 }
      }
    }
  }

  component Phone() {
    Column {
      gap: 12
      Heading { label: "Phone" }
      Column {
        gap: 0
        background: surface; radius: 28; clip: true
        Item { label: "Model"; value: dev == null ? null : "${dev.maker} ${dev.model}${sys.codename == null ? "" : " (${sys.codename})"}" }
        // Android's own facts: absent where the launcher is Linux.
        if dev.android != null {
          Line { }
          Item { label: "Android"; value: "${dev.android} (SDK ${dev.sdk})" }
        }
        if sys.patch != null {
          Line { }
          Item { label: "Security patch"; value: sys.patch }
        }
        Line { }
        Item { label: "Build"; value: sys.build }
        Line { }
        Item { label: "Kernel"; value: sys.kernel }
        Line { }
        Item { label: "Uptime"; value: sys.uptime == null ? null : fmtDuration(sys.uptime) }
        Line { }
        Item { label: "Locale"; value: sys.locale == null ? null : "${sys.locale} · ${sys.timezone}" }
      }
      Heading { label: "Hardware" }
      Column {
        gap: 0
        background: surface; radius: 28; clip: true
        Item { label: "CPU"; value: sys.cpu == null ? null : trim("${sys.cpu.maker} ${sys.cpu.soc == "" ? sys.cpu.hardware : sys.cpu.soc}") }
        Line { }
        Item { label: "Cores"; value: sys.cpu == null ? null : "${sys.cpu.cores} · ${sys.cpu.abi}${!sys.cpu.maxMhz ? "" : " · up to ${fixed(sys.cpu.maxMhz / 1000, 2)} GHz"}" }
        Line { }
        Item { label: "Display"; value: shown.width == null ? null : "${shown.width}x${shown.height} @ ${shown.hz}Hz${shown.dpi == null ? "" : " · ${shown.dpi} dpi"}" }
        Line { }
        Meter { label: "Memory"; used: mem.used; total: mem.total; tint: round(mem.used / mem.total * 100) > 85 ? red : accent }
        Line { }
        Meter { label: "Storage"; used: disk.used; total: disk.total; tint: round(disk.used / disk.total * 100) > 90 ? red : accent }
      }
    }
  }

  component Rest() {
    Column {
      gap: 12
      Heading { label: "Battery" }
      Column {
        gap: 0
        background: surface; radius: 28; clip: true
        Column {
          gap: 8
          padding: [20, 14]
          Row {
            gap: 16
            Text { text: "Level"; fontSize: 16; maxLines: 1 }
            Text { text: bat == null ? null : "${bat.level}% · ${bat.status}${bat.plugged == null ? "" : " (" + bat.plugged + ")"}"; fontSize: 16; color: muted; align: end; weight: 1; maxLines: 1 }
          }
          Progress { value: bat.level ?? 0; color: batColor; fill: width; height: 6 }
        }
        if bat.temp != null {
          Line { }
          Item { label: "Temperature"; value: "${fixed(bat.temp, 1)} °C" }
        }
        if bat.voltage != null {
          Line { }
          Item { label: "Voltage"; value: "${fixed(bat.voltage, 2)} V" }
        }
        Line { }
        Item { label: "Health"; value: bat.health ?? "unknown" }
        if bat.cycles != null {
          Line { }
          Item { label: "Cycles"; value: bat.cycles }
        }
        if bat.technology != null {
          Line { }
          Item { label: "Technology"; value: bat.technology }
        }
      }
      Heading { label: "Launcher" }
      Column {
        gap: 0
        background: surface; radius: 28; clip: true
        Item { label: "Version"; value: sys.launcher }
        Line { }
        Item { label: "Theme"; value: sys.theme ?? "default" }
        Line { }
        Item { label: "Apps"; value: sys.apps == null ? null : "${sys.apps} Android apps" }
      }
      Heading { label: "Linux" }
      if linux {
        Column {
          gap: 0
          background: surface; radius: 28; clip: true
          Item { label: "OS"; value: lx.os }
          Line { }
          Item { label: "Packages"; value: lx.pkgs == null ? null : "${lx.pkgs} (${lx.explicit} explicit)" }
          Line { }
          Item { label: "Shell"; value: lx.shell }
          Line { }
          Item { label: "Upgraded"; value: (lx.upgraded ?? "") == "" ? "never" : lx.upgraded }
        }
        Text { text: "Run fastfetch"; fontSize: 16; bold: true; align: center; fill: width; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [24, 14]; onTap: terminal("command -v fastfetch >/dev/null || pacman -S --needed --noconfirm fastfetch; fastfetch", "fastfetch") }
      } else {
        Text { text: "Not installed. Arch Linux ARM adds a terminal, agents and pacman to the launcher."; fontSize: 16; color: muted; background: surface; radius: 28; padding: [20, 16] }
        Text { text: "Install Linux"; fontSize: 16; bold: true; align: center; fill: width; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 14]; onTap: launcher("linux") }
      }
    }
  }

  screen {
    title: "fetch"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      Row {
        gap: 16
        align: center
        Column {
          gap: 0
          weight: 1
          Text { text: dev == null ? null : dev.model; fontSize: 48; bold: true; maxLines: 2 }
          Text { text: "${user}@${host} · Pilot OS ${sys.launcher ?? ""}"; fontSize: 16; color: muted; maxLines: 1 }
        }
        Logo { arch: linux; size: 56 }
      }
      Row {
        gap: 16
        align: center
        padding: [20, 16]
        background: surface; radius: 28
        Text { text: lower(sys.theme ?? "default"); fontSize: 16; weight: 1; maxLines: 1 }
        Palette { box: 16 }
      }
      if wide {
        Row {
          gap: 24
          Phone { weight: 1 }
          Rest { weight: 1 }
        }
      } else {
        Phone { }
        Rest { }
      }
    }
  }
}
