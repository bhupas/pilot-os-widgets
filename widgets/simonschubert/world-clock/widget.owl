widget "world clock" {
  meta { description: "A row of flip clocks with city nameplates. Tap it to add, rename, reorder or remove cities"; version: "1.5"; license: "MIT"; category: "time"; owl: 9 }
  size: 6x2
  minSize: 3x2
  requires { pacman: ["tzdata"] }

  // Each clock is {label, zone}, kept by the launcher. Version 1.1 kept them in a file; it's read once to carry them over.
  state clocks = null persist
  state query = ""
  state adding = false            // the sheet that adds a city is open
  state editing = -1              // the clock the edit sheet changes, by its place in clocks; -1 for none
  state nameDraft = ""            // its nameplate, as typed
  source legacy = file("~/.config/omarchy-proot/world-clock")
  let legacyRows = lines(legacy ?? "").filter(l => !startsWith(l, "#")).map(l => words(l)).filter(w => len(w) >= 2)
  when clocks == null && legacy != null {
    clocks = len(legacyRows) > 0
      ? legacyRows.map(w => {label: replace(w[0], "-", " "), zone: w[1]})
      : [{label: "New York", zone: "America/New_York"}, {label: "London", zone: "Europe/London"}, {label: "Tokyo", zone: "Asia/Tokyo"}]
  }

  // Zones only ever come from the tz database's own list, and are checked again before they reach the shell.
  let zones = (clocks ?? []).map(c => c.zone).filter(z => match(z, "^[A-Za-z0-9_+/-]+$") != null).unique()
  // Only UTC offsets come from the shell; the digits run off the clock source.
  source offsets = cmd("echo \"local $(date +%z)\"; for z in $(echo ${sh(join(zones, " "))}); do echo \"$z $(TZ=$z date +%z)\"; done") every 5m
  source now = clock every 5s
  // Every place to pick from: "zone<tab>city<tab>country".
  source places = cmd("""
    z=/usr/share/zoneinfo
    echo "UTC	UTC	Coordinated Universal Time"
    awk -F'\t' 'FNR == NR { if ($0 !~ /^#/) c[$1] = $2; next }
      /^#/ { next }
      { n = split($3, p, "/"); city = p[n]; gsub("_", " ", city); print $3 "\t" city "\t" c[$1] }' $z/iso3166.tab $z/zone.tab | sort -t '	' -k 2
  """) every 24h

  let off = lines(offsets).map(l => words(l)).map(w => {
    zone: w[0],
    secs: (sub(w[1], 0, 1) == "-" ? -1 : 1) * (num(sub(w[1], 1, 3)) * 3600 + num(sub(w[1], 3, 5)) * 60)
  })
  let here = off.find(o => o.zone == "local").secs ?? 0
  let shown = (clocks ?? []).map(c => {label: c.label, zone: c.zone, secs: off.find(o => o.zone == c.zone).secs}).filter(c => c.secs != null)
  // A tile taller than wide (the landscape home screen) stacks the clocks instead of lining them up.
  let tall = tileWidth != null && tileHeight != null && tileHeight > tileWidth * 1.3
  let days = ["thu", "fri", "sat", "sun", "mon", "tue", "wed"]
  let found = trim(query) == "" ? [] : lines(places).map(l => split(l, "\t"))
    .filter(p => contains(lower("${p[1]} ${p[2]} ${p[0]}"), lower(trim(query)))).take(30)

  onTap: screen()

  // A flip-clock face: hours and minutes on two split cards. Cards where it's night go dark,
  // so day and night read across the row at a glance.
  component FlipClock(t) {
    Canvas {
      let h = floor(t / 3600) % 24
      let m = floor(t / 60) % 60
      let night = h < 6 || h >= 18
      let gap = max(6, width * 0.06)
      let cw = min((width - gap) / 2, height * 1.1)
      let ch = min(height, cw * 1.05)
      let x0 = (width - cw * 2 - gap) / 2
      let y0 = (height - ch) / 2
      let size = min(ch * 0.62, cw * 0.62)
      for v, i in [h, m] {
        let x = x0 + i * (cw + gap)
        rect(x, y0, cw, ch, radius: 4, fill: night ? background : surface)
        rect(x, y0, cw, ch, radius: 4, stroke: border, width: 1)
        text(pad(v, 2, "0"), x + cw / 2, y0 + ch / 2, size: size, bold: true, align: center, color: night ? muted : foreground)
        line(x, y0 + ch / 2, x + cw, y0 + ch / 2, stroke: night ? border : background, width: max(1, ch * 0.025))
      }
      circle(width / 2, y0 + ch * 0.36, max(1.2, size * 0.05), fill: night ? muted : accent)
      circle(width / 2, y0 + ch * 0.64, max(1.2, size * 0.05), fill: night ? muted : accent)
    }
  }

  component Plate(name) {
    Text { text: upper(name); style: label; font: mono; bold: true; align: center; maxLines: 1; fill: width; padding: [6, 2]; background: surface; border: 1; borderColor: border }
  }

  component City(c) {
    let t = now + c.secs
    let diff = (c.secs - here) / 3600
    Column {
      weight: 1
      gap: 4
      align: center
      FlipClock { t: t; weight: 1; fill: width }
      Plate { name: c.label }
      Text { text: "${days[floor(t / 86400) % 7]} ${diff == 0 ? "local" : "${diff > 0 ? "+" : ""}${diff % 1 == 0 ? int(diff) : diff}h"}"; style: small; color: muted; align: center; fill: width; maxLines: 1 }
    }
  }

  if len(shown) == 0 {
    Text { text: clocks == null || len(clocks) > 0 ? "…" : "No clocks yet. Tap to add one"; style: muted; align: center; fill: true }
  } else if tall {
    Column {
      gap: 10
      for c, i in shown key "${i} ${c.zone}" {
        City { c: c }
      }
    }
  } else {
    Row {
      gap: 8
      for c, i in shown key "${i} ${c.zone}" {
        City { c: c }
      }
    }
  }

  let wide = (screenWidth ?? 0) > 600
  let n = len(clocks ?? [])

  component Lead() {
    Column {
      gap: 12
      Column {
        gap: 0
        Text { text: fmtTime(now, "HH:mm"); fontSize: 48; bold: true; maxLines: 1 }
        Text { text: "Here · ${fmtTime(now, "EEEE d MMMM")}"; fontSize: 16; color: muted; maxLines: 1 }
      }
      Text { text: "+ Add a city"; fontSize: 16; bold: true; maxLines: 1; align: center; fill: width; background: accent; color: background; radius: 24; padding: [24, 14]; onTap: { query = ""; adding = true } }
    }
  }

  // Every clock, as Google's clock lists them: the place, its day and offset, and its time. A tap opens it to rename,
  // move or remove.
  component Clocks() {
    Column {
      gap: 12
      Text { text: "Clocks"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        for c, i in clocks ?? [] key "${i} ${c.zone}" {
          let secs = off.find(o => o.zone == c.zone).secs
          let t = now + (secs ?? 0)
          let dd = floor(t / 86400) - floor((now + here) / 86400)
          let diff = ((secs ?? here) - here) / 3600
          Spacer { height: 1; fill: width; background: border; visible: i > 0 }
          Row {
            gap: 16
            align: center
            padding: [20, 14]
            onTap: { editing = i; nameDraft = c.label }
            Column {
              gap: 0
              weight: 1
              Text { text: c.label; fontSize: 16; maxLines: 1 }
              Text { text: (dd == 0 ? "Today" : dd > 0 ? "Tomorrow" : "Yesterday") + (diff == 0 ? " · same time" : " · ${diff > 0 ? "+" : ""}${diff % 1 == 0 ? int(diff) : diff}h"); fontSize: 14; color: muted; maxLines: 1 }
            }
            Text { text: secs == null ? "…" : "${pad(floor(t / 3600) % 24, 2, "0")}:${pad(floor(t / 60) % 60, 2, "0")}"; fontSize: 28; color: floor(t / 3600) % 24 < 6 || floor(t / 3600) % 24 >= 18 ? muted : foreground; width: 96; align: end; maxLines: 1 }
          }
        }
        if n == 0 {
          Text { text: "No clocks yet. Add a city to see its time."; fontSize: 16; color: muted; padding: [20, 16] }
        }
      }
    }
  }

  screen {
    title: "world clock"
    Column {
      gap: 12
      scroll: true
      padding: [0, 4, 0, 24]
      if wide {
        Row {
          gap: 24
          Lead { weight: 1 }
          Clocks { weight: 1 }
        }
      } else {
        Lead { }
        Clocks { }
      }

      // A clock: its nameplate, its place in the row, or gone.
      if editing >= 0 && editing < n {
        Sheet {
          title: clocks[editing].label
          onDismiss: editing = -1
          Column {
            gap: 16
            padding: [0, 4, 0, 4]
            Input {
              text: nameDraft
              placeholder: "Nameplate"
              onChange: nameDraft = value
              onSubmit: {
                if trim(value) != "" {
                  clocks = clocks.take(editing) + [{label: trim(value), zone: clocks[editing].zone}] + clocks.drop(editing + 1)
                }
                editing = -1
              }
            }
            Text { text: replace(clocks[editing].zone, "_", " "); fontSize: 14; color: muted }
            Row {
              gap: 8
              if editing > 0 {
                Text { text: "Move up"; fontSize: 15; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 12]; onTap: { clocks = clocks.take(editing - 1) + [clocks[editing], clocks[editing - 1]] + clocks.drop(editing + 1); editing = editing - 1 } }
              }
              if editing < n - 1 {
                Text { text: "Move down"; fontSize: 15; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 12]; onTap: { clocks = clocks.take(editing) + [clocks[editing + 1], clocks[editing]] + clocks.drop(editing + 2); editing = editing + 1 } }
              }
            }
            Row {
              gap: 8
              align: center
              Text { text: "Delete"; fontSize: 15; color: red; padding: [8, 12]; onTap: { clocks = clocks.take(editing) + clocks.drop(editing + 1); editing = -1 } }
              Spacer { weight: 1 }
              Text { text: "Cancel"; fontSize: 15; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 12]; onTap: editing = -1 }
              Text {
                text: "Save"; fontSize: 15; bold: true; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 12]
                onTap: {
                  if trim(nameDraft) != "" {
                    clocks = clocks.take(editing) + [{label: trim(nameDraft), zone: clocks[editing].zone}] + clocks.drop(editing + 1)
                  }
                  editing = -1
                }
              }
            }
          }
        }
      }

      // A new city, from the tz database's list of places.
      if adding {
        Sheet {
          title: "Add a city"
          onDismiss: { adding = false; query = "" }
          Column {
            gap: 4
            padding: [0, 4, 0, 4]
            Input { text: query; placeholder: "Search a city or country"; focus: adding; onChange: query = value }
            if trim(query) != "" && len(found) == 0 {
              Text { text: places == null ? "Loading places…" : "Nothing matches"; fontSize: 16; color: muted; padding: [0, 12] }
            }
            for p in found key p[0] {
              Row {
                gap: 12
                align: center
                padding: [0, 12]
                onTap: { clocks = (clocks ?? []) + [{label: p[1], zone: p[0]}]; query = ""; adding = false; refresh() }
                Text { text: p[1]; fontSize: 16; weight: 1; maxLines: 1 }
                Text { text: p[2]; fontSize: 14; color: muted; width: 140; align: end; maxLines: 1 }
              }
            }
          }
        }
      }
    }
  }
}
