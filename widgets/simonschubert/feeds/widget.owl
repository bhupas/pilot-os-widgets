widget "feeds" {
  meta { description: "The newest posts from the RSS and Atom feeds listed in ~/.config/omarchy-proot/feeds, starting with Arch Linux news"; version: "1.2"; license: "MIT"; category: "news"; owl: 8 }
  size: 6x4
  minSize: 4x3

  requires { pacman: ["python"] }

  // One feed URL per line. Fetched in parallel and merged, newest first; unreachable feeds are skipped.
  source items = cmd("""
    f=~/.config/omarchy-proot/feeds
    mkdir -p "${f%/*}"
    [ -f "$f" ] || printf 'https://archlinux.org/feeds/news/\nhttps://github.com/omacom/omarchy/releases.atom\n' > "$f"
    grep -v '^#' "$f" | grep . | python3 -c '
import sys, json, urllib.request, xml.etree.ElementTree as ET
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime
from email.utils import parsedate_to_datetime

A = "{http://www.w3.org/2005/Atom}"

def when(s):
    try:
        return int(parsedate_to_datetime(s).timestamp())
    except Exception:
        try:
            return int(datetime.fromisoformat(s.strip().replace("Z", "+00:00")).timestamp())
        except Exception:
            return 0

def text(e, *tags):
    for t in tags:
        x = e.find(t)
        if x is not None and x.text:
            return " ".join(x.text.split())
    return ""

def fetch(url):
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "omarchy-proot feeds widget"})
        root = ET.fromstring(urllib.request.urlopen(req, timeout=10).read())
    except Exception:
        return []
    out = []
    ch = root.find("channel")
    if ch is not None:
        feed = text(ch, "title")
        for i in ch.findall("item"):
            out.append({"title": text(i, "title"), "url": text(i, "link"), "at": when(text(i, "pubDate")), "feed": feed})
    else:
        feed = text(root, A + "title")
        for e in root.findall(A + "entry"):
            link = e.find(A + "link[@rel=\"alternate\"]")
            if link is None:
                link = e.find(A + "link")
            out.append({"title": text(e, A + "title"), "url": link.get("href") if link is not None else "", "at": when(text(e, A + "published", A + "updated")), "feed": feed})
    return out

urls = [l.strip() for l in sys.stdin if l.strip()]
with ThreadPoolExecutor(8) as pool:
    posts = [p for ps in pool.map(fetch, urls) for p in ps]
posts.sort(key=lambda p: -p["at"])
print(json.dumps(posts[:40]))
'
  """) every 30m json timeout 30s
  source now = clock every 60s
  // The feed the screen is narrowed to, by its title; empty shows them all.
  state only = ""

  let posts = items ?? []
  let feeds = unique(posts.map(p => p.feed).filter(f => f != ""))
  let today = count(posts, p => p.at > 0 && now - p.at < 86400)
  let top = first(posts)
  // How long ago, short: 5m, 3h, 2d.
  let dated = posts.map(p => {title: p.title, url: p.url, feed: p.feed, at: p.at,
    age: p.at == 0 ? "" : now - p.at < 3600 ? "${max(floor((now - p.at) / 60), 1)}m" : now - p.at < 86400 ? "${floor((now - p.at) / 3600)}h" : "${floor((now - p.at) / 86400)}d"})
  let ageOf = top == null ? "" : dated[0].age
  let shown = only == "" ? dated : dated.filter(p => p.feed == only)

  onTap: screen()

  // The newest post big, then as many more as fit: none at 3 rows, two per row after that.
  Column {
    gap: 2
    fill: true
    Row {
      align: center
      Text { text: "FEEDS"; style: label; color: muted; weight: 1; maxLines: 1 }
      Text { text: ageOf == "" ? "" : "${upper(ageOf)} AGO"; style: label; color: accent; maxLines: 1; visible: ageOf != "" }
    }
    if items == null {
      Text { text: "Loading…"; fontSize: 18; bold: true; maxLines: 1 }
    } else if len(posts) == 0 {
      Text { text: "Nothing loaded"; fontSize: 18; bold: true; maxLines: 1 }
      Text { text: "Tap to check the feed list"; style: small; color: muted; maxLines: 1 }
    } else {
      Text { text: top.title; fontSize: 18; bold: true; maxLines: 2 }
      Text { text: top.feed; style: small; color: muted; maxLines: 1 }
      Spacer { weight: 1 }
      for p in posts.drop(1).take(max((rows ?? 4) * 2 - 5, 0)) key p.url {
        Row {
          gap: 8
          Text { text: p.title; style: small; maxLines: 1; weight: 1 }
          Text { text: p.feed; style: small; color: muted; maxLines: 1; width: 96; align: end; visible: (cols ?? 6) >= 5 }
        }
      }
    }
  }

  component Latest() {
    Column {
      gap: 12
      // Narrow to one feed, as a row of chips; the picked one tonal.
      if len(feeds) > 1 {
        Flow {
          gap: 8
          for f in [""] + feeds {
            Text {
              text: f == "" ? "All" : f
              fontSize: 14; maxLines: 1; radius: 20; padding: [16, 8]
              background: only == f ? mix(surface, accent, 0.22) : transparent
              border: only == f ? 0 : 1; borderColor: border
              onTap: only = f
            }
          }
        }
      }
      Text { text: only == "" ? "Latest" : only; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0]; maxLines: 1 }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        for p, i in shown key p.url {
          Spacer { height: 1; fill: width; background: border; visible: i > 0 }
          Column {
            gap: 2
            padding: [20, 14]
            onTap: url(p.url)
            Text { text: p.title; fontSize: 16; maxLines: 3 }
            Row {
              gap: 8
              Text { text: p.feed; fontSize: 14; color: accent; maxLines: 1; weight: 1 }
              Text { text: p.age; fontSize: 14; color: muted; maxLines: 1 }
            }
          }
        }
        if len(shown) == 0 { Text { text: items == null ? "Loading…" : "Nothing loaded. Check the feed list below."; fontSize: 16; color: muted; padding: [20, 16] } }
      }
    }
  }

  component Settings() {
    Column {
      gap: 12
      Text { text: "Feeds"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        Row {
          gap: 16
          align: center
          padding: [20, 14]
          onTap: terminal('$EDITOR ~/.config/omarchy-proot/feeds', "feeds")
          Column {
            gap: 0
            weight: 1
            Text { text: "Edit the feed list"; fontSize: 16; maxLines: 1 }
            Text { text: "One RSS or Atom address per line, in ~/.config/omarchy-proot/feeds"; fontSize: 14; color: muted; maxLines: 2 }
          }
          Text { text: "›"; fontSize: 18; color: muted }
        }
        Spacer { height: 1; fill: width; background: border }
        Row {
          gap: 16
          align: center
          padding: [20, 14]
          onTap: refresh()
          Text { text: "Check for new posts"; fontSize: 16; maxLines: 1; weight: 1 }
          Text { text: "Every 30 min"; fontSize: 14; color: muted; maxLines: 1 }
        }
      }
    }
  }

  screen {
    title: "feeds"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      Column {
        gap: 0
        Text { text: items == null ? "…" : "${today} new"; fontSize: 48; bold: true; maxLines: 1 }
        Text { text: "in the last day, from ${len(feeds)} feed${len(feeds) == 1 ? "" : "s"}"; fontSize: 16; color: muted; maxLines: 1 }
      }
      if (screenWidth ?? 0) > 600 {
        Row {
          gap: 16
          Latest { weight: 2 }
          Settings { weight: 1 }
        }
      } else {
        Latest { }
        Settings { }
      }
    }
  }
}
