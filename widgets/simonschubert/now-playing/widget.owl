widget "now-playing" {
  size: 6x2
  minSize: 3x2
  requires { pacman: [] }
  meta { description: "What's playing on your phone, from any music or podcast app: album art, track, progress and play, pause and skip. Tap the tile for the full player"; version: "1.3"; license: "MIT"; category: "fun"; owl: 8 }

  // {available, playing, title, artist, album, app, package, position, duration, art}.
  // Android only shares other apps' sessions with notification access; without it, available is false.
  source m = android.media

  let has = m != null && m.title != null
  let allowed = m == null || m.available != false
  let dur = num(m.duration, 0)
  let pos = dur > 0 ? clamp(num(m.position, 0), 0, dur) : num(m.position, 0)
  let narrow = cols != null && cols < 5
  let art = clamp((tileHeight ?? 130) - 26, 40, 132)
  // A tile taller than wide (landscape home screen, or a tall portrait tile) stacks
  // art, text and controls vertically instead of side by side.
  let tall = tileWidth != null && tileHeight != null && tileHeight > tileWidth * 1.3
  let tallArt = tall ? clamp(min(tileWidth - 26, tileHeight * 0.45), 40, 240) : 0

  onTap: screen()

  component Clock(s) {
    Text { text: s == null ? "" : "${floor(s / 60)}:${pad(floor(s % 60), 2, "0")}"; style: label; color: muted; font: mono; maxLines: 1; width: len("${floor(s / 60)}") * 7 + 22 }
  }

  // Drawn, not glyphs: the launcher's icon font only carries weather symbols. Paths need an
  // explicit fill: to be filled. Play/pause is a solid disc with the glyph in the background color.
  component Control(kind, big = false, px = 0) {
    Box {
      size: px > 0 ? px : big ? 38 : 32
      onTap: media(kind)
      Canvas {
        let cx = width / 2
        let cy = height / 2
        let d = min(width, height)
        if kind == "toggle" {
          circle(cx, cy, d / 2, fill: foreground)
          if m.playing == true {
            rect(cx - d * 0.15, cy - d * 0.18, d * 0.11, d * 0.36, radius: d * 0.03, fill: background)
            rect(cx + d * 0.04, cy - d * 0.18, d * 0.11, d * 0.36, radius: d * 0.03, fill: background)
          } else {
            // The triangle's centroid sits right of its box: nudge it so it looks centered.
            path([[cx - d * 0.12, cy - d * 0.2], [cx + d * 0.21, cy], [cx - d * 0.12, cy + d * 0.2]], closed: true, fill: background)
          }
        } else {
          let dir = kind == "next" ? 1 : -1
          path([[cx - d * 0.19 * dir, cy - d * 0.2], [cx + d * 0.1 * dir, cy], [cx - d * 0.19 * dir, cy + d * 0.2]], closed: true, fill: foreground)
          rect(dir > 0 ? cx + d * 0.1 : cx - d * 0.18, cy - d * 0.2, d * 0.08, d * 0.4, radius: d * 0.03, fill: foreground)
        }
      }
    }
  }

  // A small equalizer that only exists (and only animates) while something plays.
  component Bars() {
    Canvas {
      width: 14
      height: 12
      for i in range(3) {
        let h = 3 + (sin(time * (5 + i * 1.7) + i * 2) * 0.5 + 0.5) * (height - 3)
        rect(i * 5, height - h, 3, h, radius: 1, color: accent)
      }
    }
  }

  component Art(src, d) {
    Box {
      size: d
      // Rounded as much as the launcher's corner style: square on edge, 8dp on round.
      radius: 8 * corners
      clip: true
      align: center
      if src != null {
        Image { src: src; fit: cover; fill: true }
      } else {
        // Gradients only fill inside a Canvas, not as a background.
        Canvas {
          rect(0, 0, width, height, fill: linear(0, 0, width, height, [alpha(accent, 0.55), alpha(magenta, 0.35)]))
          text("♪", width / 2, height / 2, size: d * 0.45, align: center, color: alpha(foreground, 0.85))
        }
      }
    }
  }

  // The source app, with a live equalizer while it plays.
  component AppLine() {
    Row {
      align: center
      gap: 6
      if m.playing == true {
        Bars { }
      }
      Text { text: upper(m.app ?? "now playing"); style: label; color: m.playing == true ? accent : muted; maxLines: 1; weight: 1 }
    }
  }

  if !allowed {
    Column {
      gap: 2
      fill: true
      Text { text: "NOW PLAYING"; style: label; color: muted; maxLines: 1 }
      Text { text: "Allow access"; fontSize: 18; bold: true; maxLines: 1 }
      Text { text: "Tap to let the launcher see what's playing"; style: small; color: muted; maxLines: 2 }
    }
  } else {
    if !has {
      if tall {
        Column {
          gap: 10
          Art { src: null; d: tallArt }
          Text { text: "NOW PLAYING"; style: label; color: muted; maxLines: 1 }
          Text { text: "Nothing playing"; fontSize: 18; bold: true; maxLines: 1 }
          Text { text: "Start music in any app"; style: small; color: muted; maxLines: 2 }
        }
      } else {
        Row {
          align: center
          gap: 12
          Art { src: null; d: art }
          Column {
            weight: 1
            gap: 2
            Text { text: "NOW PLAYING"; style: label; color: muted; maxLines: 1 }
            Text { text: "Nothing playing"; fontSize: 18; bold: true; maxLines: 1 }
            Text { text: "Start music in any app"; style: small; color: muted; maxLines: 1 }
          }
        }
      }
    } else {
      if tall {
        Column {
          gap: 8
          Art { src: m.art; d: tallArt }
          Column {
            gap: 2
            AppLine { }
            Text { text: m.title; style: body; bold: true; maxLines: 3 }
            Text { text: m.artist ?? ""; style: small; color: muted; maxLines: 2 }
            Text { text: m.album ?? ""; style: small; color: muted; maxLines: 1 }
          }
          Spacer { weight: 1 }
          if dur > 0 {
            Progress { value: pos; max: dur; color: accent; track: alpha(muted, 0.2); animate value: tween(900ms, "linear") }
            Row {
              align: center
              gap: 4
              Clock { s: pos }
              Spacer { weight: 1 }
              Clock { s: dur }
            }
          }
          Row {
            align: center
            gap: 4
            Spacer { weight: 1 }
            Control { kind: "previous" }
            Control { kind: "toggle"; big: true }
            Control { kind: "next" }
            Spacer { weight: 1 }
          }
        }
      } else {
        Row {
          align: center
          gap: 12
          if !narrow {
            Art { src: m.art; d: art }
          }
          Column {
            weight: 1
            gap: 2
            AppLine { }
            Text { text: m.title; style: body; bold: true; maxLines: narrow ? 2 : 1 }
            Text { text: [m.artist, narrow ? null : m.album].filter(x => x != null).join(" · "); style: small; color: muted; maxLines: 1 }
            Spacer { weight: 1 }
            if dur > 0 {
              Progress { value: pos; max: dur; color: accent; track: alpha(muted, 0.2); animate value: tween(900ms, "linear") }
            }
            Row {
              align: center
              gap: 4
              if dur > 0 {
                Clock { s: pos }
                Text { text: "/"; style: label; color: alpha(muted, 0.5); maxLines: 1 }
                Clock { s: dur }
              }
              Spacer { weight: 1 }
              Control { kind: "previous" }
              Control { kind: "toggle"; big: true }
              Control { kind: "next" }
            }
          }
        }
      }
    }
  }

  // The app: the cover big, the track, its progress and the controls, then where it plays.
  let wide = (screenWidth ?? 0) > 600
  let cover = clamp(wide ? min((screenWidth ?? 700) / 2 - 40, (screenHeight ?? 600) - 140) : (screenWidth ?? 360) - 48, 160, 420)

  component Item(label, value) {
    Row {
      gap: 16
      align: center
      padding: [20, 14]
      Text { text: label; fontSize: 16; maxLines: 1 }
      Text { text: value; fontSize: 16; color: muted; align: end; weight: 1; maxLines: 1 }
    }
  }

  component Player() {
    Column {
      gap: 12
      Column {
        gap: 0
        Text { text: has ? m.title : "Nothing playing"; fontSize: 28; bold: true; maxLines: 2 }
        Text { text: has ? m.artist ?? m.app ?? "" : "Start music or a podcast in any app"; fontSize: 16; color: muted; maxLines: 1 }
      }
      if has && dur > 0 {
        Column {
          gap: 4
          Progress { value: pos; max: dur; color: accent; track: alpha(muted, 0.2); fill: width; animate value: tween(900ms, "linear") }
          Row {
            align: center
            Clock { s: pos }
            Spacer { weight: 1 }
            Clock { s: dur }
          }
        }
      }
      Row {
        align: center
        gap: 24
        Spacer { weight: 1 }
        Control { kind: "previous"; px: 48 }
        Control { kind: "toggle"; px: 72 }
        Control { kind: "next"; px: 48 }
        Spacer { weight: 1 }
      }
      if has {
        Text { text: "Playing in"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
        Column {
          gap: 0
          background: surface
          radius: 28
          clip: true
          Item { label: "App"; value: m.app ?? "" }
          if m.album != null {
            Spacer { height: 1; fill: width; background: border }
            Item { label: "Album"; value: m.album }
          }
        }
        Row {
          gap: 8
          Spacer { weight: 1 }
          Text { text: "Open ${m.app ?? "the app"}"; fontSize: 15; bold: true; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 12]; onTap: media("open") }
        }
      }
    }
  }

  screen {
    title: "now playing"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      if !allowed {
        Column {
          gap: 0
          Text { text: "No access"; fontSize: 48; bold: true; maxLines: 1 }
          Text { text: "Allow notification access so the launcher can see what's playing and control it."; fontSize: 16; color: muted }
        }
        Row {
          gap: 8
          Spacer { weight: 1 }
          Text { text: "Allow access"; fontSize: 15; bold: true; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 12]; onTap: media("open") }
        }
      } else if wide {
        Row {
          gap: 24
          align: top
          Art { src: has ? m.art : null; d: cover }
          Player { weight: 1 }
        }
      } else {
        Box { fill: width; align: center; Art { src: has ? m.art : null; d: cover } }
        Player { }
      }
    }
  }
}
