widget "focus" {
  meta { owl: 8; description: "A pomodoro focus timer: start, stop and adjust in 5 minute steps"; version: "1.3"; license: "MIT"; category: "productivity" }
  size: 3x3
  minSize: 3x2

  // No shell at all: state, a clock and buttons make a pomodoro timer.
  source now = clock every 1s
  state endsAt = 0
  state length = 25 * 60
  let left = endsAt > now ? endsAt - now : 0
  let running = left > 0
  let shown = running ? "${pad(floor(left / 60), 2, "0")}:${pad(left % 60, 2, "0")}" : "${length / 60}:00"
  let detail = running ? "Ends at ${fmtTime(endsAt, "HH:mm")}" : "${length / 60} minutes"
  let short = (rows ?? 3) < 3
  let wide = (screenWidth ?? 0) > 600

  onTap: screen()

  Column {
    gap: 2
    fill: true
    if !short {
      Text { text: "FOCUS"; style: label; color: muted; maxLines: 1 }
    }
    Text { text: shown; fontSize: 40; color: running ? accent : foreground; maxLines: 1 }
    if !short {
      Text { text: detail; style: small; color: muted; maxLines: 1 }
    }
    Spacer { weight: 1 }
    Progress { value: running ? left : length; max: length; color: running ? accent : muted; fill: width; visible: !short; animate value: tween(900ms, "linear") }
    Button { text: running ? "Stop" : "Start"; fill: width; onTap: endsAt = running ? 0 : now + length }
  }

  // The time left inside a ring that empties, as Google's clock shows a timer.
  component Dial() {
    Box {
      fill: width
      align: center
      padding: [0, 8, 0, 8]
      Ring {
        size: clamp((screenWidth ?? 360) - 112, 200, 300); thickness: 12
        value: running ? left / length : 1
        color: running ? accent : muted
        track: mix(surface, accent, 0.22)
        animate value: tween(900ms, "linear")
      }
      Column {
        gap: 0
        align: center
        Text { text: shown; fontSize: 48; bold: true; align: center; maxLines: 1 }
        Text { text: running ? detail : "Ready"; fontSize: 16; color: muted; align: center; maxLines: 1 }
      }
    }
  }

  component Controls() {
    Column {
      gap: 12
      Text { text: "Length"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        Row {
          gap: 8
          align: center
          padding: [20, 14]
          Text { text: "${length / 60} minutes"; fontSize: 16; weight: 1; maxLines: 1 }
          Text { text: "−5"; fontSize: 16; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [18, 10]; onTap: length = max(length - 300, 300) }
          Text { text: "+5"; fontSize: 16; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [18, 10]; onTap: length = min(length + 300, 3600) }
        }
      }
      Text {
        text: running ? "Stop" : "Start"; fontSize: 16; bold: true; align: center; fill: width; maxLines: 1
        background: running ? mix(surface, accent, 0.22) : accent; color: running ? foreground : background; radius: 24; padding: [24, 14]
        onTap: endsAt = running ? 0 : now + length
      }
    }
  }

  screen {
    title: "focus"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      if wide {
        Row {
          gap: 24
          align: center
          Dial { weight: 1 }
          Controls { weight: 1 }
        }
      } else {
        Dial { }
        Controls { }
      }
    }
  }
}
