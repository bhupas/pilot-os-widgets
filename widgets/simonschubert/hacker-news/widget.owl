widget "hacker news" {
  meta { owl: 8; description: "The Hacker News front page with points and comments; tap a story to read it"; version: "1.2"; license: "MIT"; category: "news" }
  size: 6x4
  minSize: 4x3

  requires { pacman: ["curl", "jq"] }

  source hn = cmd("""
    curl -fsm 10 'https://hn.algolia.com/api/v1/search?tags=front_page&hitsPerPage=15' | jq -c '[.hits[] | {
      id: .objectID, title, points, comments: (.num_comments // 0),
      url: (.url // "https://news.ycombinator.com/item?id=\(.objectID)"),
      site: ((.url // "") | sub("^https?://(www\\.)?"; "") | split("/")[0])
    }]'
  """) every 15m json timeout 15s

  let stories = hn ?? []
  let topStory = stories[0]
  let wide = (screenWidth ?? 0) > 600

  onTap: screen()

  // The top story big, then as many more as fit: three at 3 rows, four more per row after that.
  Column {
    gap: 2
    fill: true
    Text { text: "HACKER NEWS"; style: label; color: muted; maxLines: 1 }
    if topStory == null {
      Text { text: "…"; fontSize: 40; maxLines: 1 }
    } else {
      Column {
        gap: 2
        onTap: url(topStory.url)
        Text { text: topStory.title; fontSize: 18; bold: true; maxLines: 2 }
        Text { text: "${topStory.points} points · ${topStory.comments} comments${topStory.site != "" ? " · " + topStory.site : ""}"; style: small; color: muted; maxLines: 1 }
      }
      Spacer { weight: 1 }
      for s in stories.drop(1).take(max((rows ?? 3) * 4 - 9, 1)) key s.id {
        Row {
          align: center
          onTap: url(s.url)
          Text { text: s.title; style: small; weight: 1; maxLines: 1 }
          Text { text: "${s.points}"; style: small; color: muted; width: 40; align: end; maxLines: 1 }
        }
      }
    }
  }

  component Lead() {
    Column {
      gap: 12
      Column {
        gap: 4
        onTap: url(topStory.url)
        Text { text: topStory == null ? "…" : topStory.title; fontSize: 28; bold: true; maxLines: 4 }
        Text { text: topStory == null ? "Loading the front page" : "${topStory.points} points · ${topStory.comments} comments${topStory.site != "" ? " · " + topStory.site : ""}"; fontSize: 16; color: muted; maxLines: 2 }
      }
      Row {
        gap: 8
        visible: topStory != null
        Text { text: "Read"; fontSize: 15; bold: true; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 12]; onTap: url(topStory.url) }
        Text { text: "Comments"; fontSize: 15; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 12]; onTap: url("https://news.ycombinator.com/item?id=${topStory.id}") }
      }
    }
  }

  component FrontPage() {
    Column {
      gap: 12
      Text { text: "Front page"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        for s, i in stories.drop(1) key s.id {
          Spacer { height: 1; fill: width; background: border; visible: i > 0 }
          Row {
            gap: 12
            align: center
            padding: [20, 14]
            onTap: url(s.url)
            Text { text: "${i + 2}"; fontSize: 14; color: muted; width: 24; maxLines: 1 }
            Column {
              gap: 2
              weight: 1
              Text { text: s.title; fontSize: 16; maxLines: 2 }
              Text { text: "${s.points} points${s.site != "" ? " · " + s.site : ""}"; fontSize: 14; color: muted; maxLines: 1 }
            }
            Text { text: "${s.comments}"; fontSize: 14; maxLines: 1; background: mix(surface, accent, 0.22); radius: 16; padding: [12, 6]; onTap: url("https://news.ycombinator.com/item?id=${s.id}") }
          }
        }
        if len(stories) < 2 {
          Text { text: hn == null ? "Loading…" : "No stories."; fontSize: 16; color: muted; padding: [20, 16] }
        }
      }
      Text { text: "Open Hacker News"; fontSize: 16; bold: true; align: center; fill: width; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [24, 14]; onTap: url("https://news.ycombinator.com") }
    }
  }

  screen {
    title: "hacker news"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      if wide {
        Row {
          gap: 24
          align: top
          Lead { weight: 1 }
          FrontPage { weight: 1 }
        }
      } else {
        Lead { }
        FrontPage { }
      }
    }
  }
}
