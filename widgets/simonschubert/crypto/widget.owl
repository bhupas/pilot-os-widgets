widget "bitcoin" {
  meta { description: "Bitcoin from CoinGecko: price, change over 1 hour, 24 hours and 7 days, the day's range and a 7-day chart. Tap it for market cap, volume, supply and the all-time high"; version: "2.1"; license: "MIT"; category: "world"; owl: 8 }
  size: 3x3
  minSize: 3x2

  source market = http("https://api.coingecko.com/api/v3/coins/markets?vs_currency=usd&ids=bitcoin&sparkline=true&price_change_percentage=1h,24h,7d") every 5m timeout 15s json status

  let b = market.ok ? market.out[0] : null
  let week = b.sparkline_in_7d.price ?? []
  let hour = b.price_change_percentage_1h_in_currency
  let day = b.price_change_percentage_24h_in_currency
  let days7 = b.price_change_percentage_7d_in_currency
  // CoinGecko updates the day's low and high less often than the price, so the price can be outside them.
  let low = min(b.low_24h, b.current_price)
  let high = max(b.high_24h, b.current_price)
  let problem = market == null ? "…" : market.code == 429 ? "CoinGecko is busy, retrying" : b == null ? "CoinGecko is offline" : null

  // Whole dollars with thousands separators: $82,612.
  let usd = [b.current_price, low, high, min(week), max(week), b.ath].map(n => n == null ? "…" : [round(n)].map(r =>
    r >= 1000000 ? "$${floor(r / 1000000)},${pad(floor(r / 1000) % 1000, 3, "0")},${pad(r % 1000, 3, "0")}" :
    r >= 1000 ? "$${floor(r / 1000)},${pad(r % 1000, 3, "0")}" : "$${r}")[0])
  let price = usd[0]
  // Trillions and billions: $1.66T, $33.5B.
  let cap = [b.market_cap, b.total_volume].map(n => n == null ? "…" : n >= 1000000000000 ? "$${fixed(n / 1000000000000, 2)}T" : "$${fixed(n / 1000000000, 1)}B")
  let at = high > low ? (b.current_price - low) / (high - low) : 0.5
  // "+1.2%", as each change reads.
  let pcts = [hour, day, days7, b.market_cap_change_percentage_24h].map(p => p == null ? "…" : "${p >= 0 ? "+" : ""}${fixed(p, 1)}%")
  let wide = (screenWidth ?? 0) > 600

  onTap: screen()

  component Pct(p, size = 12, right = false) {
    Text { text: p == null ? "…" : "${p >= 0 ? "+" : ""}${fixed(p, 1)}%"; fontSize: size; bold: true; color: p == null ? muted : p >= 0 ? green : red; align: right ? "end" : "start"; maxLines: 1 }
  }

  // Where the price sits between the day's low and high.
  component Range(size = 10) {
    Column {
      gap: 2
      Canvas {
        height: 8
        fill: width
        rect(0, 2.5, width, 3, radius: 1.5, fill: alpha(muted, 0.3))
        rect(0, 2.5, width * at, 3, radius: 1.5, fill: alpha(accent, 0.6))
        circle(width * at, 4, 4, fill: accent)
      }
      Row {
        Text { text: usd[1]; fontSize: size; color: muted; weight: 1; maxLines: 1 }
        Text { text: "24h"; fontSize: size; color: muted; width: 40; align: center; maxLines: 1 }
        Text { text: usd[2]; fontSize: size; color: muted; weight: 1; align: end; maxLines: 1 }
      }
    }
  }

  component Item(label, value, note = "", tint = muted) {
    Row {
      gap: 16
      align: center
      padding: [20, 14]
      Column {
        gap: 0
        weight: 1
        Text { text: label; fontSize: 16; maxLines: 1 }
        Text { text: note; fontSize: 14; color: tint; maxLines: 1; visible: note != "" }
      }
      Text { text: value; fontSize: 16; bold: true; maxLines: 1 }
    }
  }

  // The tile: the price big, the day's change by the label, then the week's chart and the day's range as rows allow.
  Column {
    gap: 2
    fill: true
    Row {
      align: center
      Text { text: "BITCOIN"; style: label; color: muted; weight: 1; maxLines: 1 }
      Pct { p: day; right: true; width: 64 }
    }
    if problem != null {
      Text { text: "…"; fontSize: 40; maxLines: 1 }
      Text { text: problem; style: small; color: muted; maxLines: 2 }
    } else {
      Text { text: price; fontSize: (cols ?? 3) >= 4 ? 40 : 32; maxLines: 1 }
      Text { text: "7 days ${pcts[2]} · 1 hour ${pcts[0]}"; style: small; color: muted; maxLines: 1 }
      if (rows ?? 3) >= 3 {
        Sparkline { values: week; min: min(week); max: max(week); color: days7 >= 0 ? green : red; area: true; fill: width; weight: 1 }
      }
      if (rows ?? 3) >= 4 {
        Range { }
      }
    }
  }

  component Lead() {
    Column {
      gap: 12
      Column {
        gap: 0
        Text { text: price; fontSize: 48; bold: true; maxLines: 1 }
        Text { text: "${pcts[1]} today · updated ${sub(b.last_updated, 11, 16)} UTC"; fontSize: 16; color: day >= 0 ? green : red; maxLines: 1 }
      }
      Text { text: "Last 7 days"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        background: surface
        radius: 28
        padding: 20
        gap: 12
        Canvas {
          height: 184
          fill: width
          let lo = min(week)
          let hi = max(week)
          let n = max(len(week) - 1, 1)
          let top = 16
          let h = 128
          let c = days7 >= 0 ? green : red
          let pts = week.map((v, i) => [i / n * width, top + (hi - v) / max(hi - lo, 1) * h])
          path(pts + [[width, top + h], [0, top + h]], closed: true, fill: linear(0, top, 0, top + h, [alpha(c, 0.35), alpha(c, 0)]))
          path(pts, stroke: c, width: 2, cap: round)
          text(usd[4], 0, 6, size: 10, color: muted)
          text(usd[3], 0, top + h + 8, size: 10, color: muted)
          for d in range(8) {
            text(d == 7 ? "now" : "${7 - d}d", 12 + d / 7 * (width - 24), 176, size: 10, align: center, color: muted)
          }
        }
        Range { size: 12 }
      }
      Text { text: "Change"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        for c, i in [{label: "1 hour", p: hour}, {label: "24 hours", p: day}, {label: "7 days", p: days7}] {
          Spacer { height: 1; fill: width; background: border; visible: i > 0 }
          Row {
            gap: 16
            align: center
            padding: [20, 14]
            Text { text: c.label; fontSize: 16; weight: 1; maxLines: 1 }
            Pct { p: c.p; size: 16 }
          }
        }
      }
    }
  }

  component Market() {
    Column {
      gap: 12
      Text { text: "Market"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        Item { label: "Market cap"; value: cap[0]; note: "${pcts[3]} today"; tint: b.market_cap_change_percentage_24h >= 0 ? green : red }
        Spacer { height: 1; fill: width; background: border }
        Item { label: "24h volume"; value: cap[1]; note: "${fixed(b.total_volume / b.market_cap * 100, 1)}% of the cap" }
        Spacer { height: 1; fill: width; background: border }
        Item { label: "All-time high"; value: usd[5]; note: "${fixed(b.ath_change_percentage, 1)}% · ${sub(b.ath_date, 0, 10)}"; tint: b.ath_change_percentage >= 0 ? green : red }
        Spacer { height: 1; fill: width; background: border }
        Item { label: "Rank"; value: "#${b.market_cap_rank}"; note: "by market cap" }
      }
      Text { text: "Supply"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        background: surface
        radius: 28
        padding: 20
        gap: 8
        Row {
          align: center
          Text { text: "${fixed(b.circulating_supply / 1000000, 2)}M mined"; fontSize: 16; weight: 1; maxLines: 1 }
          Text { text: "of ${round(b.max_supply / 1000000)}M"; fontSize: 16; color: muted; maxLines: 1 }
        }
        Progress { value: b.circulating_supply; max: b.max_supply; color: accent; fill: width }
        Text { text: "${fixed(b.circulating_supply / b.max_supply * 100, 2)}% mined, ${round((b.max_supply - b.circulating_supply) / 1000)}k BTC to go"; fontSize: 14; color: muted }
      }
      Text { text: "Open on CoinGecko"; fontSize: 16; bold: true; align: center; fill: width; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 14]; onTap: url("https://www.coingecko.com/en/coins/bitcoin") }
      Text { text: "Data from CoinGecko"; fontSize: 14; color: muted; align: center; fill: width }
    }
  }

  screen {
    title: "bitcoin"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      if problem != null {
        Column {
          gap: 0
          Text { text: "…"; fontSize: 48; bold: true; maxLines: 1 }
          Text { text: problem; fontSize: 16; color: muted; maxLines: 2 }
        }
      } else if wide {
        Row {
          gap: 24
          align: top
          Lead { weight: 1 }
          Market { weight: 1 }
        }
      } else {
        Lead { }
        Market { }
      }
    }
  }
}
