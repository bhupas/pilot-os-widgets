widget "today" {
  page: 1
  order: 1
  size: 3x3
  minSize: 3x2
  meta { description: "The date and the weather where you are, by IP or a city you type. Tap it for the next 24 hours, three days, wind, UV, sun and moon"; version: "1.2"; license: "MIT"; category: "world"; owl: 9 }

  source now = clock every 1m
  state city = "" persist
  state placing = false           // the sheet that sets the city is open
  state draft = ""                // the city, as typed there
  // The city, percent-encoded so "/", "?", "&" or "#" in it can't break the URL. Empty means located by IP.
  let q = city.replace("%", "%25").replace("+", "%2B").replace("/", "%2F").replace("?", "%3F").replace("#", "%23").replace("&", "%26").replace("'", "%27").replace(" ", "+")
  // One request. Icons and °F countries match omarchy's weather panel.
  source wx = http("https://wttr.in/${q}?format=j1") every 30m timeout 10s json
  let cur = wx.current_condition[0]
  let day = wx.weather[0]
  let area = wx.nearest_area[0]
  let imperial = contains(["united states", "united states of america", "liberia", "myanmar", "burma"], lower(trim(area.country[0].value)))
  let unit = imperial ? "F" : "C"
  let night = contains(cur.weatherIconUrl[0].value, "_night")
  // Clear or partly cloudy gets a warm sun or a cool moon; everything else stays neutral.
  let sky = contains(["113", "116"], cur.weatherCode) ? (night ? blue : yellow) : foreground
  // wttr gives "07:16 AM"; show 24-hour time.
  let sun = [day.astronomy[0].sunrise, day.astronomy[0].sunset]
    .map(s => match(s ?? "", "(\\d+):(\\d+) (AM|PM)"))
    .map(m => m == null ? "" : pad(int(num(m[0]) % 12 + (m[2] == "PM" ? 12 : 0)), 2, "0") + ":" + m[1])
  let sunHours = sun.map(s => num(sub(s, 0, 2)))
  let hourNow = num(fmtTime(now, "H"))
  // The next 24 hours in wttr's 3-hour steps, from today's and tomorrow's forecasts.
  let steps = flatten(range(2).map(i => (wx.weather[i].hourly ?? []).map(h => {
    hr: i * 24 + num(h.time) / 100,
    t: num(get(h, "temp" + unit)),
    rain: num(h.chanceofrain),
    code: h.weatherCode
  }))).filter(s => s.hr > hourNow - 3).take(8)
  // The three days' range, so their bars share one scale.
  let lowest = min((wx.weather ?? []).map(d => num(get(d, "mintemp" + unit))))
  let highest = max((wx.weather ?? []).map(d => num(get(d, "maxtemp" + unit))))
  let moonIcons = {
    "New Moon": "", "Waxing Crescent": "", "First Quarter": "", "Waxing Gibbous": "",
    "Full Moon": "", "Waning Gibbous": "", "Last Quarter": "", "Waning Crescent": ""
  }
  let uv = num(cur.uvIndex)
  let rainToday = max(day.hourly.map(h => num(h.chanceofrain)))
  let short = (rows ?? 3) < 3
  let wide = (screenWidth ?? 0) > 600

  onTap: screen()

  // A row of a card: a glyph, what it is, and its value.
  component Item(glyph, label, value, tint = foreground) {
    Row {
      gap: 16
      align: center
      padding: [20, 14]
      Text { text: glyph; font: icon; fontSize: 20; color: tint; width: 24; align: center }
      Text { text: label; fontSize: 16; weight: 1; maxLines: 1 }
      Text { text: value; fontSize: 16; color: muted; maxLines: 1 }
    }
  }

  component Rule() {
    Spacer { height: 1; fill: width; background: border }
  }

  component Heading(text) {
    Text { text: text; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
  }

  // The tile: the date, then the weather big, then the next two days and the sun when there's room.
  Column {
    gap: 2
    fill: true
    Row {
      align: center
      Text { text: upper(fmtTime(now, "EEE d MMM")); style: label; color: muted; weight: 1; maxLines: 1 }
      Text { text: cur == null ? "" : weatherIcon(cur.weatherCode, night); font: icon; fontSize: 18; color: sky; width: 24; align: end }
    }
    if cur != null {
      Text { text: "${get(cur, "temp_" + unit)}°"; fontSize: short ? 32 : 40; maxLines: 1 }
      Text { text: "${trim(cur.weatherDesc[0].value)} · ↑${get(day, "maxtemp" + unit)}° ↓${get(day, "mintemp" + unit)}°"; style: small; maxLines: 1 }
      Text { text: "Feels ${get(cur, "FeelsLike" + unit)}° · ${area.areaName[0].value}"; style: small; color: muted; maxLines: 1; visible: !short }
      Spacer { weight: 1 }
      // The next two days (icon from the noon reading), then sunrise and sunset.
      if (rows ?? 3) >= 3 {
        Row {
          gap: 4
          align: center
          for d, i in drop(wx.weather, 1) key d.date {
            Column {
              gap: 0
              weight: 1
              align: center
              Text { text: upper(fmtTime(now + 86400 * (i + 1), "EEE")); style: label; color: muted; align: center; maxLines: 1 }
              Text { text: weatherIcon(d.hourly[4].weatherCode, false); font: icon; fontSize: 16; align: center }
              Text { text: "${get(d, "maxtemp" + unit)}° ${get(d, "mintemp" + unit)}°"; style: small; align: center; maxLines: 1 }
            }
          }
          Column {
            gap: 4
            weight: 1.2
            Row {
              gap: 4
              align: center
              Text { text: ""; font: icon; fontSize: 14; color: yellow; width: 20 }
              Text { text: sun[0]; style: small; maxLines: 1; weight: 1 }
            }
            Row {
              gap: 4
              align: center
              Text { text: ""; font: icon; fontSize: 14; color: orange; width: 20 }
              Text { text: sun[1]; style: small; maxLines: 1; weight: 1 }
            }
          }
        }
      }
    } else {
      Text { text: wx == null ? "…" : "Offline"; fontSize: short ? 32 : 40; maxLines: 1 }
      Text { text: wx == null ? "Loading the weather" : "wttr.in can't be reached"; style: small; color: muted; maxLines: 1 }
    }
  }

  // Now, then the next 24 hours and three days.
  component Forecast() {
    Column {
      gap: 12
      Column {
        gap: 0
        Row {
          gap: 12
          align: center
          Text { text: cur == null ? "" : weatherIcon(cur.weatherCode, night); font: icon; fontSize: 48; color: sky; width: 56; align: center; visible: cur != null }
          Text { text: cur == null ? (wx == null ? "…" : "Offline") : "${get(cur, "temp_" + unit)}°${unit}"; fontSize: 48; bold: true; maxLines: 1; weight: 1 }
        }
        Text {
          text: cur == null ? (wx == null ? "Loading the weather…" : "wttr.in can't be reached") : "${trim(cur.weatherDesc[0].value)} · feels ${get(cur, "FeelsLike" + unit)}° · ↑${get(day, "maxtemp" + unit)}° ↓${get(day, "mintemp" + unit)}°"
          fontSize: 16; color: muted
        }
        Text { text: cur == null ? "" : "${area.areaName[0].value}, ${area.country[0].value} · ${fmtTime(now, "EEEE d MMMM")}"; fontSize: 16; color: muted; maxLines: 1; visible: cur != null }
      }
      if cur != null {
        // The next 24 hours: time, icon and rain chance per step, with the temperature curve under them.
        Heading { text: "Next 24 hours" }
        Column {
          gap: 4
          background: surface
          radius: 28
          padding: [16, 16]
          Row {
            gap: 0
            for s in steps key s.hr {
              Column {
                gap: 2
                weight: 1
                align: center
                Text { text: s.hr == hourNow - hourNow % 3 ? "Now" : pad(s.hr % 24, 2, "0"); style: small; color: muted; align: center; maxLines: 1 }
                Text { text: weatherIcon(s.code, s.hr % 24 < sunHours[0] || s.hr % 24 >= sunHours[1]); font: icon; fontSize: 20; align: center }
              }
            }
          }
          Canvas {
            height: 84
            fill: width
            let n = max(len(steps), 1)
            let temps = steps.map(s => s.t)
            let lo = min(temps)
            let hi = max(temps)
            let ys = temps.map(t => 22 + (hi - t) / max(hi - lo, 1) * 26)
            let xs = range(n).map(i => (i + 0.5) * width / n)
            path(range(n).map(i => [xs[i], ys[i]]), stroke: accent, width: 2)
            for s, i in steps {
              circle(xs[i], ys[i], 3, fill: accent)
              text("${s.t}°", xs[i], ys[i] - 13, size: 12, align: center, color: foreground)
              rect(xs[i] - 10, height - 12, 20, 4, radius: 2, fill: alpha(muted, 0.2))
              rect(xs[i] - 10, height - 12, 20 * s.rain / 100, 4, radius: 2, fill: blue)
              text("${s.rain}%", xs[i], height - 24, size: 10, align: center, color: s.rain >= 30 ? blue : muted)
            }
          }
        }
        // Three days: icon, rain chance and the day's low to high on a shared scale.
        Heading { text: "Three days" }
        Column {
          gap: 0
          background: surface
          radius: 28
          clip: true
          for d, i in wx.weather key d.date {
            let lo = num(get(d, "mintemp" + unit))
            let hi = num(get(d, "maxtemp" + unit))
            Spacer { height: 1; fill: width; background: border; visible: i > 0 }
            Row {
              gap: 8
              align: center
              padding: [20, 14]
              Text { text: i == 0 ? "Today" : fmtTime(now + 86400 * i, "EEE"); fontSize: 16; width: 56; maxLines: 1 }
              Text { text: weatherIcon(d.hourly[4].weatherCode, false); font: icon; fontSize: 20; width: 26; align: center }
              Text { text: "${max(d.hourly.map(h => num(h.chanceofrain)))}%"; fontSize: 14; color: blue; width: 40; align: end; maxLines: 1 }
              Text { text: "${lo}°"; fontSize: 14; color: muted; width: 36; align: end; maxLines: 1 }
              Canvas {
                height: 6
                weight: 1
                let span = max(highest - lowest, 1)
                let x0 = (lo - lowest) / span * width
                let x1 = (hi - lowest) / span * width
                rect(0, 0, width, height, radius: 3, fill: alpha(muted, 0.2))
                rect(x0, 0, max(x1 - x0, 6), height, radius: 3, fill: linear(0, 0, width, 0, [cyan, orange]))
              }
              Text { text: "${hi}°"; fontSize: 14; width: 36; maxLines: 1 }
            }
          }
        }
      }
    }
  }

  // Wind, sun and moon, and where.
  component Details() {
    Column {
      gap: 12
      if cur != null {
        Heading { text: "Right now" }
        Column {
          gap: 0
          background: surface
          radius: 28
          clip: true
          Item { glyph: ""; label: "Wind ${cur.winddir16Point}"; value: imperial ? "${cur.windspeedMiles} mph" : "${cur.windspeedKmph} km/h"; tint: cyan }
          Rule { }
          Item { glyph: ""; label: "Humidity"; value: "${cur.humidity}%"; tint: blue }
          Rule { }
          Item { glyph: ""; label: "Rain today"; value: "${rainToday}% · ${imperial ? cur.precipInches + " in" : cur.precipMM + " mm"}"; tint: blue }
          Rule { }
          Item { glyph: ""; label: "UV index"; value: "${uv} · ${uv >= 8 ? "very high" : uv >= 6 ? "high" : uv >= 3 ? "moderate" : "low"}"; tint: uv >= 6 ? red : uv >= 3 ? yellow : green }
          Rule { }
          Item { glyph: ""; label: "Pressure"; value: imperial ? "${cur.pressureInches} inHg" : "${cur.pressure} hPa" }
          Rule { }
          Item { glyph: ""; label: "Visibility"; value: imperial ? "${cur.visibilityMiles} mi" : "${cur.visibility} km" }
        }
        Heading { text: "Sun and moon" }
        Column {
          gap: 0
          background: surface
          radius: 28
          clip: true
          Item { glyph: ""; label: "Sunrise"; value: sun[0]; tint: yellow }
          Rule { }
          Item { glyph: ""; label: "Sunset"; value: sun[1]; tint: orange }
          Rule { }
          Item { glyph: get(moonIcons, day.astronomy[0].moon_phase, ""); label: day.astronomy[0].moon_phase; value: "${day.astronomy[0].moon_illumination}% lit" }
        }
      }
      Heading { text: "Place" }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        Row {
          gap: 16
          align: center
          padding: [20, 14]
          onTap: { draft = city; placing = true }
          Text { text: "City"; fontSize: 16; weight: 1; maxLines: 1 }
          Text { text: city == "" ? "Found by IP" : city; fontSize: 16; color: city == "" ? muted : accent; maxLines: 1 }
          Text { text: "›"; fontSize: 18; color: muted }
        }
      }
      // yr.no (Norwegian Meteorological Institute): ad-free and worldwide, opened at wttr's coordinates.
      if cur != null {
        Text { text: "Open yr.no"; fontSize: 16; maxLines: 1; align: center; fill: width; background: mix(surface, accent, 0.22); radius: 24; padding: [24, 14]; onTap: url("https://www.yr.no/en/forecast/daily-table/${area.latitude},${area.longitude}") }
      }
    }
  }

  // The app: the weather now, the day and three days ahead, and the city it's for.
  screen {
    title: "weather"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      if wide {
        Row {
          gap: 24
          Forecast { weight: 1 }
          Details { weight: 1 }
        }
      } else {
        Forecast { }
        Details { }
      }

      // The city: typed, or empty to be found by IP.
      if placing {
        Sheet {
          title: "City"
          onDismiss: placing = false
          Column {
            gap: 16
            padding: [0, 4, 0, 4]
            Input {
              text: draft
              placeholder: "A city, or empty to find you by IP"
              focus: placing
              onChange: draft = value
              onSubmit: { city = trim(value); placing = false; refresh() }
            }
            Row {
              gap: 8
              align: center
              if city != "" {
                Text { text: "Use IP"; fontSize: 15; color: accent; padding: [8, 12]; onTap: { city = ""; placing = false; refresh() } }
              }
              Spacer { weight: 1 }
              Text { text: "Cancel"; fontSize: 15; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 12]; onTap: placing = false }
              Text { text: "Save"; fontSize: 15; bold: true; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 12]; onTap: { city = trim(draft); placing = false; refresh() } }
            }
          }
        }
      }
    }
  }
}
