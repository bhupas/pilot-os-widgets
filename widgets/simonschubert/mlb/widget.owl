widget "mlb" {
  meta {
    owl: 8
    description: "MLB scores from ESPN with team logos: live games first, then last night's finals and today's first pitches. Tap for every game and both league standings"
    version: "1.1"
    license: "MIT"
    category: "world"
  }
  requires { pacman: ["curl", "jq"] }
  page: 1
  order: 45
  size: 6x4
  minSize: 3x3

  // ESPN's scoreboard answers one day at a time: yesterday, today and tomorrow,
  // trimmed to what the tile shows. Logos are referred to by file name, kept to
  // [a-z0-9].png.
  source games = cmd("""
    u=https://site.api.espn.com/apis/site/v2/sports/baseball/mlb/scoreboard
    for i in -1 0 1; do
      curl -fsm 10 --compressed "$u?dates=$(date -d "$i day" +%Y%m%d)"
    done | jq -sc '[.[].events[] | .competitions[0] as $c | {
      id, at: (.date[0:16] + ":00Z" | fromdateiso8601),
      state: $c.status.type.state, detail: $c.status.type.shortDetail,
      teams: [$c.competitors[] | {
        side: .homeAway, abbr: .team.abbreviation, name: .team.shortDisplayName, score, winner: (.winner // false),
        logo: ((.team.logo // "") | sub(".*/"; "") | if test("^[a-z0-9]+[.]png$") then . else "" end)
      }]
    }] | unique_by(.id) | sort_by(.at)'
  """) every 5m json timeout 60s

  // Standings by conference, in seed order, with each team's logo fetched once
  // into ~/.cache/espn-logos, at 96 px, and left there.
  source table = cmd("""
    d=~/.cache/espn-logos/mlb
    mkdir -p "$d"
    t=$(curl -fsm 20 --compressed https://site.api.espn.com/apis/v2/sports/baseball/mlb/standings | jq -c '[.children[] | {
      name: .abbreviation, teams: [.standings.entries[] | (reduce .stats[] as $s ({}; .[$s.name] = $s)) as $st | {
        id: .team.id, abbr: .team.abbreviation, name: .team.shortDisplayName,
        logo: ((.team.logos[0].href // "") | sub(".*/"; "") | if test("^[a-z0-9]+[.]png$") then . else "" end),
        seed: ($st.playoffSeed.value // 99 | floor), rec: ($st.overall.displayValue // "" | split(", ")[0]),
        b: $st.gamesBehind.displayValue
      }] | sort_by(.seed)
    }]') || exit 1
    for f in $(printf '%s' "$t" | jq -r '.[].teams[].logo | select(. != "")'); do
      [ -s "$d/$f" ] || curl -fsm 15 -o "$d/$f" "https://a.espncdn.com/combiner/i?img=/i/teamlogos/mlb/500/$f&w=96&h=96" || rm -f "$d/$f"
    done
    printf '%s\n' "$t"
  """) every 30m json timeout 120s
  source now = clock every 1m

  state view = "scores"

  let all = games ?? []
  let live = all.filter(g => g.state == 'in')
  let done = all.filter(g => g.state == 'post').reverse()
  let next = all.filter(g => g.state == 'pre')
  let cap = clamp((rows ?? 4) * 3 - 2, 5, 14)
  let picked = flatten([live, done.take(ceil(cap / 2)), next]).take(cap)
  let groups = table ?? []
  // Full team names and the long status where the tile has room for them.
  let wide = (tileWidth ?? 0) >= 280
  // A line under the last playoff seed.
  let cuts = [6]
  let bLabel = "GB"

  component Badge(logo, px = 18) {
    if logo {
      Image { src: "~/.cache/espn-logos/mlb/${logo}"; size: px; fit: contain }
    } else {
      Box { size: px }
    }
  }

  component GameRow(g) {
    let away = g.teams.find(t => t.side == 'away') ?? g.teams[1]
    let home = g.teams.find(t => t.side == 'home') ?? g.teams[0]
    let live = g.state == 'in'
    let final = g.state == 'post'
    let px = wide ? 18 : 14
    let scW = wide ? 30 : 24
    let dotW = wide ? 8 : 6
    let stW = wide ? 104 : 40
    let ctrW = 2 * scW + 2 * dotW + stW
    // Under 4 columns the logos would squeeze the names out.
    let logos = (cols ?? 6) >= 4

    // Away on the left, at home on the right; the centre keeps one width so the
    // logos and names line up down the list.
    Row {
      gap: wide ? 8 : 4
      align: center
      if logos { Badge { logo: away.logo; px: px } }
      Text { text: wide ? away.name : away.abbr; style: small; weight: 1; maxLines: 1; color: final && !away.winner ? muted : foreground }
      if g.state == 'pre' {
        Text { text: fmtTime(g.at, wide ? "EEE HH:mm" : "HH:mm"); style: small; width: ctrW; align: center; color: muted; maxLines: 1 }
      } else {
        Row {
          width: ctrW; gap: 0; align: center
          Text { text: away.score ?? '–'; style: small; width: scW; align: end; bold: final && away.winner; color: live ? accent : final && !away.winner ? muted : foreground; maxLines: 1 }
          Box { width: dotW; height: 5; radius: 2.5; background: live ? accent : transparent }
          Text { text: g.detail; style: small; width: stW; align: center; color: live ? accent : muted; maxLines: 1 }
          Box { width: dotW }
          Text { text: home.score ?? '–'; style: small; width: scW; align: start; bold: final && home.winner; color: live ? accent : final && !home.winner ? muted : foreground; maxLines: 1 }
        }
      }
      Text { text: wide ? home.name : home.abbr; style: small; weight: 1; maxLines: 1; align: end; color: final && !home.winner ? muted : foreground }
      if logos { Badge { logo: home.logo; px: px } }
    }
  }

  // The first game, big: the teams either side of the score (or the first pitch).
  component Lead(g) {
    let away = g.teams.find(t => t.side == 'away') ?? g.teams[1]
    let home = g.teams.find(t => t.side == 'home') ?? g.teams[0]
    let logos = (cols ?? 6) >= 4
    Column {
      gap: 0
      Row {
        gap: 6
        align: center
        if logos { Badge { logo: away.logo; px: 24 } }
        Text { text: away.abbr; fontSize: 18; bold: true; weight: 1; maxLines: 1; color: g.state == 'post' && !away.winner ? muted : foreground }
        Text { text: g.state == 'pre' ? fmtTime(g.at, "HH:mm") : "${away.score ?? '–'}–${home.score ?? '–'}"; fontSize: logos ? 32 : 28; bold: true; maxLines: 1; color: g.state == 'in' ? accent : foreground }
        Text { text: home.abbr; fontSize: 18; bold: true; weight: 1; align: end; maxLines: 1; color: g.state == 'post' && !home.winner ? muted : foreground }
        if logos { Badge { logo: home.logo; px: 24 } }
      }
      Text { text: g.state == 'pre' ? fmtTime(g.at, "EEE d MMM") : g.detail; style: small; color: g.state == 'in' ? accent : muted; align: center; fill: width; maxLines: 1 }
    }
  }

  onTap: screen()

  // The tile: the first game big, then as many more as fit.
  Column {
    gap: 2
    fill: true
    Row {
      align: center
      Text { text: "MLB"; style: label; color: muted; weight: 1; maxLines: 1 }
      if count(live) > 0 {
        Text { text: "${count(live)} LIVE"; style: label; color: accent; bold: true; maxLines: 1 }
      } else {
        Text { text: upper(fmtTime(now, "EEE d")); style: label; color: muted; maxLines: 1 }
      }
    }
    if count(picked) == 0 {
      Text { text: games == null ? "…" : "No games"; fontSize: 40; maxLines: 1 }
      Text { text: games == null ? "Loading scores" : "None yesterday, today or tomorrow"; style: small; color: muted; maxLines: 1 }
    } else {
      Lead { g: picked[0] }
      Spacer { height: 4 }
      Column {
        gap: 4
        weight: 1
        clip: true
        for g in picked.drop(1).take(max((rows ?? 4) * 3 - 5, 1)) key g.id { GameRow { g: g } }
      }
    }
  }

  // The app: scores and standings on two tabs, each in cards; side by side on a wide screen.
  let twoCols = (screenWidth ?? 0) > 600

  // A game as Google lists it: away over home, each with its score, and the status beside them.
  component Game(g) {
    Row {
      gap: 16
      align: center
      padding: [20, 14]
      Column {
        gap: 6
        weight: 1
        for t in [g.teams.find(t => t.side == 'away') ?? g.teams[1], g.teams.find(t => t.side == 'home') ?? g.teams[0]] {
          Row {
            gap: 12
            align: center
            Badge { logo: t.logo; px: 24 }
            Text { text: t.name; fontSize: 16; bold: g.state == 'post' && t.winner; color: g.state == 'post' && !t.winner ? muted : foreground; weight: 1; maxLines: 1 }
            Text { text: g.state == 'pre' ? "" : t.score ?? '–'; fontSize: 16; bold: g.state != 'post' || t.winner; color: g.state == 'in' ? accent : g.state == 'post' && !t.winner ? muted : foreground; maxLines: 1 }
          }
        }
      }
      Text { text: g.state == 'pre' ? fmtTime(g.at, "EEE HH:mm") : g.detail; fontSize: 14; color: g.state == 'in' ? accent : muted; width: 88; align: end; maxLines: 2 }
    }
  }

  component Section(name, list) {
    Column {
      gap: 12
      Text { text: name; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        for g, i in list key g.id {
          Spacer { height: 1; fill: width; background: border; visible: i > 0 }
          Game { g: g }
        }
      }
    }
  }

  component League(grp) {
    Column {
      gap: 12
      Row {
        padding: [4, 8, 20, 0]
        Text { text: grp.name; fontSize: 14; bold: true; color: accent; weight: 1; maxLines: 1 }
        Text { text: "W-L"; fontSize: 14; color: muted; width: 64; align: end; maxLines: 1 }
        Text { text: bLabel; fontSize: 14; color: muted; width: 40; align: end; maxLines: 1 }
      }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        for t, i in grp.teams key t.id {
          // A hairline between teams, and an accent one under the last playoff seed.
          Spacer { height: 1; fill: width; background: i > 0 && cuts.contains(i) ? accent : border; visible: i > 0 }
          Row {
            gap: 12
            align: center
            padding: [20, 12]
            Text { text: t.seed < 99 ? t.seed : '–'; fontSize: 14; color: muted; width: 20; align: end; maxLines: 1 }
            Badge { logo: t.logo; px: 22 }
            Text { text: t.name; fontSize: 16; weight: 1; maxLines: 1 }
            Text { text: t.rec; fontSize: 16; bold: true; width: 64; align: end; maxLines: 1 }
            Text { text: t.b ?? '–'; fontSize: 14; color: muted; width: 40; align: end; maxLines: 1 }
          }
        }
      }
    }
  }

  screen {
    title: "MLB"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      Column {
        gap: 0
        Text { text: games == null ? "Loading…" : count(live) > 0 ? "${count(live)} live" : "${count(all)} games"; fontSize: 48; bold: true; color: count(live) > 0 ? accent : foreground; maxLines: 1 }
        Text { text: games == null ? "Scores from ESPN" : "${count(done)} final · ${count(next)} to come · ${fmtTime(now, "EEEE d MMMM")}"; fontSize: 16; color: muted; maxLines: 1 }
      }
      Row {
        gap: 8
        for v in [["scores", "Scores"], ["standings", "Standings"]] {
          Text { text: v[1]; fontSize: 16; weight: 1; align: center; maxLines: 1; radius: 20; padding: [0, 10]; color: view == v[0] ? foreground : muted; background: view == v[0] ? mix(surface, accent, 0.22) : transparent; onTap: view = v[0] }
        }
      }
      if view == "scores" {
        if count(all) == 0 {
          Text { text: games == null ? "Loading scores…" : "No games yesterday, today or tomorrow."; fontSize: 16; color: muted; padding: [4, 8, 0, 0] }
        }
        if twoCols {
          Row {
            gap: 12
            align: top
            Column {
              gap: 12
              weight: 1
              if count(live) > 0 { Section { name: "Live"; list: live } }
              if count(done) > 0 { Section { name: "Final"; list: done } }
            }
            Column {
              gap: 12
              weight: 1
              if count(next) > 0 { Section { name: "Coming up"; list: next } }
            }
          }
        } else {
          if count(live) > 0 { Section { name: "Live"; list: live } }
          if count(done) > 0 { Section { name: "Final"; list: done } }
          if count(next) > 0 { Section { name: "Coming up"; list: next } }
        }
      } else {
        if count(groups) == 0 {
          Text { text: table == null ? "Loading standings…" : "No standings yet."; fontSize: 16; color: muted; padding: [4, 8, 0, 0] }
        }
        if twoCols {
          Row {
            gap: 12
            align: top
            for grp in groups { League { grp: grp; weight: 1 } }
          }
        } else {
          for grp in groups { League { grp: grp } }
        }
      }
      Row {
        gap: 8
        Spacer { weight: 1 }
        Text { text: "Refresh"; fontSize: 15; bold: true; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 12]; onTap: refresh() }
      }
    }
  }
}
