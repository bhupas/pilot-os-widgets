widget "ifsc" {
  meta {
    owl: 8
    description: "IFSC Climbing World Cup: the next event with a countdown, the latest podiums, live results and the cup standings for boulder, lead and speed. Tap for everything"
    version: "1.1"
    license: "MIT"
    category: "world"
  }
  requires { pacman: ["curl", "jq"] }
  size: 6x4
  minSize: 3x3

  // The current season's World Cup calendar from ifsc.results.info (it only wants a
  // Referer), and the results of the latest event that has started: top 8 of each
  // category, with each climber's score from the last round they climbed. Flags are
  // fetched once into ~/.cache/ifsc-flags.
  source info = cmd("""
    g() { curl -fsm 15 --compressed -H 'Referer: https://ifsc.results.info/' "https://ifsc.results.info$1"; }
    lg=$(g /api/v1/ | jq -r '.current.leagues[] | select(.league_id == 1) | .url') || exit 1
    s=$(g "$lg") || exit 1
    ev=$(printf '%s' "$s" | jq -c --argjson now "$(date +%s)" '
      def t: sub(" UTC$"; "Z") | sub(" "; "T") | fromdateiso8601;
      def d: strptime("%Y-%m-%d") | strftime("%-d %b");
      { season, events: [.events[] | (.starts_at | t) as $a | (.ends_at | t) as $b | {
          id: .event_id,
          name: (.event | sub("^(World Climbing Series|IFSC World Cup|IFSC Climbing World Cup|IFSC) "; "") | sub(" [0-9]{4}$"; "")),
          full: .event, start: $a, end: $b,
          dates: (if .local_start_date == .local_end_date then (.local_start_date | d) else "\(.local_start_date | d) – \(.local_end_date | d)" end),
          kinds: ([.d_cats[].name | split(" ")[0] | ascii_downcase | select(. != "speed")] + [.d_cats[].name | select(test("^SPEED (Men|Women)")) | "speed"] | unique),
          cats: [.d_cats[] | select(.name | test("RELAY") | not) | {id, name, status}],
          state: (if $now >= $b or all(.d_cats[]; .status == "finished") then "done" elif $now >= $a then "live" else "next" end)
      }] | sort_by(.start) }') || exit 1
    lat=$(printf '%s' "$ev" | jq -c '[.events[] | select(.state != "next")] | last // empty')
    cats='[]'
    if [ -n "$lat" ]; then
      id=$(printf '%s' "$lat" | jq -r .id)
      cats=$(for c in $(printf '%s' "$lat" | jq -r '.cats[].id'); do g "/api/v1/events/$id/result/$c"; done | jq -sc '[.[] | {
        name: .dcat, short: (.dcat | split(" ") | "\(.[0] | ascii_downcase) \(.[1][0:1])"), kind: (.dcat | split(" ")[0] | ascii_downcase), status,
        round: ([.category_rounds[] | select(.status != null and .status != "pending")] | last | .name),
        top: [.ranking[:8][] | {rank, name: "\(.firstname) \(.lastname)", country,
          score: ([.rounds[] | select(.score != null and .score != "")] | last | .score // "" | tostring | split(" (")[0])}]
      } | select(.top | length > 0)]') || cats='[]'
    fi
    d=~/.cache/ifsc-flags; mkdir -p "$d"
    for f in $(printf '%s' "$cats" | jq -r '.[].top[].country | select(test("^[A-Z]{3}$"))' | sort -u); do
      [ -s "$d/$f.png" ] || curl -fsm 10 -o "$d/$f.png" "https://d1n1qj9geboqnb.cloudfront.net/flags/$f.png" || rm -f "$d/$f.png"
    done
    [ -n "$lat" ] || lat=null
    printf '%s' "$ev" | jq -c --argjson lat "$lat" --argjson cats "$cats" '. + {latest: (if $lat then $lat + {results: $cats} else null end)}'
  """) every 10m json timeout 120s

  // Cup standings, top 10 of each Olympic discipline.
  source cup = cmd("""
    g() { curl -fsm 15 --compressed -H 'Referer: https://ifsc.results.info/' "https://ifsc.results.info$1"; }
    lg=$(g /api/v1/ | jq -r '.current.leagues[] | select(.league_id == 1) | .url') || exit 1
    urls=$(g "$lg" | jq -r '.cups[0].d_cats[] | select(.name | test("^(BOULDER|LEAD|SPEED) (Men|Women)$")) | .ranking_url') || exit 1
    r=$(for u in $urls; do g "$u"; done | jq -sc '[.[] | {name: .dcat_name, short: (.dcat_name | split(" ") | "\(.[0] | ascii_downcase) \(.[1][0:1])"), kind: (.dcat_name | split(" ")[0] | ascii_downcase),
      top: [.ranking[:10][] | {rank, name: "\(.firstname) \(.lastname)", country, score: (.score | (tonumber? // .) | if type == "number" and . == floor then floor else . end | tostring)}]} | select(.top | length > 0)] | sort_by(.kind, (.name | test("Women")))') || exit 1
    d=~/.cache/ifsc-flags; mkdir -p "$d"
    for f in $(printf '%s' "$r" | jq -r '.[].top[].country | select(test("^[A-Z]{3}$"))' | sort -u); do
      [ -s "$d/$f.png" ] || curl -fsm 10 -o "$d/$f.png" "https://d1n1qj9geboqnb.cloudfront.net/flags/$f.png" || rm -f "$d/$f.png"
    done
    printf '%s\n' "$r"
  """) every 1h json timeout 120s

  source now = clock every 1m

  state tab = "results"
  state pick = 0

  let events = info.events ?? []
  let latest = info.latest
  let live = latest.state == "live"
  let upcoming = events.filter(e => e.state == "next")
  let next = first(upcoming)
  let results = latest.results ?? []
  let standings = cup ?? []
  let wide = (tileWidth ?? 0) >= 300
  let wideScreen = (screenWidth ?? 0) > 600
  // Lines under the lead: the latest winners first, then cup leaders if 2+ fit.
  let slots = max(0, (rows ?? 4) * 3 - 7)
  let shown = results.take(slots)
  let spare = slots - count(shown) - 1
  let leaders = spare >= 2 ? standings.take(spare) : []
  // The event the tile and the app lead with: the live one, else the next.
  let lead = live ? latest : next

  component Until(t, tint = foreground, fs = 12) {
    Text {
      text: t - now > 86400 ? "in ${ceil((t - now) / 86400)}d" : t > now ? "in ${fmtDuration(t - now)}" : "now"
      fontSize: fs; width: 64; align: end; color: tint; maxLines: 1
    }
  }

  component Flag(code, px = 14) {
    if code {
      Image { src: "~/.cache/ifsc-flags/${code}.png"; width: px * 1.5; height: px; fit: contain }
    } else {
      Box { width: px * 1.5; height: px }
    }
  }

  component Kinds(list) {
    Row {
      gap: 4
      for k in list ?? [] {
        Text { text: k; style: label; width: len(k) * 7 + 14; align: center; maxLines: 1; color: (k == "boulder" ? yellow : k == "lead" ? blue : k == "speed" ? red : accent); padding: [5, 1]; radius: 8; border: 1; borderColor: alpha((k == "boulder" ? yellow : k == "lead" ? blue : k == "speed" ? red : accent), 0.5) }
      }
    }
  }

  component Athlete(a, showScore = true) {
    Row {
      gap: 12
      align: center
      padding: [20, 12]
      Text { text: a.rank; width: 22; fontSize: 15; align: end; bold: a.rank <= 3; color: a.rank == 1 ? yellow : a.rank == 2 ? foreground : a.rank == 3 ? orange : muted; maxLines: 1 }
      Flag { code: a.country; px: 16 }
      Text { text: a.name; fontSize: 16; weight: 1; maxLines: 1 }
      if showScore {
        Text { text: a.score ?? ""; fontSize: 14; width: 72; align: end; color: muted; maxLines: 1 }
      }
    }
  }

  // One category's winner on the tile.
  component Winner(c) {
    let w = c.top[0]
    Row {
      gap: 6
      align: center
      Text { text: c.short; style: small; width: wide ? 72 : 60; color: (c.kind == "boulder" ? yellow : c.kind == "lead" ? blue : c.kind == "speed" ? red : accent); maxLines: 1 }
      Flag { code: w.country }
      Text { text: w.name; style: small; weight: 1; maxLines: 1 }
      if wide {
        Text {
          text: c.status == null ? "${w.score} pts" : c.status == "finished" ? (w.score ?? "") : (c.round ?? "live")
          style: small; width: 72; align: end; color: c.status == null || c.status == "finished" ? muted : accent; maxLines: 1
        }
      }
    }
  }

  component EventRow(e) {
    Row {
      gap: 12
      align: center
      padding: [20, 14]
      Box { width: 4; height: 36; radius: 2; background: e.state == "live" ? accent : e.state == "next" ? alpha(foreground, 0.6) : alpha(muted, 0.4) }
      Column {
        gap: 2
        weight: 1
        Text { text: e.name; fontSize: 16; maxLines: 1; color: e.state == "done" ? muted : foreground }
        Text { text: e.dates; fontSize: 14; color: muted; maxLines: 1 }
      }
      Kinds { list: e.kinds }
      if e.state == "next" {
        Until { t: e.start; fs: 14 }
      } else {
        Text { text: e.state == "live" ? "Live" : "✓"; fontSize: 14; width: 64; align: end; color: e.state == "live" ? accent : muted; maxLines: 1 }
      }
    }
  }

  onTap: screen()

  Column {
    gap: 2
    fill: true
    Row {
      align: center
      Text { text: "IFSC"; style: label; color: muted; weight: 1; maxLines: 1 }
      Text { text: live ? "● LIVE" : info.season ?? ""; style: label; width: 60; align: end; color: live ? accent : muted; bold: live; maxLines: 1 }
    }

    // The live event, or the next one, big.
    if lead != null {
      Row {
        gap: 8
        align: center
        Text { text: lead.name; fontSize: wide ? 40 : 30; color: live ? accent : foreground; weight: 1; maxLines: 1 }
        if wide { Kinds { list: lead.kinds } }
      }
      Row {
        gap: 8
        align: center
        Text { text: live ? "Live · ${lead.dates}" : "Next · ${lead.dates}"; style: small; color: live ? accent : muted; weight: 1; maxLines: 1 }
        if !live { Until { t: lead.start; tint: accent } }
      }
    } else {
      Text { text: info == null ? null : "Season over"; fontSize: 30; maxLines: 1 }
      Text { text: info.season ?? ""; style: small; color: muted; maxLines: 1 }
    }
    Spacer { weight: 1 }

    // Then the latest winners and cup leaders, as many as fit.
    if latest != null && count(shown) > 0 {
      Text { text: upper("${live ? "now" : "last"} · ${latest.name}"); style: label; color: muted; maxLines: 1 }
      Column {
        gap: 3
        for c in shown { Winner { c: c } }
      }
      if count(leaders) > 0 {
        Spacer { height: 4 }
        Text { text: "CUP LEADERS"; style: label; color: muted; maxLines: 1 }
        Column {
          gap: 3
          for c in leaders { Winner { c: c } }
        }
      }
    }
  }

  // The latest event's results, a card per category.
  component Results() {
    Column {
      gap: 12
      if latest == null {
        Text { text: info == null ? "Loading…" : "No results yet."; fontSize: 16; color: muted; padding: [4, 8, 0, 0] }
      } else {
        Column {
          gap: 0
          padding: [4, 8, 0, 0]
          Text { text: latest.full; fontSize: 20; bold: true; maxLines: 2 }
          Text { text: (live ? "Live · " : "") + latest.dates; fontSize: 14; color: live ? accent : muted; maxLines: 1 }
        }
        for c in results {
          Row {
            align: center
            gap: 8
            padding: [4, 8, 0, 0]
            Text { text: "${upper(sub(c.name, 0, 1))}${lower(sub(c.name, 1))}"; fontSize: 14; bold: true; color: accent; weight: 1; maxLines: 1 }
            Text { text: c.status == "finished" ? "Final" : (c.round ?? c.status); fontSize: 14; color: c.status == "finished" ? muted : accent; maxLines: 1 }
          }
          Column {
            gap: 0
            background: surface
            radius: 28
            clip: true
            for a, i in c.top key a.name {
              Spacer { height: 1; fill: width; background: border; visible: i > 0 }
              Athlete { a: a }
            }
          }
        }
        Text { text: "Full results"; fontSize: 16; bold: true; align: center; fill: width; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [24, 14]; onTap: url("https://ifsc.results.info/event/${latest.id}") }
      }
    }
  }

  // The cup standings, one category at a time, picked with chips.
  component Standings() {
    Column {
      gap: 12
      Flow {
        gap: 8
        for s, i in standings {
          Text { text: s.short; fontSize: 14; maxLines: 1; radius: 16; padding: [14, 8]; background: pick == i ? mix(surface, accent, 0.22) : surface; color: pick == i ? (s.kind == "boulder" ? yellow : s.kind == "lead" ? blue : s.kind == "speed" ? red : accent) : foreground; onTap: pick = i }
        }
      }
      let s = standings[pick]
      if s == null {
        Text { text: cup == null ? "Loading…" : "No standings yet."; fontSize: 16; color: muted; padding: [4, 8, 0, 0] }
      } else {
        Text { text: "${upper(sub(s.name, 0, 1))}${lower(sub(s.name, 1))}"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0]; maxLines: 1 }
        Column {
          gap: 0
          background: surface
          radius: 28
          clip: true
          for a, i in s.top key a.name {
            Spacer { height: 1; fill: width; background: border; visible: i > 0 }
            Athlete { a: a }
          }
        }
      }
    }
  }

  // The season's events, in order.
  component Calendar() {
    Column {
      gap: 12
      Text { text: "Season ${info.season ?? ''}"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        for e, i in events key e.id {
          Spacer { height: 1; fill: width; background: border; visible: i > 0 }
          EventRow { e: e }
        }
        if count(events) == 0 {
          Text { text: info == null ? "Loading…" : "No events yet."; fontSize: 16; color: muted; padding: [20, 16] }
        }
      }
    }
  }

  screen {
    title: "IFSC World Cup ${info.season ?? ''}"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      // The live event, or the next one, big.
      Column {
        gap: 0
        Text { text: lead != null ? lead.name : info == null ? "…" : "Season over"; fontSize: 48; bold: true; color: live ? accent : foreground; maxLines: 2 }
        Text {
          text: lead == null ? "No more events this season" : live ? "Live now · ${lead.dates}" : "${lead.start - now > 86400 ? "In ${ceil((lead.start - now) / 86400)} days" : "In ${fmtDuration(max(lead.start - now, 0))}"} · ${lead.dates}"
          fontSize: 16; color: live ? accent : muted; maxLines: 1
        }
      }
      if wideScreen {
        Row {
          gap: 24
          align: top
          Results { weight: 1 }
          Column {
            gap: 12
            weight: 1
            Standings { }
            Calendar { }
          }
        }
      } else {
        Row {
          gap: 8
          for v in [["results", live ? "Live" : "Results"], ["cup", "Standings"], ["calendar", "Calendar"]] {
            Text { text: v[1]; fontSize: 15; weight: 1; align: center; maxLines: 1; radius: 20; padding: [0, 10]; background: tab == v[0] ? mix(surface, accent, 0.22) : transparent; color: tab == v[0] ? foreground : muted; onTap: { tab = v[0]; pick = v[0] == "cup" ? 0 : pick } }
          }
        }
        if tab == "results" {
          Results { }
        } else if tab == "cup" {
          Standings { }
        } else {
          Calendar { }
        }
      }
    }
  }
}
