widget "nba" {
  meta {
    owl: 8
    description: "NBA scores from ESPN with team logos: live games first, then last night's finals and today's tip-offs. Tap for every game and both conference standings"
    version: "1.1"
    license: "MIT"
    category: "world"
  }
  requires { pacman: ["curl", "jq"] }
  page: 1
  order: 45
  size: 6x4
  minSize: 3x3

  // ESPN's scoreboard answers one day at a time: yesterday, today and tomorrow,
  // trimmed to what the tile shows. Logos are referred to by file name, kept to
  // [a-z0-9].png.
  source games = cmd("""
    u=https://site.api.espn.com/apis/site/v2/sports/basketball/nba/scoreboard
    for i in -1 0 1; do
      curl -fsm 10 --compressed "$u?dates=$(date -d "$i day" +%Y%m%d)"
    done | jq -sc '[.[].events[] | .competitions[0] as $c | {
      id, at: (.date[0:16] + ":00Z" | fromdateiso8601),
      state: $c.status.type.state, detail: $c.status.type.shortDetail,
      teams: [$c.competitors[] | {
        side: .homeAway, abbr: .team.abbreviation, name: .team.shortDisplayName, score, winner: (.winner // false),
        logo: ((.team.logo // "") | sub(".*/"; "") | if test("^[a-z0-9]+[.]png$") then . else "" end)
      }]
    }] | unique_by(.id) | sort_by(.at)'
  """) every 5m json timeout 60s

  // Standings by conference, in seed order, with each team's logo fetched once
  // into ~/.cache/espn-logos, at 96 px, and left there.
  source table = cmd("""
    d=~/.cache/espn-logos/nba
    mkdir -p "$d"
    t=$(curl -fsm 20 --compressed https://site.api.espn.com/apis/v2/sports/basketball/nba/standings | jq -c '[.children[] | {
      name: .abbreviation, teams: [.standings.entries[] | (reduce .stats[] as $s ({}; .[$s.name] = $s)) as $st | {
        id: .team.id, abbr: .team.abbreviation, name: .team.shortDisplayName,
        logo: ((.team.logos[0].href // "") | sub(".*/"; "") | if test("^[a-z0-9]+[.]png$") then . else "" end),
        seed: ($st.playoffSeed.value // 99 | floor), rec: ($st.overall.displayValue // "" | split(", ")[0]),
        b: $st.gamesBehind.displayValue
      }] | sort_by(.seed)
    }]') || exit 1
    for f in $(printf '%s' "$t" | jq -r '.[].teams[].logo | select(. != "")'); do
      [ -s "$d/$f" ] || curl -fsm 15 -o "$d/$f" "https://a.espncdn.com/combiner/i?img=/i/teamlogos/nba/500/$f&w=96&h=96" || rm -f "$d/$f"
    done
    printf '%s\n' "$t"
  """) every 30m json timeout 120s
  source now = clock every 1m

  // The screen's tab on a phone: scores or standings. Side by side on a wide screen.
  state view = "scores"

  // Each game with its two sides picked out, away first as ESPN lists them.
  let all = (games ?? []).map(g => {id: g.id, at: g.at, state: g.state, detail: g.detail, teams: g.teams,
    away: g.teams.find(t => t.side == 'away') ?? g.teams[1], home: g.teams.find(t => t.side == 'home') ?? g.teams[0]})
  let live = all.filter(g => g.state == 'in')
  let done = all.filter(g => g.state == 'post').reverse()
  let next = all.filter(g => g.state == 'pre')
  let picked = flatten([live, done.take(4), next])
  let top = picked[0]
  let groups = table ?? []
  let tileWide = (tileWidth ?? 0) >= 280
  let twoCols = (screenWidth ?? 0) > 600
  // A line under the last playoff seed, and under the play-in.
  let cuts = [6, 10]

  component Badge(logo, px = 18) {
    if logo {
      Image { src: "~/.cache/espn-logos/nba/${logo}"; size: px; fit: contain }
    } else {
      Box { size: px }
    }
  }

  // One game on one line, for the tile: away on the left, at home on the right; the centre keeps one
  // width so the logos and names line up down the list.
  component GameRow(g) {
    let away = g.away
    let home = g.home
    let live = g.state == 'in'
    let final = g.state == 'post'
    let px = tileWide ? 18 : 14
    let scW = tileWide ? 30 : 24
    let dotW = tileWide ? 8 : 6
    let stW = tileWide ? 104 : 40
    let ctrW = 2 * scW + 2 * dotW + stW

    Row {
      gap: tileWide ? 8 : 4
      align: center
      Badge { logo: away.logo; px: px }
      Text { text: tileWide ? away.name : away.abbr; style: small; weight: 1; maxLines: 1; color: final && !away.winner ? muted : foreground }
      if g.state == 'pre' {
        Text { text: fmtTime(g.at, tileWide ? "EEE HH:mm" : "HH:mm"); style: small; width: ctrW; align: center; color: muted; maxLines: 1 }
      } else {
        Row {
          width: ctrW; gap: 0; align: center
          Text { text: away.score ?? '–'; style: small; width: scW; align: end; bold: final && away.winner; color: live ? accent : final && !away.winner ? muted : foreground; maxLines: 1 }
          Box { width: dotW; height: 5; radius: 2.5; background: live ? accent : transparent }
          Text { text: g.detail; style: small; width: stW; align: center; color: live ? accent : muted; maxLines: 1 }
          Box { width: dotW }
          Text { text: home.score ?? '–'; style: small; width: scW; align: start; bold: final && home.winner; color: live ? accent : final && !home.winner ? muted : foreground; maxLines: 1 }
        }
      }
      Text { text: tileWide ? home.name : home.abbr; style: small; weight: 1; maxLines: 1; align: end; color: final && !home.winner ? muted : foreground }
      Badge { logo: home.logo; px: px }
    }
  }

  // One side of a game in the screen: logo, team, score.
  component Side(t, g) {
    Row {
      gap: 12
      align: center
      Badge { logo: t.logo; px: 24 }
      Text { text: t.name; fontSize: 16; weight: 1; maxLines: 1; color: g.state == 'post' && !t.winner ? muted : foreground }
      Text { text: g.state == 'pre' ? "" : t.score ?? "–"; fontSize: 16; bold: g.state == 'post' && t.winner; color: g.state == 'in' ? accent : g.state == 'post' && !t.winner ? muted : foreground; width: 44; align: end; maxLines: 1 }
    }
  }

  // A game as Google lists one: both sides stacked, and where it stands beside them.
  component Game(g) {
    Row {
      gap: 16
      align: center
      padding: [20, 14]
      Column {
        gap: 8
        weight: 1
        Side { t: g.away; g: g }
        Side { t: g.home; g: g }
      }
      Spacer { width: 1; height: 44; background: border }
      Text { text: g.state == 'pre' ? fmtTime(g.at, "EEE HH:mm") : g.detail; fontSize: 14; color: g.state == 'in' ? accent : muted; width: 76; maxLines: 2 }
    }
  }

  component Section(name, list) {
    Column {
      gap: 12
      visible: count(list) > 0
      Text { text: name; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface; radius: 28; clip: true
        for g, i in list key g.id {
          Spacer { height: 1; fill: width; background: border; visible: i > 0 }
          Game { g: g }
        }
      }
    }
  }

  component Scores() {
    Column {
      gap: 12
      if count(all) == 0 {
        Text { text: games == null ? "Loading…" : "No games yesterday, today or tomorrow."; fontSize: 16; color: muted; background: surface; radius: 28; padding: [20, 16] }
      }
      Section { name: "Live"; list: live }
      Section { name: "Coming up"; list: next }
      Section { name: "Final"; list: done }
    }
  }

  component Standings() {
    Column {
      gap: 12
      if count(groups) == 0 {
        Text { text: table == null ? "Loading…" : "No standings yet."; fontSize: 16; color: muted; background: surface; radius: 28; padding: [20, 16] }
      }
      for grp in groups {
        Row {
          gap: 12
          padding: [4, 8, 20, 0]
          Text { text: grp.name; fontSize: 14; bold: true; color: accent; weight: 1; maxLines: 1 }
          Text { text: "W-L"; fontSize: 14; color: muted; width: 56; align: end }
          Text { text: "GB"; fontSize: 14; color: muted; width: 36; align: end }
        }
        Column {
          gap: 0
          background: surface; radius: 28; clip: true
          for t, i in grp.teams key t.id {
            // The playoff and play-in cut lines in the accent, other rows split by a hairline.
            Spacer { height: 1; fill: width; background: cuts.contains(i) ? accent : border; visible: i > 0 }
            Row {
              gap: 12
              align: center
              padding: [20, 12]
              Text { text: t.seed < 99 ? t.seed : '–'; fontSize: 14; color: muted; width: 20; align: end; maxLines: 1 }
              Badge { logo: t.logo; px: 24 }
              Text { text: t.name; fontSize: 16; weight: 1; maxLines: 1 }
              Text { text: t.rec; fontSize: 16; bold: true; width: 56; align: end; maxLines: 1 }
              Text { text: t.b ?? '–'; fontSize: 14; color: muted; width: 36; align: end; maxLines: 1 }
            }
          }
        }
      }
    }
  }

  onTap: screen()

  // The tile: the game that matters most (live, else last night's), big, then the rest as rows allow.
  Column {
    gap: 2
    fill: true
    Row {
      align: center
      Text { text: "NBA"; style: label; color: muted; weight: 1; maxLines: 1 }
      Text { text: count(live) > 0 ? "${count(live)} LIVE" : upper(fmtTime(now, "EEE d")); style: label; color: count(live) > 0 ? accent : muted; maxLines: 1; width: 64; align: end }
    }
    if top == null {
      Text { text: games == null ? null : "No games"; fontSize: 32; maxLines: 1 }
      Text { text: "Nothing yesterday, today or tomorrow"; style: small; color: muted; maxLines: 1; visible: games != null }
    } else {
      for t in [top.away, top.home] {
        Row {
          gap: 8
          align: center
          Badge { logo: t.logo; px: 24 }
          Text { text: tileWide ? t.name : t.abbr; fontSize: 20; weight: 1; maxLines: 1; color: top.state == 'post' && !t.winner ? muted : foreground }
          Text { text: top.state == 'pre' ? "" : t.score ?? "–"; fontSize: 24; bold: true; maxLines: 1; color: top.state == 'in' ? accent : top.state == 'post' && !t.winner ? muted : foreground }
        }
      }
      Text { text: top.state == 'pre' ? "Tip-off ${fmtTime(top.at, "EEE HH:mm")}" : top.detail; style: small; color: top.state == 'in' ? accent : muted; maxLines: 1 }
    }
    Spacer { weight: 1 }
    Column {
      gap: 4
      for g in picked.drop(1).take(max((rows ?? 4) * 3 - 7, 0)) key g.id { GameRow { g: g } }
    }
  }

  screen {
    title: "NBA"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      Column {
        gap: 0
        Text { text: games == null ? "…" : count(live) > 0 ? "${count(live)} live" : count(next) > 0 ? fmtTime(next[0].at, "HH:mm") : "No games"; fontSize: 48; bold: true; maxLines: 1; color: count(live) > 0 ? accent : foreground }
        Text {
          text: count(live) > 0 ? "On now · ${count(done)} final, ${count(next)} to come" : count(next) > 0 ? "Next tip-off, ${next[0].away.name} at ${next[0].home.name}, ${fmtTime(next[0].at, "EEEE")}" : "Scores from yesterday to tomorrow, and the standings"
          fontSize: 16; color: muted; maxLines: 2
        }
      }
      if twoCols {
        Row {
          gap: 24
          Scores { weight: 1 }
          Standings { weight: 1 }
        }
      } else {
        // Tabs, the picked one tonal.
        Row {
          gap: 8
          Text { text: "Scores"; fontSize: 16; weight: 1; align: center; maxLines: 1; radius: 20; padding: [0, 10]; background: view == "scores" ? mix(surface, accent, 0.22) : surface; onTap: view = "scores" }
          Text { text: "Standings"; fontSize: 16; weight: 1; align: center; maxLines: 1; radius: 20; padding: [0, 10]; background: view == "standings" ? mix(surface, accent, 0.22) : surface; onTap: view = "standings" }
        }
        if view == "scores" { Scores { } } else { Standings { } }
      }
    }
  }
}
