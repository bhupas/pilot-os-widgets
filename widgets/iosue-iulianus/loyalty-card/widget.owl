widget "loyalty card" {
  meta { description: "Any store or loyalty card as a scannable EAN-13 barcode. Tap to name it, enter its number and pick the store's app"; version: "1.3"; license: "MIT"; category: "productivity"; owl: 9 }
  requires { pacman: [] }
  size: 6x3
  minSize: 4x2
  // The barcode opens the store's app when one is set; the rest of the tile opens the screen.
  onTap: screen()

  // The card, kept by the launcher. Nothing personal lives in this file.
  state name = "" persist
  state code = "" persist
  state app = "" persist
  // What's being typed on the screen; null means unchanged.
  state draftName = null
  state draftCode = null
  state draftApp = null
  // The card's form is open.
  state editing = false

  // EAN-13: the first digit picks L/G parity for the left six, the right six use R.
  let tableL = ["0001101", "0011001", "0010011", "0111101", "0100011", "0110001", "0101111", "0111011", "0110111", "0001011"]
  let tableG = ["0100111", "0110011", "0011011", "0100001", "0011101", "0111001", "0000101", "0010001", "0001001", "0010111"]
  let tableR = ["1110010", "1100110", "1101100", "1000010", "1011100", "1001110", "1010000", "1000100", "1001000", "1110100"]
  let parity = ["LLLLLL", "LLGLGG", "LLGGLG", "LLGGGL", "LGLLGG", "LGGLLG", "LGGGLL", "LGLGLG", "LGLGGL", "LGGLGL"]

  // The saved card as 95 modules (1 = bar).
  let card = str(code ?? "")
  let hasCard = len(card) == 13
  let digits = range(13).map(i => num(sub(card, i, i + 1), 0))
  let shape = parity[digits[0]]
  let left = range(6).map(i => sub(shape, i, i + 1) == "L" ? tableL[digits[i + 1]] : tableG[digits[i + 1]])
  let right = range(7, 13).map(i => tableR[digits[i]])
  let bits = "101" + join(left, "") + "01010" + join(right, "") + "101"
  let title = trim(str(name ?? "")) == "" ? "loyalty card" : lower(name)

  // Checking what's typed: 13 digits must match their check digit. 12 digits are a UPC-A
  // (EAN-13 with a leading 0) when that checks out, else an EAN-13 missing its check digit.
  let typed = replace(replace(str(draftCode ?? code ?? ""), " ", ""), "-", "")
  let allDigits = match(typed, "^[0-9]{12,13}$") != null
  let padded = "0" + typed
  let upcSum = sum(range(12).map(i => num(sub(padded, i, i + 1), 0) * (i % 2 == 0 ? 1 : 3)))
  let isUpc = len(typed) == 12 && (10 - upcSum % 10) % 10 == num(sub(typed, 11, 12), -1)
  let checkSum = sum(range(12).map(i => num(sub(typed, i, i + 1), 0) * (i % 2 == 0 ? 1 : 3)))
  let full = isUpc ? padded : len(typed) == 12 ? typed + str((10 - checkSum % 10) % 10) : typed
  let fullSum = sum(range(12).map(i => num(sub(full, i, i + 1), 0) * (i % 2 == 0 ? 1 : 3)))
  let valid = allDigits && num(sub(full, 12, 13), -1) == (10 - fullSum % 10) % 10
  let problem = typed == "" ? "" : !allDigits ? "Enter 12 or 13 digits" : valid ? "" : "The check digit doesn't match; mistyped?"

  // An Android package name like com.example.app, or nothing.
  let hasApp = trim(str(app ?? "")) != ""
  let typedApp = trim(str(draftApp ?? app ?? ""))
  let appOk = typedApp == "" || match(typedApp, "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)+$") != null
  let appProblem = appOk ? "" : "That doesn't look like a package name (com.example.app)"

  component Barcode(modules) {
    Box {
      fill: true
      background: #ffffff
      border: 1
      borderColor: border
      radius: 12
      clip: true
      Canvas {
        // Black on white whatever the theme, with the 9-module quiet zones EAN-13 asks for.
        let quiet = 9
        let m = width / (95 + 2 * quiet)
        let top = height * 0.12
        let barH = height * 0.76
        // One rect per bar (not per module), so wide bars have no seams.
        let mods = range(95).map(i => sub(modules, i, i + 1))
        for i in range(95) {
          if mods[i] == "1" && (i == 0 || mods[i - 1] == "0") {
            rect((quiet + i) * m, top, indexOf(mods.drop(i).take(4) + ["0"], "0") * m, barH, fill: #000000)
          }
        }
      }
    }
  }

  Column {
    gap: 6
    fill: true
    Row {
      align: center
      Text { text: upper(title); style: label; color: muted; weight: 1; maxLines: 1 }
      if hasCard {
        Text { text: card; font: mono; style: label; color: accent; width: 120; align: end; maxLines: 1 }
      }
    }
    if hasCard {
      if hasApp {
        Box { weight: 1; fill: width; onTap: androidApp(app); Barcode { modules: bits } }
      } else {
        Barcode { modules: bits; weight: 1 }
      }
    } else {
      Text { text: "No card"; fontSize: 40; maxLines: 1 }
      Text { text: "Tap to add its EAN-13 number"; style: small; color: muted; maxLines: 1 }
    }
  }

  component Item(label, value) {
    Row {
      gap: 16
      align: center
      padding: [20, 14]
      Text { text: label; fontSize: 16; maxLines: 1 }
      Text { text: value; fontSize: 16; color: muted; align: end; weight: 1; maxLines: 1 }
      Text { text: "›"; fontSize: 18; color: muted }
    }
  }

  screen {
    title: title
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      if hasCard {
        // The barcode first and large, to hold up to the scanner at the till.
        Barcode { modules: bits; height: 200 }
        Text { text: card; fontSize: 24; font: mono; align: center; fill: width; maxLines: 1 }
        Text { text: "Card"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
        Column {
          gap: 0
          background: surface
          radius: 28
          clip: true
          onTap: { draftName = null; draftCode = null; draftApp = null; editing = true }
          Item { label: "Name"; value: trim(str(name ?? "")) == "" ? "None" : name }
          Spacer { height: 1; fill: width; background: border }
          Item { label: "Number"; value: card }
          Spacer { height: 1; fill: width; background: border }
          Item { label: "Store app"; value: hasApp ? app : "None" }
        }
        if hasApp {
          Text { text: "Open the store's app"; fontSize: 16; bold: true; align: center; fill: width; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 14]; onTap: androidApp(app) }
        }
      } else {
        Column {
          gap: 0
          Text { text: "No card yet"; fontSize: 48; bold: true; maxLines: 1 }
          Text { text: "Add its EAN-13 number to carry it as a barcode you can scan."; fontSize: 16; color: muted }
        }
        Text { text: "Add a card"; fontSize: 16; bold: true; align: center; fill: width; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 14]; onTap: { draftName = null; draftCode = null; draftApp = null; editing = true } }
      }

      // The card's form: its name, number and the store's app.
      if editing {
        Sheet {
          title: hasCard ? "Edit card" : "New card"
          onDismiss: { editing = false; draftCode = null; draftName = null; draftApp = null }
          Column {
            gap: 12
            padding: [0, 4, 0, 4]
            Text { text: "Name"; fontSize: 14; color: muted }
            Input { text: name; placeholder: "My supermarket"; focus: editing; onChange: draftName = value }
            Text { text: "EAN-13 number"; fontSize: 14; color: muted }
            Input { text: code; placeholder: "The digits under the barcode"; keyboard: "number"; onChange: draftCode = value }
            Text { text: problem; fontSize: 14; color: red; visible: problem != "" }
            Text { text: "Store app (optional)"; fontSize: 14; color: muted }
            Input { text: app; placeholder: "Package name, like com.example.store"; onChange: draftApp = value }
            Text { text: appProblem != "" ? appProblem : "Tapping the barcode opens it; find it after id= in the app's Play Store link"; fontSize: 14; color: appProblem != "" ? red : muted }
            Row {
              gap: 8
              align: center
              if hasCard {
                Text { text: "Delete"; fontSize: 15; color: red; maxLines: 1; padding: [8, 12]; onTap: { code = ""; name = ""; app = ""; draftCode = null; draftName = null; draftApp = null; editing = false } }
              }
              Spacer { weight: 1 }
              Text { text: "Cancel"; fontSize: 15; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 12]; onTap: { editing = false; draftCode = null; draftName = null; draftApp = null } }
              Text {
                text: "Save"; fontSize: 15; bold: true; maxLines: 1; radius: 24; padding: [24, 12]
                background: valid && appOk ? accent : mix(surface, accent, 0.22); color: valid && appOk ? background : muted
                onTap: { if valid && appOk { code = full; name = trim(str(draftName ?? name)); app = typedApp; draftCode = null; draftName = null; draftApp = null; editing = false } }
              }
            }
          }
        }
      }
    }
  }
}
