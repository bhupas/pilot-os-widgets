widget "digital clock" {
  page: 1
  order: 3
  size: 3x1
  minSize: 2x1
  padding: [12, 2]
  meta { owl: 9; description: "Clean 12h digital clock; tap opens your clock app"; version: "1.8"; license: "MIT"; category: "time" }

  source now = clock every 1s
  source dev = android.device
  state clockPkg = "" persist
  state draft = ""
  state typing = false            // the sheet for another clock app's package is open
  onTap: screen()

  let stack = (tileWidth ?? 400) < (tileHeight ?? 100) && (cols ?? 6) <= 2
  let fsWide = clamp(round(min((tileHeight ?? 100) / 2.2, (tileWidth ?? 400) / 6.5)), 16, 72)
  let fsTiny = clamp(round(min((tileHeight ?? 100) / 2.2, (tileWidth ?? 200) / 5)), 14, 72)
  let amWide = round(fsWide * 0.45)
  let timeW = round(fsWide * 3.2)
  let amW = round(amWide * 2.2)
  let t = fmtTime(now, "h:mm")
  let ap = fmtTime(now, "a")
  let tiny = (cols ?? 6) <= 2 && (rows ?? 1) <= 2
  let n = (len(t) ?? 5) + (tiny ? 0 : (len(ap) ?? 2))
  let fsStack = clamp(round(min((tileHeight ?? 400) / (n * 1.65 + 1), (tileWidth ?? 200) / 1.8)), 10, 48)
  // Two rows or more: the day above the time and the date under it, as every tile reads.
  let roomy = (rows ?? 1) >= 2 && !stack && !tiny
  let fsRoomy = clamp(round(min(((tileHeight ?? 130) - 36) / 1.25, ((tileWidth ?? 190) - 24) / 3.2)), 16, 72)
  let maker = lower(dev.maker ?? "")
  let model = lower(dev.model ?? "")
  let guess = contains(maker, "samsung") ? "com.sec.android.app.clockpackage" : contains(maker, "google") || contains(model, "pixel") ? "com.google.android.deskclock" : contains(maker, "xiaomi") || contains(maker, "redmi") || contains(maker, "poco") ? "com.android.deskclock" : contains(maker, "motorola") || contains(maker, "moto") ? "com.motorola.cn.deskclock" : ""
  let effective = clockPkg == "" ? guess : clockPkg
  let apps = [
    {name: "Samsung", pkg: "com.sec.android.app.clockpackage"},
    {name: "Google / Pixel", pkg: "com.google.android.deskclock"},
    {name: "Xiaomi / AOSP", pkg: "com.android.deskclock"},
    {name: "Motorola", pkg: "com.motorola.cn.deskclock"},
  ]
  let custom = clockPkg != "" && apps.find(a => a.pkg == clockPkg) == null

  Box {
    fill: true
    if effective != "" {
      Box { fill: true; onTap: androidApp(effective) }
    }
  Column {
    fill: true
    align: center
    justify: center
    if stack {
      Column {
        gap: 0
        scroll: true
        align: center
        justify: center
        for i in range(len(t) ?? 0) {
          Text { text: sub(t, i, i + 1); fontSize: fsStack; align: center; maxLines: 1 }
        }
        if !tiny {
          for i in range(len(ap) ?? 0) {
            Text { text: sub(ap, i, i + 1); fontSize: round(fsStack * 0.7); color: muted; align: center; maxLines: 1; onTap: screen() }
          }
        }
      }
    } else if roomy {
      Column {
        gap: 2
        fill: width
        Text { text: upper(fmtTime(now, "EEEE")); style: label; color: muted; maxLines: 1; onTap: screen() }
        Text { text: t; fontSize: fsRoomy; maxLines: 1 }
        Text { text: "${ap} · ${fmtTime(now, "d MMMM")}"; style: small; color: muted; maxLines: 1; onTap: screen() }
      }
    } else {
      if tiny {
        Text { text: fmtTime(now, "h:mm"); fontSize: fsTiny; align: center; maxLines: 1 }
      } else {
        Row {
          gap: 8
          fill: width
          align: center
          justify: center
          Text { text: fmtTime(now, "h:mm"); fontSize: fsWide; width: timeW; align: end; maxLines: 1 }
          Text { text: fmtTime(now, "a"); fontSize: amWide; color: muted; width: amW; align: start; maxLines: 1; onTap: screen() }
        }
      }
    }
  }
  }

  // A choice in the clock app list: a radio, its name and what it is.
  component Choice(name, note, on) {
    Row {
      gap: 16
      align: center
      Box {
        size: 20; radius: 10; align: center; border: 2; borderColor: on ? accent : muted
        Spacer { size: 10; radius: 5; background: on ? accent : transparent }
      }
      Column {
        gap: 0
        weight: 1
        Text { text: name; fontSize: 16; maxLines: 1 }
        Text { text: note; fontSize: 14; color: muted; maxLines: 1 }
      }
    }
  }

  // The app: the time, and which clock app a tap on the tile opens.
  screen {
    title: "digital clock"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      Column {
        gap: 0
        Text { text: "${t} ${ap}"; fontSize: 48; bold: true; maxLines: 1 }
        Text { text: fmtTime(now, "EEEE d MMMM"); fontSize: 16; color: muted; maxLines: 1 }
      }
      if effective != "" {
        Text { text: "Open the clock app"; fontSize: 16; bold: true; maxLines: 1; align: center; fill: width; background: accent; color: background; radius: 24; padding: [24, 14]; onTap: { androidApp(effective); close() } }
      }
      Text { text: "Clock app"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        Box {
          padding: [20, 14]
          onTap: clockPkg = ""
          Choice { name: "Automatic"; note: guess == "" ? "Not known for this phone" : apps.find(a => a.pkg == guess).name; on: clockPkg == "" }
        }
        for a in apps {
          Spacer { height: 1; fill: width; background: border }
          Box {
            padding: [20, 14]
            onTap: clockPkg = a.pkg
            Choice { name: a.name; note: a.pkg; on: clockPkg == a.pkg }
          }
        }
        Spacer { height: 1; fill: width; background: border }
        Box {
          padding: [20, 14]
          onTap: { draft = custom ? clockPkg : ""; typing = true }
          Choice { name: "Another app"; note: custom ? clockPkg : "By its package name"; on: custom }
        }
      }
      Text { text: "Tap the time to open the clock app, and AM or PM for this screen."; fontSize: 14; color: muted; padding: [4, 0, 0, 0] }

      // Another clock app, by its package name.
      if typing {
        Sheet {
          title: "Another clock app"
          onDismiss: typing = false
          Column {
            gap: 16
            padding: [0, 4, 0, 4]
            Input {
              text: draft
              placeholder: "com.example.clock"
              focus: typing
              onChange: draft = value
              onSubmit: {
                if trim(value) != "" {
                  clockPkg = trim(value)
                }
                typing = false
              }
            }
            Text { text: "Find an app's package name with App Inspector on the Play Store."; fontSize: 14; color: muted }
            Row {
              gap: 8
              align: center
              Spacer { weight: 1 }
              Text { text: "Cancel"; fontSize: 15; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 12]; onTap: typing = false }
              Text {
                text: "Save"; fontSize: 15; bold: true; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 12]
                onTap: {
                  if trim(draft) != "" {
                    clockPkg = trim(draft)
                  }
                  typing = false
                }
              }
            }
          }
        }
      }
    }
  }
}
