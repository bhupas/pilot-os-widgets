widget "claude top" {
  size: 6x3
  minSize: 3x2

  meta { owl: 9; description: "htop for Claude Code: every running instance with its status, folder, window, CPU and memory. Tap for details, the last prompt and kill"; version: "1.1"; license: "MIT"; category: "dev" }
  requires { pacman: ["jq", "procps-ng"] }

  // Claude Code registers each running instance in ~/.claude/sessions/<pid>.json (name, folder,
  // busy/idle). This adds CPU over one second, memory, the window it runs in (the foot terminal's
  // app id, found up the parent chain) and the last prompt typed into it.
  source ps = cmd("""
    pids=$(pgrep -x claude)
    [ -n "$pids" ] || { echo '[]'; exit 0; }
    t1=""; for p in $pids; do t1="$t1 $(awk '{print $14+$15}' /proc/$p/stat 2>/dev/null || echo 0)"; done
    sleep 1
    set -- $t1
    hz=$(getconf CLK_TCK)
    home=$(getent passwd "$(id -u)" | cut -d: -f6)
    for p in $pids; do
      a=$1; shift
      b=$(awk '{print $14+$15}' /proc/$p/stat 2>/dev/null) || continue
      read rss et tty <<<"$(ps -o rss=,etimes=,tty= -p "$p")"
      where=""; q=$p
      for i in 1 2 3 4 5 6; do
        q=$(awk '{print $4}' /proc/$q/stat 2>/dev/null)
        [ -n "$q" ] && [ "$q" -gt 1 ] || break
        c=$(tr '\0' ' ' </proc/$q/cmdline 2>/dev/null)
        case $c in foot*--app-id=*) where=${c#*--app-id=}; where=${where%% *}; break ;; esac
      done
      f=~/.claude/sessions/$p.json; [ -f "$f" ] || f=/dev/null
      sid=$(jq -r '.sessionId // empty' "$f" 2>/dev/null)
      last=""; [ -n "$sid" ] && last=$(tac ~/.claude/history.jsonl 2>/dev/null | grep -m1 -F "\"sessionId\":\"$sid\"" | jq -r '.display // empty' | head -c 200)
      jq -n -c --argjson pid "$p" --argjson cpu "$(( (b - a) * 100 / hz ))" --argjson rss "${rss:-0}" --argjson up "${et:-0}" \
        --arg home "$home" --arg tty "$tty" --arg where "$where" --arg last "$last" --arg cwd "$(readlink /proc/$p/cwd)" \
        --slurpfile s <(cat "$f" 2>/dev/null || true) \
        '($s[0] // {}) as $s | {pid: $pid, cpu: $cpu, mem: ($rss * 1024), up: $up, tty: $tty, where: $where, last: $last,
          sid: ($s.sessionId // ""), name: ($s.name // "claude"), status: ($s.status // "unknown"), cwd: ($s.cwd // $cwd),
          dir: (($s.cwd // $cwd) as $c | if $home != "" and ($c == $home or ($c | startswith($home + "/"))) then "~" + $c[($home | length):] else $c end),
          version: ($s.version // ""), since: (($s.statusUpdatedAt // 0) / 1000 | floor), started: (($s.startedAt // 0) / 1000 | floor)}'
    done | jq -s -c 'sort_by(-.started)'
  """) every 5s json timeout 20s

  source now = clock every 5s
  state confirm = 0
  // The instance open in the sheet, by pid; -1 for the sheet that closes the idle ones.
  state picked = 0

  let all = (ps ?? []).map(p => {
    pid: p.pid, cpu: p.cpu, mem: p.mem, up: p.up, last: p.last, sid: p.sid, name: p.name, status: p.status,
    cwd: p.cwd, version: p.version, since: p.since,
    dir: p.dir,
    where: startsWith(p.where, "omarchy.tile") ? "home tile" : p.where == "omarchy.claude-new-widget" ? "widget agent" : startsWith(p.where, "omarchy.") ? sub(p.where, 8) : p.where != "" ? p.where : p.tty != "" && p.tty != "?" ? p.tty : "background",
    tint: p.status == "busy" ? green : p.status == "idle" ? muted : yellow
  })
  let busy = count(all, p => p.status == "busy")
  let idle = all.filter(p => p.status == "idle")
  let totalMem = sum(all.map(p => p.mem))

  onTap: screen()

  let sel = all.find(x => x.pid == picked)
  let wide = (screenWidth ?? 0) > 600
  let short = (rows ?? 3) < 3

  component Dot(tint, sz = 8) {
    Spacer { width: sz; height: sz; radius: sz / 2; background: tint }
  }

  // ---------- tile ----------
  Column {
    gap: 2
    fill: true
    Row {
      align: center
      Text { text: "CLAUDE"; style: label; color: muted; weight: 1; maxLines: 1 }
      if (cols ?? 6) >= 5 && len(all) > 0 {
        Text { text: fmtBytes(totalMem); style: label; color: muted; width: 56; align: end; maxLines: 1 }
      }
    }
    Text { text: ps == null ? null : len(all) == 0 ? "None" : "${len(all)} running"; fontSize: (cols ?? 6) >= 4 ? 40 : 30; maxLines: 1 }
    Text { text: len(all) == 0 ? "No Claude Code running" : "${busy} busy · ${len(idle)} idle"; style: small; color: busy > 0 ? accent : muted; maxLines: 1; visible: ps != null }
    Spacer { weight: 1 }
    // Then the instances, as many as fit: three at 3 rows, three more per row after that.
    for p in all.take(short ? 0 : max((rows ?? 3) * 3 - 6, 0)) key p.pid {
      Row {
        gap: 6
        align: center
        Dot { tint: p.tint }
        Text { text: p.name; style: small; weight: 1; maxLines: 1 }
        if (cols ?? 6) >= 5 {
          Text { text: p.where; style: small; color: muted; width: 96; maxLines: 1 }
        }
        Text { text: "${p.cpu}%"; style: small; color: p.cpu >= 50 ? yellow : muted; width: 40; align: end; maxLines: 1 }
        if (cols ?? 6) >= 4 {
          Text { text: fmtBytes(p.mem); style: small; color: muted; width: 48; align: end; maxLines: 1 }
        }
      }
    }
  }

  component Item(label, value) {
    Row {
      gap: 16
      align: center
      padding: [20, 14]
      Text { text: label; fontSize: 16; maxLines: 1 }
      Text { text: value; fontSize: 16; color: muted; align: end; weight: 1; maxLines: 1 }
    }
  }

  // Every instance, newest first; a tap opens it in a sheet, with its last prompt and kill.
  component Instances() {
    Column {
      gap: 12
      Text { text: "Instances"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        for p, i in all key p.pid {
          Spacer { height: 1; fill: width; background: border; visible: i > 0 }
          Row {
            gap: 16
            align: center
            padding: [20, 14]
            onTap: { picked = p.pid; confirm = 0 }
            Dot { tint: p.tint; sz: 10 }
            Column {
              gap: 0
              weight: 1
              Text { text: p.name; fontSize: 16; maxLines: 1 }
              Text { text: p.dir; fontSize: 14; font: mono; color: muted; maxLines: 1 }
              if p.last != "" {
                Text { text: "› ${p.last}"; fontSize: 14; color: muted; maxLines: 1 }
              }
            }
            Column {
              gap: 0
              width: 64
              Text { text: "${p.cpu}%"; fontSize: 16; color: p.cpu >= 50 ? yellow : foreground; align: end; maxLines: 1 }
              Text { text: fmtBytes(p.mem); fontSize: 14; color: muted; align: end; maxLines: 1 }
            }
          }
        }
        if len(all) == 0 {
          Text { text: ps == null ? "Loading…" : "No Claude Code instance is running."; fontSize: 16; color: muted; padding: [20, 16] }
        }
      }
    }
  }

  component Lead() {
    Column {
      gap: 12
      Column {
        gap: 0
        Text { text: ps == null ? "…" : "${len(all)} running"; fontSize: 48; bold: true; maxLines: 1 }
        Text { text: "${busy} busy · ${len(idle)} idle · ${fmtBytes(totalMem)}"; fontSize: 16; color: muted; maxLines: 1 }
      }
      if len(idle) > 0 {
        Row {
          Text { text: "Close ${len(idle)} idle"; fontSize: 16; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [24, 12]; onTap: picked = -1 }
        }
      }
    }
  }

  // ---------- full screen ----------
  screen {
    title: "claude top"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      if wide {
        Row {
          gap: 24
          align: top
          Lead { weight: 1 }
          Instances { weight: 1 }
        }
      } else {
        Lead { }
        Instances { }
      }

      // Closing every idle instance at once, after asking.
      if picked == -1 {
        Sheet {
          title: "Close idle instances?"
          onDismiss: picked = 0
          Column {
            gap: 16
            padding: [0, 4, 0, 4]
            Text { text: len(idle) == 0 ? "None are idle now." : "This ends ${join(idle.map(p => p.name), ", ")}."; fontSize: 16; color: muted }
            Row {
              gap: 8
              align: center
              Spacer { weight: 1 }
              Text { text: "Cancel"; fontSize: 15; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 12]; onTap: picked = 0 }
              Text { text: "Close ${len(idle)}"; fontSize: 15; bold: true; maxLines: 1; background: red; color: background; radius: 24; padding: [24, 12]; onTap: { run("for p in $(echo ${sh(join(idle.map(p => str(int(p.pid))), " "))}); do [ \"$(cat /proc/$p/comm 2>/dev/null)\" = claude ] && kill $p; done"); picked = 0 } }
            }
          }
        }
      }

      // One instance: everything known about it, and what can be done with it.
      if picked > 0 {
        Sheet {
          title: sel == null ? "Ended" : sel.name
          onDismiss: { picked = 0; confirm = 0 }
          Column {
            gap: 12
            padding: [0, 4, 0, 4]
            if sel == null {
              Text { text: "This instance isn't running any more."; fontSize: 16; color: muted }
            } else {
              Column {
                gap: 0
                background: surface
                radius: 28
                clip: true
                Item { label: "Status"; value: sel.since > 0 ? "${sel.status} ${fmtDuration(max(0, now - sel.since))}" : sel.status }
                Spacer { height: 1; fill: width; background: border }
                Item { label: "Window"; value: sel.where }
                Spacer { height: 1; fill: width; background: border }
                Item { label: "Running for"; value: fmtDuration(sel.up) }
                Spacer { height: 1; fill: width; background: border }
                Item { label: "CPU · memory"; value: "${sel.cpu}% · ${fmtBytes(sel.mem)}" }
                Spacer { height: 1; fill: width; background: border }
                Item { label: "PID"; value: "${sel.pid}" }
              }
              Text { text: sel.dir; fontSize: 14; font: mono; color: muted; maxLines: 2; padding: [8, 0, 8, 0] }
              if sel.last != "" {
                Text { text: "› ${sel.last}"; fontSize: 15; italic: true; maxLines: 4; padding: [8, 0, 8, 0] }
              }
            }
            Row {
              gap: 8
              align: center
              if sel != null {
                Text {
                  text: confirm == sel.pid ? "Kill it?" : "Kill"; fontSize: 15; bold: confirm == sel.pid; color: red; maxLines: 1; padding: [8, 12]
                  onTap: {
                    if confirm == sel.pid {
                      run("p=${int(sel.pid)}; [ \"$(cat /proc/$p/comm 2>/dev/null)\" = claude ] && kill $p")
                      confirm = 0
                      picked = 0
                    } else {
                      confirm = sel.pid
                    }
                  }
                }
              }
              Spacer { weight: 1 }
              if sel != null && sel.sid != "" {
                Text { text: "Copy resume"; fontSize: 15; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 12]; onTap: copy("cd ${sh(sel.cwd)} && claude --resume ${sh(sel.sid)}") }
              }
              Text { text: "Done"; fontSize: 15; bold: true; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 12]; onTap: { picked = 0; confirm = 0 } }
            }
          }
        }
      }
    }
  }
}
