widget "nostr" {
  size: 3x3
  minSize: 3x2
  meta { description: "Your nostr inbox: new zaps, replies, mentions, reactions and reposts. Enter any npub or NIP-05 address; tap for the full list"; version: "1.2"; license: "MIT"; category: "news"; owl: 9 }
  requires { pacman: ["websocat", "jq", "curl"] }

  state who = "" persist          // the npub, nprofile, hex key or NIP-05 address entered
  state seen = 0 persist          // everything after this time is new
  state alerts = true persist     // notify on new zaps
  state tab = "all"
  state amberAt = 0               // when Amber was last asked to decrypt the mute list (NIP-46)
  state editingWho = false        // the account sheet is open
  state draft = ""                // the account, as typed there
  source now = clock every 1m

  // Only these characters reach the shell.
  let id = lower(trim(who))
  let valid = id != "" && match(id, "^[a-z0-9@._-]+$") != null

  // Finds the user's key and inbox relays (NIP-65), then the last week's zaps, notes, reactions
  // and reposts that tag them, with the names of who sent them. Reads only public data; no keys needed.
  source inbox = cmd('id=' + sh(valid ? id : "") + ';' + '
# Prints the nostr inbox of $id (npub, nprofile, hex or NIP-05) as one line of JSON.
[ -z "$id" ] && { echo null; exit 0; }
umask 077
# A work dir, removed on exit or when killed by the widget timeout; ones left by a hard kill go after an hour.
find /tmp -maxdepth 3 -path "/tmp/nostr-inbox.*" -mmin +60 -delete 2> /dev/null
t=$(mktemp -d /tmp/nostr-inbox.XXXXXX)
trap "rm -f $t/*/* $t/* 2> /dev/null; rmdir $t/* $t 2> /dev/null" EXIT
trap "exit 1" INT TERM
c=~/.cache/nostr-inbox; mkdir -p $c
hex() { [[ $1 =~ ^[0-9a-f]{64}$ ]]; }
# q relay filters secs: the EVENT lines one relay sends before EOSE.
q() { { printf "[\"REQ\",\"w\",%s]\n" "$2"; sleep $3; } | timeout $(($3 + 2)) websocat -E "$1" 2>/dev/null | awk "/^.\"EOSE/{exit} /^.\"EVENT/{print}"; }
# qa filters secs relays...: q on every relay at once; their well-formed events, deduplicated, as one JSON list.
qa() {
  local f=$1 s=$2 i=0 r d; shift 2; d=$(mktemp -d -p $t)
  for r in "$@"; do q "$r" "$f" $s > $d/$i & i=$((i + 1)); done; wait
  cat $d/* 2>/dev/null | jq -sc "map(.[2] | select(type == \"object\" and (.id | strings | test(\"^[0-9a-f]{64}$\")) and (.pubkey | strings | test(\"^[0-9a-f]{64}$\")) and (.created_at | numbers) and (.kind | numbers) and (.tags | arrays))) | unique_by(.id)"
  rm -f $d/*; rmdir $d
}
# vf file kinds: drops events of these kinds whose id or signature is wrong (when nak is installed).
vf() {
  command -v nak > /dev/null || return 0
  local e
  jq -c --argjson k "$2" ".[] | select(.kind | IN(\$k[]))" $1 | while read -r e; do printf "%s\n" "$e" | nak verify > /dev/null 2>&1 && printf "%s\n" "$e"; done | jq -sc . > $1.ok
  jq -c --argjson k "$2" --slurpfile ok $1.ok "map(select(.kind | IN(\$k[]) | not)) + \$ok[0]" $1 > $1.new && mv $1.new $1; rm -f $1.ok
}
boot="wss://purplepag.es wss://relay.damus.io wss://nos.lol wss://relay.primal.net"

case $id in
  npub1* | nprofile1*)
    if command -v nak > /dev/null; then
      pk=$(cat "$c/id-$id" 2>/dev/null) && hex "$pk" || { pk=$(nak decode "$id" < /dev/null 2>/dev/null | jq -rR "fromjson? // . | if type == \"object\" then .pubkey else . end"); hex "$pk" && printf %s "$pk" > "$c/id-$id"; }
    else
      pk=$(printf %s "$id" | jq -Rr --arg cs qpzry9x8gf2tvdw0s3jn54khce6mua7l \'
      def hex: . as $n | "0123456789abcdef" as $h | $h[($n / 16 | floor):($n / 16 | floor) + 1] + $h[($n % 16):($n % 16) + 1];
      (if startswith("nprofile") then 2 else 0 end) as $skip
      | split("1") | last | .[0:-6] | split("")
      | [.[] as $ch | $cs | index($ch)]
      | map([range(4; -1; -1) as $i | (. / pow(2; $i) | floor) % 2]) | flatten
      | . as $b | [range(0; length / 8 | floor) | $b[. * 8:. * 8 + 8] | reduce .[] as $x (0; . * 2 + $x)]
      | .[$skip:$skip + 32] | map(hex) | join("")
\'
      )
    fi ;;
  *.*)
    # NIP-05, remembered so a failed lookup does not lose the account.
    name=${id%@*}; dom=${id#*@}; [ "$name" = "$id" ] && name=_
    pk=$(curl -sf -m 8 "https://$dom/.well-known/nostr.json?name=$name" | jq -r --arg n "$name" ".names // {} | with_entries(.key |= ascii_downcase) | .[\$n] | strings | ascii_downcase")
    if hex "$pk"; then printf %s "$pk" > "$c/nip05-$id"; else pk=$(cat "$c/nip05-$id" 2>/dev/null); fi ;;
  *) pk=$id ;;
esac
if ! hex "$pk"; then
  jq -nc --arg id "$id" "{error: (if (\$id | contains(\".\")) then \"no nostr user at \" + \$id else \"not a valid npub\" end)}"
  exit 0
fi

# The profile and relay list (NIP-65), cached for a day once found.
if [ -n "$(find $c/$pk.json -mmin -1440 2>/dev/null)" ]; then
  me=$(cat $c/$pk.json)
else
  qa "{\"kinds\":[0,10002],\"authors\":[\"$pk\"]}" 4 $boot > $t/me.json
  vf $t/me.json "[0,10002]"
  me=$(jq -c --arg pk "$pk" "
    map(select(.pubkey == \$pk)) as \$ev
    | (\$ev | map(select(.kind == 0)) | max_by(.created_at) | .content | strings | fromjson? | objects) as \$p
    | (\$ev | map(select(.kind == 10002)) | max_by(.created_at) | .tags // [] | map(select(.[0] == \"r\" and (.[1] | strings | startswith(\"wss://\"))))) as \$r
    | {name: ([\$p.display_name, \$p.name] | map(strings | select(. != \"\")) | first),
       relays: [\$r[] | select(.[2] == null or .[2] == \"read\") | .[1] | rtrimstr(\"/\")] | .[0:4],
       outbox: [\$r[] | select(.[2] == null or .[2] == \"write\") | .[1] | rtrimstr(\"/\")] | .[0:4]}" $t/me.json)
  printf %s "$me" | jq -e ".name != null or (.relays | length) > 0" > /dev/null 2>&1 && printf %s "$me" > $c/$pk.json
fi
[ -z "$me" ] && me="{}"
# Their own relays first, then well-connected defaults; order kept, duplicates dropped.
pick() { printf %s "$me" | jq -r "$1 + [\"wss://relay.damus.io\", \"wss://nos.lol\", \"wss://relay.primal.net\"] | reduce .[] as \$r ([]; if index([\$r]) then . else . + [\$r] end) | .[0:6] | .[]"; }
inbox=$(pick "(.relays // [])"); outbox=$(pick "(.outbox // [])")

# Zaps, replies, mentions, reposts and reactions tagging the user, last 7 days, and the mute list (NIP-51).
since=$(($(date +%s) - 7 * 86400))
p="\"#p\":[\"$pk\"],\"since\":$since"
qa "{\"kinds\":[9735],$p,\"limit\":100},{\"kinds\":[1],$p,\"limit\":100},{\"kinds\":[7],$p,\"limit\":100},{\"kinds\":[6,16],$p,\"limit\":100}" 6 $inbox > $t/ev.json &
qa "{\"kinds\":[10000],\"authors\":[\"$pk\"]}" 4 $outbox > $t/ml.json &
wait
# Only a mute list newer than the one kept is checked (nak is slow to start on a phone).
jq -c --argjson after "$(jq ".created_at // 0" $c/$pk.mutelist.json 2>/dev/null || echo 0)" "map(select(.created_at > \$after))" $t/ml.json > $t/ml.new && mv $t/ml.new $t/ml.json
vf $t/ml.json "[10000]"

# The newest mute list seen so far is kept, so a relay that fails or lags never brings back an older one.
jq -c --arg pk "$pk" --slurpfile old <(cat $c/$pk.mutelist.json 2>/dev/null || echo null) "map(select(.kind == 10000 and .pubkey == \$pk)) + [\$old[0] | objects] | max_by(.created_at) // empty" $t/ml.json > $t/ml1.json
if [ -s $t/ml1.json ]; then mv $t/ml1.json $c/$pk.mutelist.json; fi
mid=$(jq -r ".id | strings" $c/$pk.mutelist.json 2>/dev/null)
hex "$mid" || mid=""
# Private mutes: Amber (NIP-46) decrypts this version of the list; the ciphertext is kept in a file named by its id,
# so it never becomes part of a command. Decryptions of older versions are removed.
pf=/dev/null
if [ -n "$mid" ]; then
  jq -r ".content // empty" $c/$pk.mutelist.json > $c/$pk.$mid.cipher
  for f in $c/$pk.*.mutes.json $c/$pk.*.cipher; do case $f in "$c/$pk.$mid".*) ;; *) rm -f "$f" ;; esac; done
  [ -s $c/$pk.$mid.mutes.json ] && pf=$c/$pk.$mid.mutes.json
fi
# NIP-46: a client key and secret for pairing with the signer, made only when there are private mutes to decrypt.
k=~/.config/nostr-inbox; connect=""
if command -v nak > /dev/null && [ -s "$c/$pk.$mid.cipher" ]; then
  mkdir -p $k
  [ -s $k/client.key ] || nak key generate > $k/client.key
  [ -s $k/connect.secret ] || nak key generate | cut -c1-16 > $k/connect.secret
  [ -s $k/client.pub ] || nak key public $(cat $k/client.key) > $k/client.pub
  [ -s $k/relays ] || echo wss://relay.nip46.com wss://bucket.coracle.social wss://nrs.primal.net > $k/relays
  connect="nostrconnect://$(cat $k/client.pub)?$(for r in $(cat $k/relays); do printf "relay=%s&" $(printf %s $r | jq -Rr @uri); done)secret=$(cat $k/connect.secret)&perms=nip44_decrypt%2Cnip04_decrypt&name=nostr%20inbox"
fi
jq -c --arg pk "$pk" --slurpfile priv "$pf" --slurpfile ml <(cat $c/$pk.mutelist.json 2>/dev/null || echo null) --arg mid "$mid" --arg nak "$(command -v nak)" --arg bunker "$([ -s $k/bunker ] && echo yes)" --arg connect "$connect" \'
  def tag($k): [.tags[]? | select(type == "array" and .[0] == $k) | .[1] | strings];
  def sats(b): (b // "" | capture("^lnbc(?<n>[0-9]+)(?<m>[munp]?)1")? // null) as $c
    | if $c == null then null else ($c.n | tonumber) * ({"m": 100000, "u": 100, "n": 0.1, "p": 0.0001, "": 100000000}[$c.m]) | floor end;
  ($ml[0] | objects) as $list
  | ($priv[0] | if type == "array" then map(arrays) else null end) as $pt
  | (($list.tags // []) + ($pt // [])) as $mute
  | ({tags: $mute} | [tag("p"), tag("e"), (tag("t") | map(ascii_downcase)), (tag("word") | map(ascii_downcase | select(. != "")))]) as [$mp, $me, $mt, $mw]
  | map(select(.pubkey != $pk or .kind == 9735))
  | map(select((any(tag("e")[]; IN($me[])) | not) and (any(tag("t")[] | ascii_downcase; IN($mt[])) | not)))
  | map(
    ((.content | strings) // "") as $text
    | if .kind == 9735 then
      (tag("description")[0] | fromjson? | objects // {}) as $z
      | {id, at: .created_at, type: "zap", who: ($z.pubkey | strings | select(test("^[0-9a-f]{64}$"))) // .pubkey,
         text: (($z.content | strings) // "")[0:200], ref: ((tag("e") | last) // .id), mine: true,
         sats: (sats(tag("bolt11")[0]) // ((($z | tag("amount")[0] | tonumber?) // null) | if . then ./1000 | floor else null end))}
    elif .kind == 1 then {id, at: .created_at, type: (if (tag("e") | length) > 0 then "reply" else "mention" end), who: .pubkey, text: $text[0:400], ref: .id, mine: true}
    elif .kind == 7 then {id, at: .created_at, type: "reaction", who: .pubkey, text: $text[0:40], ref: ((tag("e") | last) // .id), mine: ((tag("p") | last) == $pk)}
    else {id, at: .created_at, type: "repost", who: .pubkey, text: "", ref: ((tag("e") | last) // .id), mine: ((tag("p") | last) == $pk)} end)
  | map(select((.who | IN($mp[]) | not) and ((.text | ascii_downcase) as $c | any($mw[]; . as $w | $c | contains($w)) | not)))
  | {mutes: {id: (if $mid == "" then null else $mid end), private: (if (($list.content | strings) // "") == "" then null elif $pt == null then -1 else ($pt | length) end),
      nip04: ((($list.content | strings) // "") | contains("?iv=")), nak: ($nak != ""), bunker: ($bunker == "yes"), connect: (if $connect == "" then null else $connect end)},
    items: (group_by(.type) | map(sort_by(-.at) | .[0:100]) | add // [] | sort_by(-.at))}
\' $t/ev.json > $t/items.json

# NIP-21 links (nostr:nevent1…) so taps open in the phone nostr app; njump.me if nak is missing.
if command -v nak > /dev/null; then jq -c --arg pk "$pk" ".items[] | {id: .ref, pubkey: (if .type == \"reply\" or .type == \"mention\" then .who else \$pk end)}" $t/items.json | nak encode nevent 2> /dev/null | jq -Rsc "split(\"\n\") | map(select(. != \"\"))" > $t/nev.json; fi
[ -s $t/nev.json ] || echo "[]" > $t/nev.json

# Names of the people in it.
f=$(jq -r ".items | map(.who) | unique | .[0:200] | . as \$a | [range(0; length; 20) | {kinds: [0], authors: \$a[.:. + 20], limit: 100} | tojson] | join(\",\")" $t/items.json)
if [ -n "$f" ]; then qa "$f" 5 wss://purplepag.es wss://relay.ditto.pub wss://relay.primal.net wss://nos.lol > $t/names.json; else echo "[]" > $t/names.json; fi
jq -nc --arg pk "$pk" --argjson me "$me" --slurpfile items $t/items.json --slurpfile ps $t/names.json --slurpfile nev $t/nev.json \'
  ($ps[0] | group_by(.pubkey) | map(max_by(.created_at) | {key: .pubkey, value: (.content | strings | fromjson? | objects | [.display_name, .name] | map(strings | select(. != "")) | first)}) | from_entries) as $names
  | {pk: $pk, name: $me.name, relays: $me.relays, at: now | floor, mutes: $items[0].mutes,
     items: ($items[0].items | (length == ($nev[0] | length)) as $ok | to_entries | map(.value + {name: ($names[.value.who] // ("…" + .value.who[-8:])), nevent: (if $ok then $nev[0][.key] else null end)}))}
\'
') every 5m json timeout 60s status

  // The last good result stays up while a refresh fails (offline, relays timing out).
  state good = null
  let latest = inbox.ok && inbox.out != null && inbox.out.error == null ? inbox.out : null
  when latest != null { good = latest }
  on latest { good = value }
  let data = latest ?? good ?? (inbox.ok ? inbox.out : null)
  let items = data.items ?? []
  let fresh = items.filter(i => i.at > seen)
  let zaps = fresh.filter(i => i.type == "zap")
  let sats = sum(zaps.map(z => z.sats ?? 0))
  let talk = fresh.filter(i => i.type == "reply" || i.type == "mention")
  let likes = fresh.filter(i => i.type == "reaction" || i.type == "repost")
  let shown = (tab == "zaps" ? items.filter(i => i.type == "zap") : tab == "replies" ? items.filter(i => i.type == "reply" || i.type == "mention") : tab == "reactions" ? items.filter(i => i.type == "reaction" || i.type == "repost") : items).take(80)
  let lastZap = items.find(i => i.type == "zap")
  // Reactions: "+" or empty is a like; a :shortcode: is a custom emoji (NIP-30), drawn as a star.
  component Glyph(it, size = 14) {
    Text { text: it.type == "zap" ? "⚡" : it.type == "repost" ? "↻" : it.type != "reaction" ? "↩" : it.text == "+" || it.text == "" ? "♥" : startsWith(it.text, ":") ? "✦" : it.text; fontSize: size; color: it.type == "zap" ? yellow : it.type == "reaction" ? red : it.type == "repost" ? green : cyan; width: size + 10; align: center; maxLines: 1 }
  }
  // Files for this version of the mute list. Its id comes from relays, so it must be hex before it goes near a command.
  let mid = match(data.mutes.id ?? "", "^[0-9a-f]{64}$") != null ? data.mutes.id : null
  let muteName = "${data.pk}.${mid}.mutes.json"
  let cipherName = "${data.pk}.${mid}.cipher"
  // Zaps newer than the last notification (stored, so old zaps never notify again).
  state notifiedAt = 0 persist
  let newZaps = items.filter(i => i.type == "zap" && i.at > notifiedAt)

  // Private mutes: when the list is still encrypted and Amber is paired, ask Amber to decrypt it (NIP-46).
  when mid != null && data.mutes.private == -1 && data.mutes.bunker { run('umask 077; k=~/.config/nostr-inbox; m=~/.cache/nostr-inbox/' + sh(muteName) + '; c=~/.cache/nostr-inbox/' + sh(cipherName) + '; NOSTR_CLIENT_KEY=$(cat $k/client.key) timeout 120 nak decrypt --sec "$(cat $k/bunker)" -p ' + sh(data.pk) + (data.mutes.nip04 ? ' --nip04' : '') + ' "$(cat "$c")" > "$m".tmp && jq -e "type == \"array\"" "$m".tmp > /dev/null && mv "$m".tmp "$m"; rm -f "$m".tmp') }

  when notifiedAt == 0 && data != null { notifiedAt = now }
  when alerts && notifiedAt > 0 && len(newZaps) > 0 {
    notify(len(newZaps) == 1 ? "⚡ ${newZaps[0].name}" : "⚡ ${len(newZaps)} zaps", len(newZaps) == 1 ? "zapped you ${newZaps[0].sats ?? "some"} sats${newZaps[0].text == "" ? "" : ": " + newZaps[0].text}" : "${sum(newZaps.map(z => z.sats ?? 0))} sats")
    notifiedAt = lastZap.at
  }
  when !alerts && lastZap.at > notifiedAt { notifiedAt = lastZap.at }

  onTap: screen()

  let short = (rows ?? 3) < 3
  let satsText = sats >= 1000 ? "${fixed(sats / 1000, 1)}k" : "${sats}"
  let ok = who != "" && valid && data != null && data.error == null

  // The tile: what's new, big, then the newest as rows allow.
  Column {
    gap: 2
    fill: true
    if !short {
      Row {
        align: center
        Text { text: "NOSTR"; style: label; color: muted; weight: 1; maxLines: 1 }
        Text { text: upper(data.name ?? ""); style: label; color: accent; width: 96; align: end; maxLines: 1; visible: ok && (cols ?? 3) >= 4 }
      }
    }
    if who == "" {
      Text { text: "Set up"; fontSize: short ? 32 : 40; maxLines: 1 }
      Text { text: "Tap to add your npub"; style: small; color: muted; maxLines: 1 }
    } else if !valid || data.error != null {
      Text { text: "Not found"; fontSize: 32; maxLines: 1 }
      Text { text: valid ? data.error : "Not an npub or name@domain"; style: small; color: red; maxLines: 2 }
    } else if data == null {
      Text { text: "…"; fontSize: short ? 32 : 40; maxLines: 1 }
      Text { text: inbox == null ? "Asking the relays" : inbox.code == 124 ? "Relays timed out, retrying" : "Couldn't reach the relays"; style: small; color: muted; maxLines: 1 }
    } else {
      Text { text: "${len(fresh)} new"; fontSize: short ? 32 : 40; maxLines: 1 }
      Text { text: "⚡ ${satsText} · ↩ ${len(talk)} · ♥ ${len(likes)}"; style: small; color: muted; maxLines: 1 }
      Spacer { weight: 1 }
      if len(fresh) == 0 {
        Text { text: "All caught up"; style: small; color: muted; maxLines: 1; visible: !short }
      }
      for i in fresh.take(short ? 0 : (rows ?? 3) * 2 - 3) key i.id {
        Row {
          gap: 6
          align: center
          Glyph { it: i; size: 12 }
          Text { text: i.name; style: small; bold: true; maxLines: 1; width: (cols ?? 3) >= 5 ? 150 : 80 }
          Text { text: i.type == "zap" ? "${i.sats ?? "?"} sats${i.text == "" ? "" : " · " + i.text}" : i.type == "reaction" ? "reacted" : i.type == "repost" ? "reposted" : i.text; style: small; color: muted; maxLines: 1; weight: 1 }
        }
      }
    }
  }

  // The app: what's new and the whole week by kind, then the account and alerts.
  screen {
    title: "nostr inbox"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      if ok {
        Column {
          gap: 0
          Text { text: "${len(fresh)} new"; fontSize: 48; bold: true; maxLines: 1 }
          Text { text: "${data.name ?? id} · ⚡ ${sats} sats from ${len(zaps)} new zap${len(zaps) == 1 ? "" : "s"}"; fontSize: 16; color: muted; maxLines: 2 }
        }
        Row {
          gap: 8
          Text { text: "Mark all read"; fontSize: 16; bold: true; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 12]; onTap: seen = now }
          Text { text: "Refresh"; fontSize: 16; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 12]; onTap: refresh() }
        }
        Row {
          gap: 6
          for t in [["all", "All"], ["zaps", "Zaps"], ["replies", "Replies"], ["reactions", "Reactions"]] {
            Text { text: t[1]; fontSize: 14; weight: 1; align: center; maxLines: 1; color: foreground; background: tab == t[0] ? mix(surface, accent, 0.22) : surface; radius: 20; padding: [0, 10]; onTap: tab = t[0] }
          }
        }
        // Each one opens in the phone's nostr app (NIP-21), or on njump.me. New ones are tinted.
        Column {
          gap: 0
          background: surface
          radius: 28
          clip: true
          for i, k in shown key i.id {
            Spacer { height: 1; fill: width; background: border; visible: k > 0 }
            Row {
              gap: 14
              align: top
              padding: [20, 14]
              background: i.at > seen ? mix(surface, accent, 0.12) : transparent
              onTap: url(i.nevent != null ? "nostr:" + i.nevent : "https://njump.me/" + i.ref)
              Glyph { it: i; size: 18 }
              Column {
                gap: 2
                weight: 1
                Text { text: i.name; fontSize: 16; bold: i.at > seen; maxLines: 1 }
                Text {
                  text: (i.type == "zap" ? "Zapped ${i.sats ?? "?"} sats" : i.type == "reply" ? "Replied" : i.type == "mention" ? "Mentioned you" : i.type == "repost" ? (i.mine ? "Reposted your note" : "Reposted") : (i.mine ? "Reacted to your note" : "Reacted")) + " · " + (now - i.at < 3600 ? "${max(floor((now - i.at) / 60), 1)}m" : now - i.at < 86400 ? "${floor((now - i.at) / 3600)}h" : "${floor((now - i.at) / 86400)}d")
                  fontSize: 14; color: muted; maxLines: 1
                }
                Text { text: i.text; fontSize: 15; maxLines: 3; visible: i.text != "" && i.type != "reaction" }
              }
            }
          }
          if len(shown) == 0 {
            Text { text: "Nothing in the last 7 days."; fontSize: 16; color: muted; padding: [20, 16] }
          }
        }
      } else {
        Column {
          gap: 0
          Text { text: who == "" ? "Your inbox" : !valid || data.error != null ? "Not found" : "Loading"; fontSize: 48; bold: true; maxLines: 1 }
          Text {
            text: who == "" ? "Zaps, replies, mentions, reactions and reposts from the last week. Add your npub or NIP-05 address to start; only public data is read." : !valid ? "That doesn't look like an npub or name@domain." : data.error != null ? data.error : inbox == null ? "Asking the relays…" : inbox.code == 124 ? "Relays timed out, retrying" : "Couldn't reach the relays"
            fontSize: 16; color: who != "" && (!valid || data.error != null) ? red : muted
          }
        }
        if who == "" {
          Text { text: "Add your account"; fontSize: 16; bold: true; maxLines: 1; align: center; fill: width; background: accent; color: background; radius: 24; padding: [24, 14]; onTap: { draft = ""; editingWho = true } }
        }
      }

      Text { text: "Settings"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        Row {
          gap: 16
          align: center
          padding: [20, 14]
          onTap: { draft = who; editingWho = true }
          Column {
            gap: 0
            weight: 1
            Text { text: "Account"; fontSize: 16; maxLines: 1 }
            Text { text: who == "" ? "Not set" : who; fontSize: 14; color: muted; maxLines: 1 }
          }
          Text { text: "›"; fontSize: 18; color: muted }
        }
        Spacer { height: 1; fill: width; background: border }
        Row {
          gap: 16
          align: center
          padding: [20, 14]
          onTap: alerts = !alerts
          Column {
            gap: 0
            weight: 1
            Text { text: "Zap alerts"; fontSize: 16; maxLines: 1 }
            Text { text: "A notification for each new zap"; fontSize: 14; color: muted; maxLines: 1 }
          }
          Box {
            width: 52; height: 32; radius: 16; background: alerts ? accent : transparent; border: alerts ? 0 : 2; borderColor: muted
            Spacer { size: alerts ? 24 : 16; radius: alerts ? 12 : 8; background: alerts ? background : muted; offset: [alerts ? 24 : 8, alerts ? 4 : 8] }
          }
        }
        // NIP-46 pairing with Amber, which decrypts the private part of the mute list (NIP-51).
        if ok && data.mutes.nak && data.mutes.private != null {
          Spacer { height: 1; fill: width; background: border }
          Row {
            gap: 12
            align: center
            padding: [20, 14]
            Column {
              gap: 0
              weight: 1
              Text { text: "Private mutes"; fontSize: 16; maxLines: 1 }
              Text { text: data.mutes.bunker ? "Amber decrypts them" : "Pair Amber to decrypt them"; fontSize: 14; color: muted; maxLines: 1 }
            }
            if data.mutes.bunker {
              Text { text: "Disconnect"; fontSize: 15; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 12]; onTap: run('rm -f ~/.config/nostr-inbox/bunker ~/.config/nostr-inbox/connect.secret ~/.cache/nostr-inbox/' + sh(muteName)) }
            } else {
              // Listens for Amber's answer to the nostrconnect:// link (it must echo our secret), saves the
              // connection, then decrypts right away. Opens the link in Amber at the same time.
              Text {
                text: "Connect"; fontSize: 15; bold: true; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 12]
                onTap: {
                  amberAt = now
                  run('k=~/.config/nostr-inbox; ck=$(cat $k/client.key); relays=$(cat $k/relays); ev=$(timeout 280 nak req -k 24133 -p $(nak key public $ck) --since $(($(date +%s) - 5)) -l 1 --stream $relays 2>/dev/null); from=$(printf %s "$ev" | jq -r .pubkey); [[ $from =~ ^[0-9a-f]{64}$ ]] || from=0; res=$(nak decrypt --sec $ck -p $from "$(printf %s "$ev" | jq -r .content)" 2>/dev/null | jq -r .result); [ -n "$res" ] && [ "$res" = "$(cat $k/connect.secret)" ] && (umask 077; printf %s "bunker://$from?$(for r in $relays; do printf "relay=%s&" $(printf %s $r | jq -Rr @uri); done)" > $k/bunker) && rm -f $k/connect.secret; [ -s $k/bunker ] && ' + 'umask 077; k=~/.config/nostr-inbox; m=~/.cache/nostr-inbox/' + sh(muteName) + '; c=~/.cache/nostr-inbox/' + sh(cipherName) + '; NOSTR_CLIENT_KEY=$(cat $k/client.key) timeout 120 nak decrypt --sec "$(cat $k/bunker)" -p ' + sh(data.pk) + (data.mutes.nip04 ? ' --nip04' : '') + ' "$(cat "$c")" > "$m".tmp && jq -e "type == \"array\"" "$m".tmp > /dev/null && mv "$m".tmp "$m"; rm -f "$m".tmp')
                  url(data.mutes.connect)
                }
              }
            }
          }
          // If Android stopped the listener while Amber was open: Amber signs as the user, so pair with their key.
          if !data.mutes.bunker && amberAt > 0 {
            Spacer { height: 1; fill: width; background: border }
            Row {
              gap: 12
              align: center
              padding: [20, 14]
              Text { text: "Approved it in Amber?"; fontSize: 16; weight: 1; maxLines: 1 }
              Text { text: "Done"; fontSize: 15; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 12]; onTap: run('k=~/.config/nostr-inbox; [ -s $k/bunker ] || (umask 077; printf %s "bunker://"' + sh(data.pk) + '"?$(for r in $(cat $k/relays); do printf "relay=%s&" $(printf %s $r | jq -Rr @uri); done)" > $k/bunker); ' + 'umask 077; k=~/.config/nostr-inbox; m=~/.cache/nostr-inbox/' + sh(muteName) + '; c=~/.cache/nostr-inbox/' + sh(cipherName) + '; NOSTR_CLIENT_KEY=$(cat $k/client.key) timeout 120 nak decrypt --sec "$(cat $k/bunker)" -p ' + sh(data.pk) + (data.mutes.nip04 ? ' --nip04' : '') + ' "$(cat "$c")" > "$m".tmp && jq -e "type == \"array\"" "$m".tmp > /dev/null && mv "$m".tmp "$m"; rm -f "$m".tmp') }
            }
          }
        }
      }
      if ok && data.relays != null {
        Text { text: "Relays: ${join(data.relays, ", ")}"; fontSize: 14; color: muted; padding: [4, 8, 0, 0] }
      }

      // The account: any npub, nprofile, hex key or NIP-05 address.
      if editingWho {
        Sheet {
          title: "Account"
          onDismiss: editingWho = false
          Column {
            gap: 16
            padding: [0, 4, 0, 4]
            Input {
              text: draft
              placeholder: "npub1… or name@domain"
              focus: editingWho
              onChange: draft = value
              onSubmit: {
                if trim(value) != who {
                  who = trim(value)
                  seen = now - 86400
                  good = null
                  notifiedAt = now
                }
                editingWho = false
              }
            }
            Text { text: "Only public data is read; no keys needed."; fontSize: 14; color: muted }
            Row {
              gap: 8
              align: center
              if who != "" {
                Text { text: "Remove"; fontSize: 15; color: red; padding: [8, 12]; onTap: { who = ""; editingWho = false } }
              }
              Spacer { weight: 1 }
              Text { text: "Cancel"; fontSize: 15; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 12]; onTap: editingWho = false }
              Text {
                text: "Save"; fontSize: 15; bold: true; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 12]
                onTap: {
                  if trim(draft) != who {
                    who = trim(draft)
                    seen = now - 86400
                    good = null
                    notifiedAt = now
                  }
                  editingWho = false
                }
              }
            }
          }
        }
      }
    }
  }
}
