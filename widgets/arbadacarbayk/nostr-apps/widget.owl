widget "nostr apps" {
  meta {
    description: "The newest apps published to Nostr. Search the list and tap one to open it. A star count shows only when there is a real one."
    version: "1.3"
    license: "MIT"
    category: "dev"
    owl: 9
  }
  size: 6x5
  minSize: 4x4

  asset mark = base64""

  state who = "" persist
  state q = ""
  // The npub form, open, and what's typed in it.
  state editing = false
  state draft = ""
  source raw = http("https://gittr.space/api/widgets/launcher") every 15m json timeout 20s status
  source trust = http("https://gittr.space/api/widgets/wot?set=apps&from=${who}") every 30m json timeout 15s status
  let data = raw.ok ? raw.out : null
  let hops = trust.ok ? trust.out.hops : null
  let pool = data.apps ?? []
  let query = lower(trim(q))
  let matched = query == "" ? pool : pool.filter(a => contains(a.hay, query))
  let searchUrl = "https://gittr.space/apps?q=${replace(trim(q), ' ', '+')}"
  let newest = pool[0]
  let wide = (screenWidth ?? 0) > 600

  onTap: screen()

  // The hop count to an app's author in your web of trust: 1 is someone you follow.
  component Hop(hop) {
    Text {
      text: hop == null ? "" : "${hop}"
      fontSize: 13; bold: true; maxLines: 1; visible: hop != null
      color: hop == 1 ? green : hop == 2 ? cyan : hop == 3 ? yellow : orange
    }
  }

  // The tile: the newest app, big, then the next ones as rows allow.
  Column {
    gap: 2
    fill: true
    Row {
      gap: 8
      align: center
      Text { text: "NOSTR APPS"; style: label; color: muted; weight: 1; maxLines: 1 }
      Box {
        size: 20
        radius: 10
        clip: true
        background: foreground
        Image { src: mark; size: 20; fit: cover }
      }
    }
    if data == null {
      Text { text: raw == null ? null : "Offline"; fontSize: 32; maxLines: 1 }
      Text { text: raw == null ? "Loading…" : "gittr can't be reached"; style: small; color: muted; maxLines: 1 }
    } else if newest == null {
      Text { text: "No apps"; fontSize: 32; maxLines: 1 }
      Text { text: "Nothing in the latest apps"; style: small; color: muted; maxLines: 1 }
    } else {
      Row {
        gap: 8
        align: center
        Text { text: newest.name; fontSize: 20; bold: true; weight: 1; maxLines: 1 }
        Hop { hop: hops[newest.pubkey] }
      }
      Text { text: newest.desc; style: small; color: muted; maxLines: 2 }
      Spacer { height: 6 }
      for a in pool.drop(1).take(max((rows ?? 5) * 2 - 5, 0)) key a.url {
        Column {
          gap: 0
          Row {
            gap: 8
            align: center
            Text { text: a.name; style: small; bold: true; weight: 1; maxLines: 1 }
            Hop { hop: hops[a.pubkey] }
          }
          Text { text: a.desc; style: small; color: muted; maxLines: 1; visible: a.desc != "" }
        }
      }
    }
    Spacer { weight: 1 }
  }

  component Apps() {
    Column {
      gap: 12
      // Search: the list narrows as you type, and the keyboard's search key asks gittr.
      Input {
        placeholder: "Search apps"
        text: q
        background: surface; radius: 28; padding: [20, 6]
        onChange: q = value
        onSubmit: url(searchUrl)
      }
      if data == null {
        Text { text: raw == null ? "Loading…" : "gittr can't be reached right now."; fontSize: 16; color: muted; background: surface; radius: 28; padding: [20, 16] }
        if raw != null { Text { text: "Try again"; fontSize: 16; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [24, 14]; onTap: refresh() } }
      } else if len(matched) == 0 {
        Text { text: "Nothing in the latest apps matches."; fontSize: 16; color: muted; background: surface; radius: 28; padding: [20, 16] }
        Text { text: "Search on gittr"; fontSize: 16; bold: true; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 14]; onTap: url(searchUrl) }
      } else {
        Text { text: query == "" ? "Newest first" : "Matching “${trim(q)}”"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
        Column {
          gap: 0
          background: surface; radius: 28; clip: true
          for a, i in matched key a.url {
            Spacer { height: 1; fill: width; background: border; visible: i > 0 }
            Row {
              gap: 16
              align: center
              padding: [20, 14]
              onTap: url(a.url)
              Column {
                gap: 0
                weight: 1
                Text { text: a.name; fontSize: 16; maxLines: 1 }
                Text { text: a.desc; fontSize: 14; color: muted; maxLines: 2; visible: a.desc != "" }
                Text { text: a.meta; fontSize: 14; color: accent; maxLines: 1; visible: a.meta != "" }
              }
              Hop { hop: hops[a.pubkey] }
            }
          }
        }
      }
    }
  }

  component Settings() {
    Column {
      gap: 12
      Text { text: "Trust marks"; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface; radius: 28; clip: true
        Row {
          gap: 12
          align: center
          padding: [20, 16]
          onTap: { draft = who; editing = true }
          Column {
            gap: 0
            weight: 1
            Text { text: "Your npub"; fontSize: 16; maxLines: 1 }
            Text { text: who == "" ? "Not set" : who; fontSize: 14; color: muted; maxLines: 1 }
          }
          Text { text: "›"; fontSize: 18; color: muted }
        }
        Spacer { height: 1; fill: width; background: border }
        Text { text: "With it set, a number beside an app is how many follows away its author is: 1 is someone you follow."; fontSize: 14; color: muted; padding: [20, 14] }
      }
      Row {
        gap: 8
        Text { text: "App store"; fontSize: 16; bold: true; maxLines: 1; background: accent; color: background; radius: 24; padding: [20, 12]; onTap: url("https://gittr.space/apps") }
        Text { text: "gittr"; fontSize: 16; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 12]; onTap: url("https://gittr.space") }
        Text { text: "Help"; fontSize: 16; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 12]; onTap: url("https://gittr.space/help#publish-pages-apps") }
      }
    }
  }

  screen {
    title: "nostr apps"
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      Column {
        gap: 0
        Text { text: data == null ? "…" : "${len(pool)} apps"; fontSize: 48; bold: true; maxLines: 1 }
        Text { text: "The newest published to Nostr, from gittr.space"; fontSize: 16; color: muted }
      }
      if wide {
        Row {
          gap: 24
          Apps { weight: 1 }
          Settings { weight: 1 }
        }
      } else {
        Apps { }
        Settings { }
      }
    }

    // Your npub, for the trust marks.
    if editing {
      Sheet {
        title: "Your npub"
        onDismiss: editing = false
        Column {
          gap: 16
          padding: [0, 4, 0, 4]
          Input {
            text: draft
            placeholder: "npub1…"
            focus: editing
            onChange: draft = value
            onSubmit: { who = trim(value); editing = false; refresh() }
          }
          Row {
            gap: 8
            align: center
            if who != "" {
              Text { text: "Remove"; fontSize: 15; color: red; maxLines: 1; padding: [8, 12]; onTap: { who = ""; editing = false; refresh() } }
            }
            Spacer { weight: 1 }
            Text { text: "Cancel"; fontSize: 15; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 12]; onTap: editing = false }
            Text { text: "Save"; fontSize: 15; bold: true; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 12]; onTap: { who = trim(draft); editing = false; refresh() } }
          }
        }
      }
    }
  }
}
