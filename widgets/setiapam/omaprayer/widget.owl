widget "omaprayer" {
  size: 3x3
  minSize: 3x2

  meta {
    description: "Prayer times timetable and Horizon day strip with Aladhan & Kemenag RI methods, Madhab Asr, ihtiyat tuning, city search, and 7-day schedule"
    version: "1.3"
    license: "MIT"
    category: "productivity"
    owl: 9
  }

  requires {
    pacman: []
  }

  // Persistent user preferences
  state city = "auto" persist
  state typedCity = ""
  state method = "20" persist
  state school = "0" persist
  state tuneMin = 0 persist
  state lang = "id" persist

  source now = clock every 10s

  // Escape user-typed query for Open-Meteo URL
  let q = replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(
    trim(city), "%", "%25"), " ", "%20"), "&", "%26"), "#", "%23"), "?", "%3F"), "+", "%2B"), "/", "%2F"),
    "ä", "%C3%A4"), "ö", "%C3%B6"), "ü", "%C3%BC"), "Ä", "%C3%84"), "Ö", "%C3%96"), "Ü", "%C3%9C"), "ß", "%C3%9F"),
    "é", "%C3%A9"), "è", "%C3%A8"), "à", "%C3%A0"), "ç", "%C3%A7"), "ñ", "%C3%B1"), "ø", "%C3%B8")

  // Auto-location via wttr.in when city is "auto"
  source ipLoc = http(city == "auto" ? "https://wttr.in/?format=j1" : "") every 30m timeout 10s json status
  let ipArea = ipLoc != null && ipLoc.ok && ipLoc.out.nearest_area != null ? ipLoc.out.nearest_area.0 : null

  // Geocoding via Open-Meteo when city is specified
  source geo = http(city == "auto" || len(trim(city)) < 2 ? "" : "https://geocoding-api.open-meteo.com/v1/search?name=${q}&count=1") every 1h timeout 10s json status
  let geoFound = city == "auto" || (geo != null && geo.ok && geo.out.results != null && len(geo.out.results) > 0)
  let geoResult = city != "auto" && geoFound && geo.out.results != null ? geo.out.results.0 : null
  let notFound = city != "auto" && geo != null && geo.ok && (geo.out.results == null || len(geo.out.results) == 0)

  let isJakarta = city == "auto" || lower(trim(city)) == "jakarta"

  // Resolved coordinates & display location
  let lat = isJakarta ? (city == "auto" && ipArea != null ? ipArea.latitude : -6.2146) : (geoResult != null ? geoResult.latitude : null)
  let lon = isJakarta ? (city == "auto" && ipArea != null ? ipArea.longitude : 106.8451) : (geoResult != null ? geoResult.longitude : null)
  let placeName = city == "auto" ? (ipArea != null ? ipArea.areaName.0.value : "Auto") : (geoResult != null ? geoResult.name : city)
  let countryName = city == "auto" ? (ipArea != null ? ipArea.country.0.value : "") : (geoResult != null ? (geoResult.country ?? "") : "")

  // Timezone & local clock via Open-Meteo
  source tz = http(lat == null ? "" : "https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current=is_day&timezone=auto") every 1h timeout 10s json status
  let tzOffset = tz != null && tz.ok && tz.out.utc_offset_seconds != null ? tz.out.utc_offset_seconds : (isJakarta ? 25200 : 0)
  let tzName = tz != null && tz.ok && tz.out.timezone != null ? tz.out.timezone : (isJakarta ? "Asia/Jakarta" : "UTC")

  // Local time in target city's timezone
  let localSec = now + tzOffset
  let curMin = floor(((localSec % 86400) + 86400) % 86400 / 60)
  let curH = floor(curMin / 60)
  let curM = curMin % 60
  let curHStr = curH < 10 ? "0${curH}" : "${curH}"
  let curMStr = curM < 10 ? "0${curM}" : "${curM}"
  let curTimeStr = "${curHStr}:${curMStr}"
  let dayFrac = clamp(curMin / 1440, 0, 1)

  // Calendar dates in target city's timezone
  let isoDate = tz != null && tz.ok && tz.out.current != null && tz.out.current.time != null ? tz.out.current.time : ""
  let localDay = len(isoDate) >= 10 ? floor(num(sub(isoDate, 8, 10))) : floor(num(fmtTime(now + tzOffset, "d")))
  let localMonth = len(isoDate) >= 10 ? floor(num(sub(isoDate, 5, 7))) : floor(num(fmtTime(now + tzOffset, "M")))
  let localYear = len(isoDate) >= 10 ? floor(num(sub(isoDate, 0, 4))) : floor(num(fmtTime(now + tzOffset, "yyyy")))

  let nextMonth = localMonth == 12 ? 1 : localMonth + 1
  let nextYear = localMonth == 12 ? localYear + 1 : localYear

  // Aladhan tune parameter: imsak,fajr,sunrise,dhuhr,asr,maghrib,sunset,isha,midnight
  let tuneStr = "0,${tuneMin},0,${tuneMin},${tuneMin},${tuneMin},0,${tuneMin},0"

  // Current and next month calendar from Aladhan (canonical URL without 302 redirect)
  source cal = http(lat == null ? "" : "https://api.aladhan.com/v1/calendar/${localYear}/${localMonth}?latitude=${lat}&longitude=${lon}&method=${method}&school=${school}&tune=${tuneStr}") every 1h timeout 15s json status
  source nextCal = http(lat == null || localDay < 25 ? "" : "https://api.aladhan.com/v1/calendar/${nextYear}/${nextMonth}?latitude=${lat}&longitude=${lon}&method=${method}&school=${school}&tune=${tuneStr}") every 1h timeout 15s json status

  let calList = cal != null && cal.ok && cal.out.data != null ? cal.out.data : []
  let nextCalList = nextCal != null && nextCal.ok && nextCal.out.data != null ? nextCal.out.data : []
  let allDays = calList + nextCalList

  let todayItem = allDays.find(d => floor(num(d.date.gregorian.day)) == localDay && floor(num(d.date.gregorian.month.number)) == localMonth)
  let todayIdx = allDays.indexOf(todayItem)
  let weekDays = todayIdx >= 0 ? take(drop(allDays, todayIdx), 7) : take(allDays, 7)

  // Timings from todayItem
  let rawTimings = todayItem != null ? todayItem.timings : null
  let tFajr = rawTimings != null ? sub(rawTimings.Fajr, 0, 5) : (isJakarta ? "04:15" : null)
  let tSunrise = rawTimings != null ? sub(rawTimings.Sunrise, 0, 5) : (isJakarta ? "05:33" : null)
  let tDhuhr = rawTimings != null ? sub(rawTimings.Dhuhr, 0, 5) : (isJakarta ? "11:39" : null)
  let tAsr = rawTimings != null ? sub(rawTimings.Asr, 0, 5) : (isJakarta ? "14:43" : null)
  let tMaghrib = rawTimings != null ? sub(rawTimings.Maghrib, 0, 5) : (isJakarta ? "17:46" : null)
  let tIsha = rawTimings != null ? sub(rawTimings.Isha, 0, 5) : (isJakarta ? "18:56" : null)
  let tImsak = rawTimings != null ? sub(rawTimings.Imsak, 0, 5) : (isJakarta ? "04:05" : null)
  let tSunset = rawTimings != null ? sub(rawTimings.Sunset, 0, 5) : (isJakarta ? "17:46" : null)
  let tMidnight = rawTimings != null ? sub(rawTimings.Midnight, 0, 5) : (isJakarta ? "23:39" : null)

  // Milestones in minutes from midnight
  let fMin = tFajr != null ? floor(num(sub(tFajr, 0, 2))) * 60 + floor(num(sub(tFajr, 3, 5))) : 255
  let sMin = tSunrise != null ? floor(num(sub(tSunrise, 0, 2))) * 60 + floor(num(sub(tSunrise, 3, 5))) : 333
  let dMin = tDhuhr != null ? floor(num(sub(tDhuhr, 0, 2))) * 60 + floor(num(sub(tDhuhr, 3, 5))) : 699
  let aMin = tAsr != null ? floor(num(sub(tAsr, 0, 2))) * 60 + floor(num(sub(tAsr, 3, 5))) : 883
  let mgMin = tMaghrib != null ? floor(num(sub(tMaghrib, 0, 2))) * 60 + floor(num(sub(tMaghrib, 3, 5))) : 1066
  let iMin = tIsha != null ? floor(num(sub(tIsha, 0, 2))) * 60 + floor(num(sub(tIsha, 3, 5))) : 1136
  let imsakMin = tImsak != null ? floor(num(sub(tImsak, 0, 2))) * 60 + floor(num(sub(tImsak, 3, 5))) : 245
  let sunsetMin = tSunset != null ? floor(num(sub(tSunset, 0, 2))) * 60 + floor(num(sub(tSunset, 3, 5))) : 1066
  let midnightMin = tMidnight != null ? floor(num(sub(tMidnight, 0, 2))) * 60 + floor(num(sub(tMidnight, 3, 5))) : 1420

  let activeId = curMin < fMin ? "night" :
    curMin < sMin ? "fajr" :
    curMin < dMin ? "sunrise" :
    curMin < aMin ? "dhuhr" :
    curMin < mgMin ? "asr" :
    curMin < iMin ? "maghrib" :
    "isha"

  let nextId = curMin < fMin ? "fajr" :
    curMin < sMin ? "sunrise" :
    curMin < dMin ? "dhuhr" :
    curMin < aMin ? "asr" :
    curMin < mgMin ? "maghrib" :
    curMin < iMin ? "isha" :
    "fajr"

  let isTomorrow = curMin >= iMin && nextId == "fajr"

  let nextNameId = nextId == "fajr" ? "Subuh" :
    nextId == "sunrise" ? "Terbit" :
    nextId == "dhuhr" ? "Dzuhur" :
    nextId == "asr" ? "Ashar" :
    nextId == "maghrib" ? "Maghrib" :
    "Isya"

  let nextNameEn = nextId == "fajr" ? "Fajr" :
    nextId == "sunrise" ? "Sunrise" :
    nextId == "dhuhr" ? "Dhuhr" :
    nextId == "asr" ? "Asr" :
    nextId == "maghrib" ? "Maghrib" :
    "Isha"

  let nextAr = nextId == "fajr" ? "الفجر" :
    nextId == "sunrise" ? "الشروق" :
    nextId == "dhuhr" ? "الظهر" :
    nextId == "asr" ? "العصر" :
    nextId == "maghrib" ? "المغرب" :
    "العشاء"

  let nextName = lang == "ar" ? nextAr : lang == "en" ? nextNameEn : nextNameId
  let nextTimeRaw = nextId == "fajr" ? tFajr :
    nextId == "sunrise" ? tSunrise :
    nextId == "dhuhr" ? tDhuhr :
    nextId == "asr" ? tAsr :
    nextId == "maghrib" ? tMaghrib :
    tIsha

  let nextMin = nextId == "fajr" ? fMin :
    nextId == "sunrise" ? sMin :
    nextId == "dhuhr" ? dMin :
    nextId == "asr" ? aMin :
    nextId == "maghrib" ? mgMin :
    iMin

  let minLeft = curMin >= iMin ? (1440 - curMin + fMin) : max(nextMin - curMin, 0)
  let hLeft = floor(minLeft / 60)
  let mLeft = minLeft % 60
  let countdownStr = lang == "en" ? (hLeft > 0 ? "${hLeft}h ${mLeft}m" : "${mLeft}m") :
    lang == "ar" ? (hLeft > 0 ? "${hLeft}س ${mLeft}د" : "${mLeft}د") :
    (hLeft > 0 ? "${hLeft}j ${mLeft}m" : "${mLeft}m")
  let prayerSoon = minLeft <= 15

  let hijriInfo = todayItem != null && todayItem.date != null ? todayItem.date.hijri : null
  let hijriDisplay = hijriInfo != null ? (lang == "ar" ? "${hijriInfo.day} ${hijriInfo.month.ar} ${hijriInfo.year}" : "${hijriInfo.day} ${hijriInfo.month.en} ${hijriInfo.year} H") : ""
  let gregDisplay = todayItem != null && todayItem.date != null ? "${todayItem.date.gregorian.day} ${todayItem.date.gregorian.month.en} ${todayItem.date.gregorian.year}" : fmtTime(now + tzOffset, "d MMMM yyyy")
  let methodName = todayItem != null && todayItem.meta != null && todayItem.meta.method != null ? todayItem.meta.method.name : "Kementerian Agama RI"
  let schoolName = lang == "en" ? (school == "1" ? "Hanafi" : "Shafi'i") : (school == "1" ? "Hanafi" : "Syafi'i")

  // Prayer list for the tile grid
  let tilePrayers = [
    { id: "fajr", name: lang == "ar" ? "الفجر" : lang == "en" ? "Fajr" : "Subuh", time: tFajr, targetMin: fMin },
    { id: "sunrise", name: lang == "ar" ? "الشروق" : lang == "en" ? "Sunrise" : "Terbit", time: tSunrise, targetMin: sMin },
    { id: "dhuhr", name: lang == "ar" ? "الظهر" : lang == "en" ? "Dhuhr" : "Dzuhur", time: tDhuhr, targetMin: dMin },
    { id: "asr", name: lang == "ar" ? "العصر" : lang == "en" ? "Asr" : "Ashar", time: tAsr, targetMin: aMin },
    { id: "maghrib", name: lang == "ar" ? "المغرب" : "Maghrib", time: tMaghrib, targetMin: mgMin },
    { id: "isha", name: lang == "ar" ? "العشاء" : lang == "en" ? "Isha" : "Isya", time: tIsha, targetMin: iMin }
  ]

  // Full timetable for the screen view
  let screenPrayers = [
    { id: "imsak", name: "Imsak", ar: "الإمساك", time: tImsak, isNext: false, isCurrent: curMin < fMin && curMin >= imsakMin },
    { id: "fajr", name: lang == "ar" ? "الفجر" : lang == "en" ? "Fajr" : "Subuh", ar: "الفجر", time: tFajr, isNext: nextId == "fajr", isCurrent: activeId == "fajr" },
    { id: "sunrise", name: lang == "ar" ? "الشروق" : lang == "en" ? "Sunrise" : "Terbit (Syuruq)", ar: "الشروق", time: tSunrise, isNext: nextId == "sunrise", isCurrent: activeId == "sunrise" },
    { id: "dhuhr", name: lang == "ar" ? "الظهر" : lang == "en" ? "Dhuhr" : "Dzuhur", ar: "الظهر", time: tDhuhr, isNext: nextId == "dhuhr", isCurrent: activeId == "dhuhr" },
    { id: "asr", name: lang == "ar" ? "العصر" : lang == "en" ? "Asr" : "Ashar", ar: "العصر", time: tAsr, isNext: nextId == "asr", isCurrent: activeId == "asr" },
    { id: "sunset", name: lang == "en" ? "Sunset" : lang == "ar" ? "الغروب" : "Terbenam Matahari", ar: "الغروب", time: tSunset, isNext: false, isCurrent: false },
    { id: "maghrib", name: lang == "ar" ? "المغرب" : "Maghrib", ar: "المغرب", time: tMaghrib, isNext: nextId == "maghrib", isCurrent: activeId == "maghrib" },
    { id: "isha", name: lang == "en" ? "Isha" : lang == "ar" ? "العشاء" : "Isya", ar: "العشاء", time: tIsha, isNext: nextId == "isha", isCurrent: activeId == "isha" },
    { id: "midnight", name: lang == "en" ? "Midnight" : lang == "ar" ? "منتصف الليل" : "Tengah Malam (Nisfu Lail)", ar: "منتصف الليل", time: tMidnight, isNext: false, isCurrent: false }
  ]

  // The words it shows, in the language picked.
  let L = lang == "en" ? {
    title: "Prayer times", label: "PRAYER", tomorrow: "tomorrow", soon: "Prayer time now", today: "Today", week: "Next 7 days",
    settings: "Settings", city: "City", method: "Calculation method", school: "Asr madhab", tune: "Ihtiyat margin", language: "Language",
    cityHint: "Type a city, e.g. London", auto: "Automatic", cancel: "Cancel", save: "Save", refresh: "Refresh",
    notFound: "Can't find '${city}'", zone: "Time zone", day: "Day", left: "in ${countdownStr}"
  } : lang == "ar" ? {
    title: "مواقيت الصلاة", label: "الصلاة", tomorrow: "غداً", soon: "وقت الصلاة!", today: "اليوم", week: "الأيام السبعة القادمة",
    settings: "الإعدادات", city: "المدينة", method: "طريقة الحساب", school: "مذهب العصر", tune: "الاحتياط", language: "اللغة",
    cityHint: "اكتب اسم المدينة", auto: "تلقائي", cancel: "إلغاء", save: "حفظ", refresh: "تحديث",
    notFound: "المدينة '${city}' غير موجودة", zone: "المنطقة الزمنية", day: "اليوم", left: "بعد ${countdownStr}"
  } : {
    title: "Jadwal shalat", label: "SHALAT", tomorrow: "besok", soon: "Waktu shalat!", today: "Hari ini", week: "7 hari ke depan",
    settings: "Pengaturan", city: "Kota", method: "Metode perhitungan", school: "Madzhab Ashar", tune: "Koreksi ihtiyat", language: "Bahasa",
    cityHint: "Ketik kota, mis. Bandung", auto: "Otomatis", cancel: "Batal", save: "Simpan", refresh: "Muat ulang",
    notFound: "Kota '${city}' tidak ditemukan", zone: "Zona waktu", day: "Hari", left: "${countdownStr} lagi"
  }

  // The next prayer, when, and where.
  let nextLine = prayerSoon ? "${nextName} · ${L.soon}" : "${nextName} · ${L.left}" + (isTomorrow ? " · ${L.tomorrow}" : "")
  let placeLine = notFound ? L.notFound : placeName + (len(countryName) > 0 ? ", " + countryName : "")

  // The choices behind the settings, each opened in a sheet.
  state sheet = ""                // "city", "method", "school", "tune" or "lang" while its sheet is open
  let methods = [
    {v: "20", l: lang == "en" ? "Kemenag RI (Indonesia)" : "Kemenag RI"},
    {v: "3", l: lang == "en" ? "Muslim World League" : "MWL (Rabitah)"},
    {v: "4", l: lang == "en" ? "Umm al-Qura, Makkah" : "Umm al-Qura Makkah"},
    {v: "5", l: lang == "en" ? "Egyptian Authority" : "Mesir (EGAS)"},
    {v: "11", l: lang == "en" ? "Singapore (MUIS)" : "Singapura (MUIS)"},
    {v: "2", l: lang == "en" ? "ISNA (North America)" : "ISNA (Amerika)"}
  ]
  let schools = [{v: "0", l: lang == "en" ? "Shafi'i (standard)" : "Syafi'i (standar)"}, {v: "1", l: lang == "en" ? "Hanafi (later Asr)" : "Hanafi (bayangan 2x)"}]
  let tunes = [
    {v: 0, l: lang == "en" ? "None" : lang == "ar" ? "بدون" : "Tanpa koreksi"},
    {v: 1, l: "+1 min"},
    {v: 2, l: lang == "en" ? "+2 min (Indonesia's standard)" : "+2 min (standar RI)"},
    {v: 3, l: "+3 min"}
  ]
  let langs = [{v: "id", l: "Indonesia"}, {v: "en", l: "English"}, {v: "ar", l: "العربية"}]
  let cityPicks = [{l: L.auto, v: "auto"}, {l: "Jakarta", v: "Jakarta"}, {l: "Bandung", v: "Bandung"}, {l: "Surabaya", v: "Surabaya"}, {l: "Yogyakarta", v: "Yogyakarta"}, {l: "Medan", v: "Medan"}, {l: "Makassar", v: "Makassar"}, {l: lang == "ar" ? "مكة" : "Makkah", v: "Mecca"}]
  let options = sheet == "method" ? methods : sheet == "school" ? schools : sheet == "tune" ? tunes : sheet == "lang" ? langs : []
  let chosen = sheet == "method" ? method : sheet == "school" ? school : sheet == "tune" ? tuneMin : lang
  let settingRows = [
    {k: "city", l: L.city, v: city == "auto" ? "${L.auto} · ${placeName}" : placeName},
    {k: "method", l: L.method, v: methods.find(o => o.v == method).l ?? methodName},
    {k: "school", l: L.school, v: schoolName},
    {k: "tune", l: L.tune, v: tunes.find(o => o.v == tuneMin).l ?? "+${tuneMin} min"},
    {k: "lang", l: L.language, v: langs.find(o => o.v == lang).l ?? lang}
  ]

  onTap: screen()

  // A prayer in the tile's grid, the current one tonal.
  component PrayerCard(p) {
    let isCurrent = p.id == activeId
    let isPast = p.targetMin <= curMin && !isCurrent
    Column {
      gap: 0
      align: center
      padding: [2, 4]
      radius: 8 * corners
      background: isCurrent ? mix(surface, accent, 0.22) : alpha(surface, 0.45)
      Text { text: p.name; fontSize: 10; bold: isCurrent; color: isCurrent ? accent : isPast ? muted : foreground; align: center; fill: width; maxLines: 1 }
      Text { text: p.time ?? "—:—"; fontSize: 12; bold: isCurrent; color: isCurrent ? accent : isPast ? muted : foreground; align: center; fill: width; maxLines: 1 }
    }
  }

  // The day as a strip: the night, Fajr to sunrise, the day's prayers in their colours, and now.
  component Horizon() {
    Canvas {
      height: 8
      fill: width
      rect(0, 0, width, height, radius: 4, fill: alpha(muted, 0.2))

      let xF = clamp((fMin / 1440) * width, 0, width)
      let xS = clamp((sMin / 1440) * width, 0, width)
      let xD = clamp((dMin / 1440) * width, 0, width)
      let xA = clamp((aMin / 1440) * width, 0, width)
      let xM = clamp((mgMin / 1440) * width, 0, width)
      let xI = clamp((iMin / 1440) * width, 0, width)

      rect(xF, 0, max(xS - xF, 2), height, fill: alpha(cyan, 0.7))
      rect(xS, 0, max(xD - xS, 2), height, fill: alpha(surface, 0.4))
      rect(xD, 0, max(xA - xD, 2), height, fill: alpha(yellow, 0.7))
      rect(xA, 0, max(xM - xA, 2), height, fill: alpha(orange, 0.7))
      rect(xM, 0, max(xI - xM, 2), height, fill: alpha(red, 0.7))
      rect(xI, 0, max(width - xI, 2), height, fill: alpha(blue, 0.7))

      let curX = clamp((curMin / 1440) * width, 0, width)
      rect(max(curX - 2, 0), 0, 4, height, radius: 2, fill: accent)
      circle(curX, height / 2, 4, fill: accent)
    }
  }

  // The tile: the next prayer's time big, which one and how long until it; the place, the day strip and every
  // prayer when there's room.
  let short = (rows ?? 3) < 3
  let showGrid = ((cols ?? 3) >= 6 && (rows ?? 3) >= 3) || (rows ?? 3) >= 4
  Column {
    gap: 2
    fill: true
    Text { text: L.label; style: label; color: muted; maxLines: 1 }
    Text { text: nextTimeRaw ?? "—:—"; fontSize: 40; maxLines: 1; color: prayerSoon ? red : foreground }
    Text { text: nextLine; style: small; color: prayerSoon ? red : accent; maxLines: 1 }
    if !short {
      Text { text: notFound ? L.notFound : hijriDisplay != "" ? "${placeName} · ${hijriDisplay}" : placeName; style: small; color: notFound ? red : muted; maxLines: 1 }
      Spacer { weight: 1 }
      Horizon { }
      if showGrid {
        Spacer { height: 4 }
        Grid {
          columns: (cols ?? 3) < 6 ? 3 : 6
          gap: 4
          fill: width
          for p in tilePrayers key p.id {
            PrayerCard { p: p }
          }
        }
      }
    }
  }

  // Today's times on a card, the current one tonal and the next with how long until it.
  component Today() {
    Column {
      gap: 12
      Row {
        align: center
        padding: [4, 8, 0, 0]
        Text { text: L.today; fontSize: 14; bold: true; color: accent; weight: 1; maxLines: 1 }
        Text { text: tzName != "Asia/Jakarta" && tzName != "UTC" && city != "auto" ? "${curTimeStr} · ${tzName}" : curTimeStr; fontSize: 14; color: muted; maxLines: 1 }
      }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        Box { padding: [20, 16, 20, 12]; Horizon { } }
        for row in screenPrayers key row.id {
          Spacer { height: 1; fill: width; background: border }
          Row {
            gap: 16
            align: center
            padding: [20, 12]
            background: row.isCurrent ? mix(surface, accent, 0.22) : surface
            Column {
              gap: 0
              weight: 1
              Text { text: row.name; fontSize: 16; bold: row.isCurrent || row.isNext; color: row.isNext ? (prayerSoon ? red : accent) : foreground; maxLines: 1 }
              Text { text: row.isNext ? "${row.ar} · ${L.left}" : row.ar; fontSize: 14; color: row.isNext && prayerSoon ? red : muted; maxLines: 1 }
            }
            Text { text: row.time ?? "—:—"; fontSize: 16; font: mono; bold: row.isCurrent || row.isNext; color: row.isNext ? (prayerSoon ? red : accent) : foreground; maxLines: 1 }
          }
        }
      }
    }
  }

  // The coming week, a row a day: the date and Hijri date, then the five prayers.
  component Week() {
    Column {
      gap: 12
      Text { text: L.week; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        Row {
          gap: 4
          padding: [16, 12, 16, 6]
          Text { text: L.day; style: label; color: muted; weight: 1; maxLines: 1 }
          for p in tilePrayers.filter(p => p.id != "sunrise") key p.id {
            Text { text: p.name; style: label; color: muted; width: 44; align: center; maxLines: 1 }
          }
        }
        for d, idx in weekDays key d.date.gregorian.date {
          Spacer { height: 1; fill: width; background: border }
          Row {
            gap: 4
            align: center
            padding: [16, 10]
            background: idx == 0 ? mix(surface, accent, 0.22) : surface
            Column {
              gap: 0
              weight: 1
              Text { text: d.date.gregorian.day + " " + (d.date.gregorian.month.en != null ? sub(d.date.gregorian.month.en, 0, 3) : ""); fontSize: 14; bold: idx == 0; maxLines: 1 }
              Text { text: d.date.hijri.day + " " + d.date.hijri.month.en; fontSize: 12; color: muted; maxLines: 1 }
            }
            for t in [d.timings.Fajr, d.timings.Dhuhr, d.timings.Asr, d.timings.Maghrib, d.timings.Isha] {
              Text { text: sub(t, 0, 5); fontSize: 13; font: mono; width: 44; align: center; maxLines: 1 }
            }
          }
        }
        if len(weekDays) == 0 { Text { text: lat == null ? "…" : "Loading…"; fontSize: 16; color: muted; padding: [20, 16] } }
      }
    }
  }

  // Where and how it works it out; each opens its choices in a sheet.
  component Settings() {
    Column {
      gap: 12
      Text { text: L.settings; fontSize: 14; bold: true; color: accent; padding: [4, 8, 0, 0] }
      Column {
        gap: 0
        background: surface
        radius: 28
        clip: true
        for r, i in settingRows key r.k {
          Spacer { height: 1; fill: width; background: border; visible: i > 0 }
          Row {
            gap: 16
            align: center
            padding: [20, 14]
            onTap: {
              if r.k == "city" { typedCity = city == "auto" ? "" : city }
              sheet = r.k
            }
            Column {
              gap: 0
              weight: 1
              Text { text: r.l; fontSize: 16; maxLines: 1 }
              Text { text: r.v; fontSize: 14; color: r.k == "city" && notFound ? red : muted; maxLines: 1 }
            }
            Text { text: "›"; fontSize: 18; color: muted }
          }
        }
      }
      Text { text: "${L.zone}: ${tzName} · ${methodName}"; fontSize: 14; color: muted; padding: [8, 0] }
      Text { text: L.refresh; fontSize: 16; bold: true; maxLines: 1; align: center; fill: width; background: mix(surface, accent, 0.22); radius: 24; padding: [24, 14]; onTap: refresh() }
    }
  }

  screen {
    title: L.title
    Column {
      scroll: true
      gap: 12
      padding: [0, 4, 0, 24]
      Column {
        gap: 0
        Text { text: nextTimeRaw ?? "—:—"; fontSize: 48; bold: true; maxLines: 1; color: prayerSoon ? red : foreground }
        Text { text: nextLine; fontSize: 16; color: prayerSoon ? red : accent; maxLines: 1 }
        Text { text: placeLine + " · " + gregDisplay + (hijriDisplay != "" ? " · " + hijriDisplay : ""); fontSize: 16; color: notFound ? red : muted; maxLines: 2 }
      }
      if (screenWidth ?? 0) > 600 {
        Row {
          gap: 24
          Today { weight: 1 }
          Column {
            gap: 12
            weight: 1
            Week { }
            Settings { }
          }
        }
      } else {
        Today { }
        Week { }
        Settings { }
      }
    }

    // The city: typed, or one of the usual ones.
    if sheet == "city" {
      Sheet {
        title: L.city
        onDismiss: sheet = ""
        Column {
          gap: 16
          padding: [0, 4, 0, 4]
          Input {
            text: typedCity
            placeholder: L.cityHint
            focus: sheet == "city"
            onChange: typedCity = value
            onSubmit: {
              city = len(value) > 0 ? value : city
              sheet = ""
              refresh()
            }
          }
          Flow {
            gap: 8
            for c in cityPicks key c.v {
              Text {
                text: c.l; fontSize: 15; maxLines: 1; radius: 20; padding: [16, 10]
                background: city == c.v ? accent : mix(surface, accent, 0.22)
                color: city == c.v ? background : foreground
                onTap: { city = c.v; sheet = ""; refresh() }
              }
            }
          }
          Row {
            gap: 8
            align: center
            Spacer { weight: 1 }
            Text { text: L.cancel; fontSize: 15; maxLines: 1; background: mix(surface, accent, 0.22); radius: 24; padding: [20, 12]; onTap: sheet = "" }
            Text {
              text: L.save; fontSize: 15; bold: true; maxLines: 1; background: accent; color: background; radius: 24; padding: [24, 12]
              onTap: { city = len(typedCity) > 0 ? typedCity : city; sheet = ""; refresh() }
            }
          }
        }
      }
    }

    // The other settings: one choice each, taken as it's tapped.
    if sheet != "" && sheet != "city" {
      Sheet {
        title: sheet == "method" ? L.method : sheet == "school" ? L.school : sheet == "tune" ? L.tune : L.language
        onDismiss: sheet = ""
        for o in options key o.v {
          Row {
            gap: 16
            align: center
            padding: [0, 12]
            onTap: {
              if sheet == "method" {
                method = o.v
              } else if sheet == "school" {
                school = o.v
              } else if sheet == "tune" {
                tuneMin = o.v
              } else {
                lang = o.v
              }
              sheet = ""
              refresh()
            }
            Box {
              size: 20; radius: 10; align: center; border: 2; borderColor: o.v == chosen ? accent : muted
              Spacer { size: 10; radius: 5; background: o.v == chosen ? accent : alpha(accent, 0) }
            }
            Text { text: o.l; fontSize: 16; weight: 1; maxLines: 1 }
          }
        }
      }
    }
  }
}
